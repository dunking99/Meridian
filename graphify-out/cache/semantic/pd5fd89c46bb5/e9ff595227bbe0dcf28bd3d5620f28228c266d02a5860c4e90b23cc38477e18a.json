{"nodes": [{"id": "readme", "label": "README.md (Meridian technical overview)", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_memory_layer", "label": "Memory layer (unusual-for-its-own-history)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Levels are free everywhere; the value is whether a move is unusual for that instrument by its own standard, which requires kept history."}, {"id": "readme_rebuild_pipeline", "label": "Rebuild pipeline (what portfolio should exist)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "rebalance and allocate take current holdings as given; rebuild can notice duplicate funds and propose new ones. Advisory only, no tax modelling, duplicates collapsed before optimising."}, {"id": "readme_portfolio_analysis", "label": "Portfolio Analysis (scorecard, attribution, correlation pairs)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Five scorecard axes reuse the rebuild pipeline's axes so numbers agree; attribution ranks by actual pull on weighted average; pulls sum to zero."}, {"id": "readme_performance_engine", "label": "Performance engine (XIRR vs TWR)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "IRR solved by bisection not Newton-Raphson because a wrong confident IRR is worse than a refused one; gap between money-weighted and time-weighted is the timing effect; no ledger means no MWR."}, {"id": "readme_alerts_signals", "label": "Alerts and cross-engine signals", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "signals.js kinds run on a 15-minute beat with remembered signal_state to avoid re-firing on unchanged findings; PORTFOLIO reserved symbol avoids table rebuild; delivery is in-app only."}, {"id": "readme_briefing", "label": "Briefing (materiality ranking)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "materiality = 100 x strength x stake x kind weight; reports change not state; read-only; verdict can conclude nothing happened."}, {"id": "readme_correlation_engine", "label": "Correlation engine (date-joined)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Joining on date not position: identical prices correlate 1.0 joined on date but -0.04 by position. Null never 0; average linkage avoids chaining."}, {"id": "readme_xray", "label": "Portfolio X-ray (look-through floors)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Yahoo publishes only top ten holdings, so weights are floors; scaling disclosed weights up to 100% would be fabrication."}, {"id": "readme_attribution", "label": "Attribution (Carino-linked, vs own average)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Brinson needs benchmark sector weights no free source provides, so decomposes against the portfolio itself; Carino linking makes parts sum to compounded return exactly."}, {"id": "readme_importer", "label": "Statement importer (preview then apply)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing writes on first call; ambiguous dates block import; pence suspicion raised against stored bars; unknown tickers flagged, never remapped."}, {"id": "readme_reports", "label": "Reports (period-ended, table-driven schedule)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reports cover completed periods and schedule is driven by the table so closed-app weeks still generate. Email transport deliberately not built because it cannot be verified in the sandbox."}, {"id": "readme_honest_principles", "label": "Deliberately honest principles", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Missing data never filled; null rather than guess; beta joined on dates and refuses under 120 bars; precedents are described samples not forecasts; no overall bull/bear verdict."}, {"id": "readme_auto_update", "label": "Auto-update (Windows) section", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "readme", "target": "readme_memory_layer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme", "target": "readme_rebuild_pipeline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme", "target": "readme_portfolio_analysis", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "sou