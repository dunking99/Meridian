    { id: "overview",  label: "Overview" },
    { id: "indices",   label: "Indices" },
    { id: "fx",        label: "FX" },
    { id: "commod",    label: "Commodities" },
    { id: "sectors",   label: "Sectors" },
    { id: "rates",     label: "Rates" },
    { id: "crypto",    label: "Crypto" },
    { id: "banks",     label: "Central Banks" },
