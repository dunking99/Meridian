<file path="overview/hooks/useCalendar.js">
// OV-03 hook: dated events for held and watched instruments with stake, a
// 7/30/60-day window, and category filters.
import { useState } from "react";
import { useSpec, primary } from "../../shared/layout.jsx";
import { EP } from "../../shared/endpoints.js";

export const calendarSpec = {
  endpoints: (props, page, days = 30) => ({ main: EP.calendar(days) }),
  deps: { main: ["calendar", "book", "watch"] },
  staleAfterMs: 2 * 86400_000,
  select: ({ main }, props, page, filter = "all") => {
    const d = main.data;
    const events = (d?.events ?? []).filter(e => filter === "all" || e.category === filter);
    const byDay = {};
    for (const e of events) (byDay[e.date] ??= []).push(e);
    const byWeek = {};
    for (const e of events) { const w = Math.floor(e.daysAway / 7); (byWeek[w] ??= []).push(e); }
    const direct = [...events].filter(e => e.stakePct != null).sort((a, b) => b.stakePct - a.stakePct).slice(0, 3);
    return {
      ...primary({ main }), data: d, events, byDay, byWeek, direct,
      textAlt: d ? `${events.length} dated events in the next ${d.days} days${filter !== "all" ? ` (${filter})` : ""}: ${events.slice(0, 5).map(e => `${e.title} on ${e.date}`).join("; ")}. ${d.noDate.length} symbols have no date published or not looked up. Macro releases are not covered.` : "",
    };
  },
};

export function useCalendarNext30(props, page) {
  const [days, setDays] = useState(props.days ?? 30);
  const [filter, setFilter] = useState("all");
  const spec = { ...calendarSpec, endpoints: (p, pg) => calendarSpec.endpoints(p, pg, days), select: (r, p, pg) => calendarSpec.select(r, p, pg, filter) };
  return { ...useSpec(spec, props, page), days, setDays, filter, setFilter };
}
</file>

<file path="overview/hooks/useComposition.js">
// OV-02 hook: the composition tree for a lens (lens and cash toggle are local
// view state the fetch depends on), targets for the target-tick forms, and the
// enriched rows for the listing-venue (domicile) split.
import { useState } from "react";
import { useSpec, primary } from "../../shared/layout.jsx";
import { EP } from "../../shared/endpoints.js";

export const compositionSpec = {
  names: ["main", "targets", "enriched"],
  endpoints: (props, page, lens = "class", includeCash = true) => ({ main: EP.composition(lens, includeCash), targets: EP.targets, enriched: EP.enriched }),
  deps: { main: ["prices", "book", "bars"], targets: ["prices", "book"], enriched: ["prices", "book"] },
  staleAfterMs: 10 * 60_000,
  select: ({ main, targets, enriched }) => {
    const d = main.data;
    // Domicile split: each class divided by where the holding itself is listed.
    const dom = {};
    for (const r of enriched.data?.rows ?? []) {
      if (!r.value) continue;
      const c = r.type ?? "Unclassified", v = r.region ?? "Listing unknown";
      (dom[c] ??= {})[v] = (dom[c][v] ?? 0) + r.value;
    }
    return {
      ...primary({ main }), data: d,
      targets: targets.status === "ready" ? targets.data : null,
      targetsReason: targets.status === "refused" ? targets.reason : null,
      domicile: dom,
      textAlt: d ? `${d.lensLabel}: ${d.groups.map(g => `${g.label} ${(g.weight * 100).toFixed(1)}%`).join(", ")}.` : "",
    };
  },
};

export function useComposition(props, page) {
  const [lens, setLens] = useState(props.lens ?? "class");
  const [includeCash, setIncludeCash] = useState(true);
  const spec = { ...compositionSpec, endpoints: (p, pg) => compositionSpec.endpoints(p, pg, lens, includeCash) };
  return { ...useSpec(spec, props, page), lens, setLens, includeCash, setIncludeCash };
}
</file>

<file path="overview/hooks/useDayContribution.js">
// OV-11 hook: today's pound change per holding (sums to the headline), plus
// linked stories from the returns read for the "movers with reasons" form.
import { useSpec, primary } from "../../shared/layout.jsx";
import { EP } from "../../shared/endpoints.js";
import { blockSpec } from "./common.js";

const base = blockSpec("day", { deps: ["prices", "book"], staleAfterMs: 10 * 60_000 });
export const daySpec = {
  ...base,
  names: ["main", "returns"],
  endpoints: (props, page) => ({ main: EP.ovBlock("day"), returns: EP.returns(page.benchmark) }),
  deps: { main: ["prices", "book"], returns: ["prices", "book", "bars", "news"] },
  select: ({ main, returns }) => {
    const d = main.data;
    const stories = Object.fromEntries((returns.data?.rows ?? []).filter(r => r.story).map(r => [r.symbol, r.story]));
    const z = Object.fromEntries((returns.data?.rows ?? []).filter(r => r.unusual?.z != null).map(r => [r.symbol, r.unusual.z]));
    const rows = (d?.rows ?? []).map(r => ({ ...r, story: stories[r.symbol] ?? null, z: z[r.symbol] ?? null }));
    const up = rows.filter(r => r.gbp > 0), down = rows.filter(r => r.gbp < 0), flat = rows.filter(r => r.gbp === 0);
    return {
      ...primary({ main }), data: d, rows, counts: { up: up.length, down: down.length, flat: flat.length },
      weights: { up: up.reduce((a, r) => a + r.weight, 0), down: down.reduce((a, r) => a + r.weight, 0), flat: flat.reduce((a, r) => a + r.weight, 0) },
      textAlt: d ? `Today's change ${d.net >= 0 ? "+" : ""}${d.net} pounds: ${rows.slice(0, 4).map(r => `${r.symbol} ${r.gbp >= 0 ? "+" : ""}${r.gbp}`).join(", ")}${rows.length > 4 ? " and others" : ""}.` : "",
    };
  },
};
export const useDayContribution = (props, page) => useSpec(daySpec, props, page);
</file>

