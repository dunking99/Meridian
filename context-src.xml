  useEffect(() => {
    let alive = true;
    fetch(`${API}/history/batch?symbols=${encodeURIComponent(ALL_MARKET_SYMBOLS.join(","))}&days=90`)
      .then(r => r.json())
      .then(d => { if (alive) { setHist(d.series ?? {}); setHistLoaded(true); } })
