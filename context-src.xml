              <span style={{ fontFamily: "monospace", color: t.warning, fontSize: 10, letterSpacing: 0.8 }}>
                {g.stage.toUpperCase()}
              </span>{" "}
              {g.issue}
            </div>
            {g.detail && (
              <div style={{ fontSize: 10.5, color: t.textFaint, marginTop: 3, fontFamily: "monospace" }}>
