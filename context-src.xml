                  {["NAME", "PRICE", "1D", "P/E", "FWD P/E", "MKT CAP", "52W POS", ""].map((h, i) => (
                    <th key={i} style={{ textAlign: i === 0 ? "left" : "right", padding: "6px 8px", fontWeight: 400, letterSpacing: 0.5 }}>{h}</th>
