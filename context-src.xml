// Component gallery (dev only, #/gallery).
//
// Each component is rendered alone in six states from RECORDED API responses
// (scripts/record-gallery-fixtures.mjs against the seeded populated / thin /
// empty worlds). The view receives exactly what its hook would hand it: the
// gallery runs the component's own pure `select` over the recorded responses,
// never a fetch — which is also the proof that views do not fetch.
import React, { useEffect, useMemo, useState } from "react";
import { TokenProvider, FONT } from "../shared/theme.jsx";
import { PageProvider, usePage } from "../shared/layout.jsx";
import { envelopeToState } from "../shared/useApi.js";
import { PanelBoundary, PanelCrash } from "../shared/ui.jsx";
import { PAGES } from "../registry-all.js";
import fixtures from "./fixtures.json";

const STATES = ["populated", "thin", "empty", "stale", "error", "refused"];
const EXTRAS = {
  lens: "class", setLens: () => {}, includeCash: true, setIncludeCash: () => {},
  prefs: { window: "1M", rank: "return", unit: "pct" }, setWindow: () => {}, setRank: () => {}, setUnit: () => {},
  days: 30, setDays: () => {}, filter: "all", setFilter: () => {},
  basisMode: "reconstructed", setBasisMode: () => {},
  rangeFor: { "1W": "1M", "1M": "1M", "3M": "3M", "6M": "6M", YTD: "YTD", "1Y": "1Y", "3Y": "3Y", "5Y": "5Y", ITD: "MAX", MAX: "MAX" },
  read: [], markRead: () => {}, snooze: () => {}, save: () => {}, saving: false, add: () => {}, alert: () => {}, msg: null,
  saveGoal: () => {}, clear: () => {}, errors: null,
  group: "position", setGroup: () => {}, mode: "today", setMode: () => {}, view: "map", setView: () => {}, unit: "pct", setUnit: () => {}, span: "30D", setSpan: () => {},
  extra: [], setExtra: () => {}, grouping: "sector", setGrouping: () => {}, lookback: 252, setLookback: () => {}, window: "1Y", setWindow: () => {},
  edit: () => {}, remove: () => {}, undo: () => {}, pending: null, setTarget: () => {}, saved: [], saveView: () => {}, dropView: () => {},
};
const REFUSAL_SWAP = { "/performance/series?range=1Y&benchmark=%5EFTSE&basis=reconstructed": "/performance/series?range=5Y&benchmark=%5EFTSE&basis=reconstructed" };

function resultsFor(def, world, page, { swapRefusal = false } = {}) {
  const props = def.gallery?.props ?? {};
  const paths = def.spec.endpoints(props, page);
  const names = def.spec.names ?? Object.keys(paths);
  const results = {};
  for (const n of names) {
    let path = paths[n];
    if (!path) { results[n] = { status: "loading", data: null, refetch: () => {} }; continue; }
    if (swapRefusal && n === "main" && REFUSAL_SWAP[path]) path = REFUSAL_SWAP[path];
    const body = fixtures.worlds[world]?.[path];
    if (body === undefined) { results[n] = { status: "error", reason: `No recorded fixture for ${path}.`, data: null, refetch: () => {} }; continue; }
    const adapt = def.spec.adapt?.[n];
    results[n] = { ...envelopeToState(adapt ? adapt(body) : body), stale: false, refetch: () => {} };
  }
  return { results, props };
}

function stateProps(def, state, page) {
  if (state === "error") {
    const { props } = resultsFor(def, "populated", page);
    const names = def.spec.names ?? Object.keys(def.spec.endpoints(props, page));
    const results = Object.fromEntries(names.map(n => [n, { status: "error", reason: "Could not reach the Meridian API.", data: null, refetch: () => {} }]));
    return { out: def.spec.select(results, props, page), props };
  }
  if (state === "refused") {
    for (const w of ["empty", "thin", "populated"]) {
      const { results, props } = resultsFor(def, w, page);
      if (results.main?.status === "refused") return { out: def.spec.select(results, props, page), props, from: w };
    }
    const { results, props } = resultsFor(def, "populated", page, { swapRefusal: true });
    if (results.main?.status === "refused") return { out: def.spec.select(results, props, page), props, from: "populated (5Y range)" };
    return { none: true };
  }
  const world = state === "stale" ? "populated" : state;
  const { results, props } = resultsFor(def, world, page);
  let out = def.spec.select(results, props, page);
  if (state === "stale") out = { ...out, stale: true, asOf: Date.now() - 3 * 86400_000 };
  return { out, props, from: world };
}

function Cell({ def, state, size }) {
  const page = usePage();
  const r = useMemo(() => stateProps(def, state, page), [def, state, page]);
  const View = def.View;
  if (r.none) return <div style={{ fontSize: 11, opacity: 0.7, padding: 12 }}>No refusal can be produced for this component from recorded data — its engine always answers (for example the calendar always has the ISA date).</div>;
  return (
    <PanelBoundary name={def.title} Fallback={PanelCrash}>
      <View {...EXTRAS} {...r.out} size={size} props={r.props} page={page} />
    </PanelBoundary>
  );
}

export default function Gallery({ themes, theme }) {
  const [themeName, setThemeName] = useState(theme?.name ?? "dark");
  const [size, setSize] = useState("m");
  const all = Object.entries(PAGES).flatMap(([pg, reg]) => Object.entries(reg).filter(([, def]) => !def.galleryHidden).map(([id, def]) => ({ pg, id, def })));
  const initial = (() => { try { return new URLSearchParams(window.location.hash.split("?")[1] ?? "").get("c"); } catch { return null; } })();
  const [sel, setSel] = useState(initial && all.some(a => a.id === initial) ? initial : all[0]?.id);
  useEffect(() => { try { window.history.replaceState(null, "", `#/gallery?c=${sel}`); } catch { /* ignore */ } }, [sel]);
  const t = themes[themeName];
  const cur = all.find(a => a.id === sel);
  const btn = on => ({ background: on ? t.text : "transparent", color: on ? t.surface : t.textSecondary, border: `1px solid ${t.border}`, borderRadius: 3, padding: "3px 9px", fontSize: 11, cursor: "pointer", fontFamily: FONT.mono });
  return (
    <TokenProvider tokens={t}>
      <PageProvider onOpenHolding={() => {}} onNavigate={() => {}}>
        <div style={{ display: "flex", minHeight: "100vh", background: t.appBg, color: t.textSecondary, fontFamily: FONT.sans }}>
          <nav aria-label="Components" style={{ width: 230, borderRight: `1px solid ${t.border}`, padding: 12, background: t.chromeBg, flexShrink: 0 }}>
            <div style={{ fontFamily: FONT.mono, fontSize: 12, color: t.text, marginBottom: 4 }}>COMPONENT GALLERY</div>
            <div style={{ fontSize: 10, color: t.textFaint, marginBottom: 10 }}>Recorded {new Date(fixtures.recordedAt).toLocaleString("en-GB")} from seeded test worlds. <a href="#/portfolio/overview" style={{ color: t.info }}>Back to app</a></div>
            {Object.keys(PAGES).map(pg => (
              <div key={pg}>
                <div style={{ fontFamily: FONT.mono, fontSize: 9.5, letterSpacing: 1.2, color: t.textMuted, margin: "8px 0 3px" }}>{pg.toUpperCase()}</div>
                {all.filter(a => a.pg === pg).map(a => (
                  <button key={a.id} onClick={() => setSel(a.id)} aria-current={a.id === sel ? "true" : undefined}
                    style={{ display: "block", width: "100%", textAlign: "left", background: a.id === sel ? t.surfaceInset : "transparent", border: "none", color: a.id === sel ? t.text : t.textSecondary, padding: "3px 6px", fontSize: 11.5, cursor: "pointer", borderRadius: 3 }}>
                    <span style={{ fontFamily: FONT.mono, fontSize: 9.5, color: t.textFaint, marginRight: 6 }}>{a.def.checklist}</span>{a.def.title}
                  </button>
                ))}
              </div>
            ))}
          </nav>
          <main style={{ flex: 1, padding: 16, minWidth: 0 }}>
            <div style={{ display: "flex", gap: 8, alignItems: "center", marginBottom: 12, flexWrap: "wrap" }}>
              <h1 style={{ margin: 0, fontFamily: FONT.serif, fontSize: 22, color: t.text }}>{cur?.def.title} <span style={{ fontFamily: FONT.mono, fontSize: 12, color: t.textFaint }}>{cur?.def.checklist}</span></h1>
              <span style={{ flex: 1 }} />
              {Object.keys(themes).map(n => <button key={n} onClick={() => setThemeName(n)} style={btn(themeName === n)}>{n}</button>)}
              {["s", "m", "l"].map(z => <button key={z} onClick={() => setSize(z)} style={btn(size === z)}>size {z}</button>)}
            </div>
            {cur && (
              <div style={{ display: "grid", gridTemplateColumns: size === "l" ? "1fr" : "repeat(2, minmax(0, 1fr))", gap: 14 }}>
                {STATES.map(s => (
                  <div key={s} data-state={s} style={{ minWidth: 0, maxWidth: size === "s" ? 420 : undefined }}>
                    <div style={{ fontFamily: FONT.mono, fontSize: 10, letterSpacing: 1.3, color: t.textMuted, marginBottom: 4 }}>{s.toUpperCase()}</div>
                    <Cell def={cur.def} state={s} size={size} />
                  </div>
                ))}
              </div>
            )}
          </main>
        </div>
      </PageProvider>
    </TokenProvider>
  );
}
</file>

<file path="holdings/hooks/useHoldings.js">
// Holdings-page hooks. Most panels read the one enriched-holdings call
// (B-20); the page filters (HD-05, in the URL) are applied here in `select`
// so every panel shows the same subset. Writes go through the existing
// holdings routes and bump the data version, so every panel refreshes.
import { useCallback, useEffect, useRef, useState } from "react";
import { useSpec, primary, applyFilters } from "../../shared/layout.jsx";
import { useLocalPref } from "../../shared/ui.jsx";
import { EP } from "../../shared/endpoints.js";
import { send } from "../../shared/api.js";
import { refreshVersions } from "../../shared/dataVersion.js";

const ENR_DEPS = ["prices", "book", "bars", "news"];
const rowsOf = r => r.data?.rows ?? [];

/** Spec factory: enriched rows (filtered) plus optional extra endpoints. */
function enrichedSpec({ extra = {}, extraDeps = {}, select, filtered = true } = {}) {
  return {
    names: ["main", ...Object.keys(extra)],
    endpoints: (props, page) => ({ main: EP.enriched, ...Object.fromEntries(Object.entries(extra).map(([k, f]) => [k, typeof f === "function" ? f(props, page) : f])) }),
    deps: { main: ENR_DEPS, ...extraDeps },
    staleAfterMs: 10 * 60_000,
    select: (results, props, page) => {
      const all = rowsOf(results.main);
      const rows = filtered ? applyFilters(all, page.filters) : all;
      return { ...primary(results), data: results.main.data, all, rows, filtered: rows.length !== all.length, ...(select ? select(results, rows, props, page, all) : {}) };
    },
  };
}

// ─── HD-04 key info strip ─────────────────────────────────────
export const keyInfoSpec = enrichedSpec({
  filtered: false,
  select: (r, rows) => {
    const priced = rows.filter(x => x.pnlPct != null);
    const byPct = [...priced].sort((a, b) => b.pnlPct - a.pnlPct);
    const byDay = rows.filter(x => x.dayPct != null).sort((a, b) => b.dayPct - a.dayPct);
    return { best: byPct[0] ?? null, worst: byPct[byPct.length - 1] ?? null, bestDay: byDay[0] ?? null, worstDay: byDay[byDay.length - 1] ?? null };
  },
});
export const useKeyInfo = (props, page) => useSpec(keyInfoSpec, props, page);

// ─── HD-09 weight ribbon ──────────────────────────────────────
export const ribbonSpec = enrichedSpec({
  select: (r, rows, props, page, all, group = "position") => {
    const total = all.reduce((a, x) => a + (x.value ?? 0), 0) + (r.main.data?.totals?.cash ?? 0);
    const keyOf = x => group === "position" ? x.symbol : group === "class" ? x.type : group === "sector" ? (x.sector ?? "Unclassified") : group === "currency" ? (x.currency ?? "Unknown") : "Other";
    const g = {};
    for (const x of rows) {
      const k = keyOf(x);
      const e = g[k] ?? { key: k, label: k, value: 0, target: 0, hasTarget: false, untargeted: [], members: [] };
      e.value += x.value ?? 0; e.members.push(x.symbol);
      if (x.targetPct != null) { e.target += x.targetPct; e.hasTarget = true; } else e.untargeted.push(x.symbol);
      g[k] = e;
    }
    const segs = Object.values(g).sort((a, b) => b.value - a.value).map(e => ({ ...e, share: total ? e.value / total : 0, targetShare: e.hasTarget ? e.target / 100 : null, driftPp: e.hasTarget && e.untargeted.length === 0 ? (e.value / total * 100 - e.target) : null }));
    return { segs, total, cashShare: total ? (r.main.data?.totals?.cash ?? 0) / total : 0 };
  },
});
export function useRibbon(props, page) {
  const [group, setGroup] = useLocalPref("ribbon_group", "position");
  const spec = { ...ribbonSpec, select: (res, p, pg) => ribbonSpec.select(res, p, pg) };
  const base = useSpec(spec, props, page);
  // Re-run the grouping locally (no refetch) when the group changes.
  const regrouped = base.status === "ready" ? ribbonGroup(base, group) : base;
  return { ...regrouped, group, setGroup };
}
function ribbonGroup(base, group) {
  const total = base.all.reduce((a, x) => a + (x.value ?? 0), 0) + (base.data?.totals?.cash ?? 0);
  const keyOf = x => group === "position" ? x.symbol : group === "class" ? x.type : group === "sector" ? (x.sector ?? "Unclassified") : group === "currency" ? (x.currency ?? "Unknown") : "Other";
  const g = {};
  for (const x of base.rows) {
    const k = keyOf(x);
    const e = g[k] ?? { key: k, label: k, value: 0, target: 0, hasTarget: false, untargeted: [], members: [] };
    e.value += x.value ?? 0; e.members.push(x.symbol);
    if (x.targetPct != null) { e.target += x.targetPct; e.hasTarget = true; } else e.untargeted.push(x.symbol);
    g[k] = e;
  }
  const segs = Object.values(g).sort((a, b) => b.value - a.value).map(e => ({ ...e, share: total ? e.value / total : 0, targetShare: e.hasTarget ? e.target / 100 : null, driftPp: e.hasTarget && !e.untargeted.length ? e.value / total * 100 - e.target : null }));
  return { ...base, segs, total, cashShare: total ? (base.data?.totals?.cash ?? 0) / total : 0 };
}

// ─── HD-06 treemap ────────────────────────────────────────────
export const treemapSpec = enrichedSpec({
  extra: { returns: (p, page) => EP.returns(page.benchmark) },
  extraDeps: { returns: ["prices", "book", "bars"] },
  select: (r) => ({ returns: r.returns?.data?.rows ?? [], returnsReason: r.returns?.status === "refused" ? r.returns.reason : null }),
});
export function useTreemap(props, page) {
  const [mode, setMode] = useLocalPref("treemap_mode", "today");
  const [group, setGroup] = useLocalPref("treemap_group", "class");
  return { ...useSpec(treemapSpec, props, page), mode, setMode, group, setGroup };
}

// ─── HD-07 geography ──────────────────────────────────────────
export const geoSpec = enrichedSpec({
  filtered: false,
  extra: { region: EP.composition("region", false), country: EP.composition("country", false), listed: EP.composition("listed", false) },
  extraDeps: { region: ["prices", "book", "bars"], country: ["prices", "book", "bars"], listed: ["prices", "book", "bars"] },
  select: (r, rows) => {
    const reg = r.region?.data;
    const shares = {};
    let unseen = 0;
    for (const g of reg?.groups ?? []) { if (g.label === "Not disclosed") unseen += g.weight; else shares[g.label] = g.weight; }
    const invested = rows.reduce((a, x) => a + (x.value ?? 0), 0);
    const listingUK = invested ? rows.filter(x => x.region === "UK").reduce((a, x) => a + x.value, 0) / invested : null;
    const listingUnknown = invested ? rows.filter(x => !x.region).reduce((a, x) => a + x.value, 0) / invested : null;
    // Country shares, and the holdings behind each, from the same look-through lens.
    const shape = res => {
      const cty = res?.data;
      const countries = (cty?.groups ?? []).filter(g => g.label !== "Not disclosed").map(g => ({ label: g.label, weight: g.weight }));
      const unseenC = (cty?.groups ?? []).filter(g => g.label === "Not disclosed").reduce((a, g) => a + g.weight, 0);
      const held = {};
      const walk = n => { for (const k of n.children ?? []) { if (k.leaf && k.symbol) (held[n.label] ??= new Set()).add(k.symbol); else walk(k); } };
      for (const root of cty?.tree ?? []) for (const g of root.children ?? []) walk(g);
      return { countries, unseen: unseenC, countryHoldings: Object.fromEntries(Object.entries(held).map(([k, v]) => [k, [...v]])), countryState: res ? primary({ main: res }) : null };
    };
    return { region: reg, regionState: primary({ main: r.region ?? r.main }), origin: shape(r.country), listedBasis: shape(r.listed), shares, unseen, listingUK, listingUnknown, lookUK: shares.UK ?? 0 };
  },
});
export function useGeography(props, page) {
  const [view, setView] = useLocalPref("geo_view", "globe");
  const [geoBasis, setGeoBasis] = useLocalPref("geo_basis", "origin");
  const out = useSpec(geoSpec, props, page);
  const pick = (geoBasis === "listed" ? out.listedBasis : out.origin) ?? {};
  return { ...out, ...pick, unseen: pick.unseen ?? out.unseen, view, setView, geoBasis, setGeoBasis };
}

// ─── HD-01 table (+ edits, deferred delete with undo) ─────────
export const tableSpec = enrichedSpec({});
export function useHoldingsTable(props, page) {
  const out = useSpec(tableSpec, props, page);
  const [pending, setPending] = useState(null);     // { row, timer }
  const [msg, setMsg] = useState(null);
  const timer = useRef(null);
  const edit = useCallback(async (id, patch) => {
    try { await send("PUT", "/holdings", { id, ...patch }); setMsg("Saved."); await refreshVersions(); }
    catch (e) { setMsg(`Could not save: ${e.message}`); }
  }, []);
  // Deletion waits for the undo window to pass before anything is sent, so
  // "undo" never has to re-create a row.
  const remove = useCallback(row => {
    clearTimeout(timer.current);
    setPending({ row });
    timer.current = setTimeout(async () => {
      try { await send("DELETE", `/holdings?id=${row.id}`); setMsg(`${row.symbol} deleted.`); await refreshVersions(); }
      catch (e) { setMsg(`Could not delete: ${e.message}`); }
      setPending(null);
    }, 8000);
  }, []);
  const undo = useCallback(() => { clearTimeout(timer.current); setPending(null); setMsg("Deletion cancelled."); }, []);
  const add = useCallback(async p => {
    try { await send("POST", "/holdings", p); setMsg(`${p.symbol} added.`); await refreshVersions(); return true; }
    catch (e) { setMsg(`Could not add: ${e.message}`); return false; }
  }, []);
  useEffect(() => () => clearTimeout(timer.current), []);
  const rows = pending ? out.rows.filter(r => r.id !== pending.row.id) : out.rows;
  return { ...out, rows, edit, remove, undo, add, pending, msg };
}

// ─── HD-05 filters ────────────────────────────────────────────
export const filtersSpec = enrichedSpec({
  filtered: false,
  select: (r, rows) => {
    const opts = k => {
      const m = {};
      for (const x of rows) { const v = k === "type" ? x.type : k === "region" ? (x.region ?? "Listing unknown") : (x[k] ?? "Unclassified"); m[v] = (m[v] ?? 0) + 1; }
      return Object.entries(m).sort((a, b) => b[1] - a[1]);
    };
    return { options: Object.fromEntries(["type", "sector", "region", "wrapper", "account", "currency"].map(k => [k, opts(k)])), hasTransactions: rows.some(x => x.transactions?.length) };
  },
});
export function useFilters(props, page) {
  const [saved, setSaved] = useLocalPref("holdings_saved_views", []);
  const out = useSpec(filtersSpec, props, page);
  return { ...out, saved, saveView: name => setSaved(v => [...v.filter(x => x.name !== name), { name, filters: page.filters }].slice(-8)), dropView: name => setSaved(v => v.filter(x => x.name !== name)) };
}

// ─── HD-10 winners / losers ───────────────────────────────────
export const winnersSpec = enrichedSpec({});
export function useWinnersLosers(props, page) {
  const [unit, setUnit] = useLocalPref("winners_unit", "pct");
  return { ...useSpec(winnersSpec, props, page), unit, setUnit };
}

// ─── HD-11 52-week range, HD-15 trend, HD-22 up/down ─────────
export const rangeSpec = enrichedSpec({});
export const useRange52 = (props, page) => useSpec(rangeSpec, props, page);
export const trendSpec = enrichedSpec({});
export function useTrend(props, page) {
  const [span, setSpan] = useLocalPref("trend_span", "30D");
  return { ...useSpec(trendSpec, props, page), span, setSpan };
}
export const upDownSpec = enrichedSpec({ filtered: false });
export const useUpDown = (props, page) => useSpec(upDownSpec, props, page);

// ─── HD-12 allocation against target ─────────────────────────
export const targetsSpec = {
  names: ["main", "enriched"],
  endpoints: () => ({ main: EP.targets, enriched: EP.enriched }),
  deps: { main: ["prices", "book"], enriched: ENR_DEPS },
  staleAfterMs: 10 * 60_000,
  select: ({ main, enriched }) => ({ ...primary({ main }), data: main.data, rows: main.data?.rows ?? [], enriched: rowsOf(enriched) }),
};
export function useTargets(props, page) {
  const out = useSpec(targetsSpec, props, page);
  const [msg, setMsg] = useState(null);
  const setTarget = useCallback(async (id, targetPct) => {
    const v = targetPct === "" || targetPct == null ? null : Number(targetPct);
    if (v != null && !(v >= 0 && v <= 100)) { setMsg("A target is a percentage between 0 and 100."); return; }
    try { await send("PUT", "/holdings", { id, targetPct: v }); setMsg("Target saved."); await refreshVersions(); }
    catch (e) { setMsg(`Could not save: ${e.message}`); }
  }, []);
  return { ...out, setTarget, msg };
}

// ─── HD-20 position inspector ─────────────────────────────────
export const inspectorSpec = {
  names: ["main", "history", "enriched", "risk"],
  endpoints: (props, page) => {
    const sym = props.symbol ?? (page.selected && !String(page.selected).includes(":") ? page.selected : null);
    return {
      main: sym ? `/portfolio/holding?symbol=${encodeURIComponent(sym)}` : null,
      history: sym ? `/history?symbol=${encodeURIComponent(sym)}` : null,
      enriched: EP.enriched,
      risk: EP.riskProfile,
    };
  },
  deps: { main: ["prices", "book", "bars", "news"], history: ["bars"], enriched: ENR_DEPS, risk: ["book", "bars"] },
  adapt: {
    main: body => body?.error ? { available: false, reason: body.error } : { available: true, asOf: Date.now(), source: "/portfolio/holding (one read for the panel)", data: body },
    history: body => ({ available: (body?.data?.length ?? 0) > 1, reason: "No stored price history for this holding.", source: "Stored daily bars", data: { bars: body?.data ?? [] } }),
  },
  select: ({ main, history, enriched, risk }, props, page) => {
    const sym = main.data?.symbol ?? null;
    const row = rowsOf(enriched).find(x => x.symbol === sym) ?? null;
    const rs = risk.data?.riskContributions?.find(x => x.symbol === sym) ?? null;
    return {
      ...primary({ main }), status: main.status === "loading" && !sym ? "idle" : main.status,
      data: main.data, row, bars: history.data?.bars ?? [], historyState: history.status,
      riskShare: rs?.pctOfRisk ?? null, riskReason: risk.status === "refused" ? risk.reason : null,
      symbol: sym,
    };
  },
};
export const useInspector = (props, page) => useSpec(inspectorSpec, props, page);

// ─── Movers (winners and losers over a chosen period) ─────────
// Same data as the treemap: enriched rows (today, total) plus the per-window
// returns (1W, 1M, YTD) and their 22-close sparkline.
export const moversSpec = treemapSpec;
export function useMovers(props, page) {
  const [period, setPeriod] = useLocalPref("movers_period", "today");
  return { ...useSpec(moversSpec, props, page), period, setPeriod };
}

// ─── Ledger: the full-width table, with the inspector opening beside it ──
export function useLedger(props, page) {
  return { table: useHoldingsTable(props, page), inspector: useInspector(props, page) };
}

export function useMoversPanel(props, page) {
  return { upDown: useUpDown(props, page), movers: useMovers(props, page) };
}
</file>

