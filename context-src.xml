}

// ─── AN-13 Monte Carlo ────────────────────────────────────────
export function MonteCarloView({ status, data: d, reason, asOf, source, basis, coverage, stale, goal, goalReason, years, setYears, monthly, setMonthly, size = "m", page, refetch }) {
