<file path="shared/format.js">
// Number and date formatting for the Portfolio pages: GBP, pence, signs,
// compact amounts, percentages and percentage points, en-GB dates. Every
// formatter returns an em dash pair for null rather than a zero, so a missing
// figure never reads as a real one.

export const MISSING = "——";
const isNum = v => typeof v === "number" && Number.isFinite(v);

export function gbp(v, { dp = 0, sign = false } = {}) {
  if (!isNum(v)) return MISSING;
  const s = Math.abs(v).toLocaleString("en-GB", { minimumFractionDigits: dp, maximumFractionDigits: dp });
  const pre = v < 0 ? "−" : sign && v > 0 ? "+" : "";
  return `${pre}£${s}`;
}

export function gbpCompact(v, { sign = false } = {}) {
  if (!isNum(v)) return MISSING;
  const a = Math.abs(v);
  const body = a >= 1e6 ? `${(a / 1e6).toFixed(2)}m` : a >= 1e4 ? `${(a / 1e3).toFixed(1)}k` : a >= 1e3 ? `${(a / 1e3).toFixed(2)}k` : a.toFixed(0);
  const pre = v < 0 ? "−" : sign && v > 0 ? "+" : "";
  return `${pre}£${body}`;
}

/** Price in its own currency; pence-quoted lines are already pounds at source. */
export function price(v, ccy = "GBP") {
  if (!isNum(v)) return MISSING;
  const sym = ccy === "GBP" ? "£" : ccy === "USD" ? "$" : ccy === "EUR" ? "€" : "";
  const dp = Math.abs(v) < 10 ? 3 : 2;
  return `${sym}${v.toLocaleString("en-GB", { minimumFractionDigits: dp, maximumFractionDigits: dp })}${sym ? "" : ` ${ccy}`}`;
}

export function pct(v, { dp = 2, sign = true } = {}) {
  if (!isNum(v)) return MISSING;
  const pre = v < 0 ? "−" : sign && v > 0 ? "+" : "";
  return `${pre}${Math.abs(v).toFixed(dp)}%`;
}

export function pp(v, { dp = 1 } = {}) {
  if (!isNum(v)) return MISSING;
  return `${v < 0 ? "−" : v > 0 ? "+" : ""}${Math.abs(v).toFixed(dp)} pp`;
}

export function num(v, { dp = 2, sign = false } = {}) {
  if (!isNum(v)) return MISSING;
  const pre = v < 0 ? "−" : sign && v > 0 ? "+" : "";
  return `${pre}${Math.abs(v).toLocaleString("en-GB", { minimumFractionDigits: dp, maximumFractionDigits: dp })}`;
}

export function date(d, { withYear = true, weekday = false } = {}) {
  if (!d) return MISSING;
  const t = typeof d === "number" ? new Date(d) : new Date(`${String(d).slice(0, 10)}T12:00:00Z`);
  if (Number.isNaN(t.getTime())) return MISSING;
  return t.toLocaleDateString("en-GB", { day: "numeric", month: "short", ...(withYear ? { year: "numeric" } : {}), ...(weekday ? { weekday: "short" } : {}) });
}

export function dateTime(ms) {
  if (!isNum(ms)) return MISSING;
  return new Date(ms).toLocaleString("en-GB", { day: "numeric", month: "short", hour: "2-digit", minute: "2-digit" });
}

export function age(ms, now = Date.now()) {
  if (!isNum(ms)) return "never";
  const s = Math.max(0, Math.round((now - ms) / 1000));
  if (s < 60) return `${s}s ago`;
  if (s < 3600) return `${Math.round(s / 60)}m ago`;
  if (s < 86400) return `${Math.round(s / 3600)}h ago`;
  return `${Math.round(s / 86400)}d ago`;
}

export const arrow = v => (!isNum(v) || v === 0 ? "▪" : v > 0 ? "▲" : "▼");
</file>

<file path="shared/layout.jsx">
// Layout as data, the page context, and the component contract.
//
// A layout file is plain data: rows of { component, span, size?, props? }.
// The renderer looks each name up in a registry; a name with no
// implementation renders an explained placeholder, never an error and never
// sample data. Swapping one layout for another changes only the data file.
//
// A component is a spec (which endpoints, which data-version parts, and a pure
// `select` that turns responses into the view's props) plus a view. The hook
// that runs the spec lives beside the spec and knows nothing about the view;
// the view only draws what it is handed. The gallery calls the same `select`
// on recorded responses, which is the proof that views do not fetch.

import React, { createContext, useContext, useEffect, useMemo, useState } from "react";
import { useT, FONT } from "./theme.jsx";
import { useApi } from "./useApi.js";
import { Placeholder, PanelBoundary, PanelCrash } from "./ui.jsx";

// ─── Page context: selection, period, benchmark, navigation ──

const PageCtx = createContext(null);

/** Filters live in the hash query (#/portfolio/holdings?account=ISA&q=gold) so a view is linkable. */
function readHashFilters() {
  try {
    const q = new URLSearchParams(window.location.hash.split("?")[1] ?? "");
    return Object.fromEntries([...q.entries()].filter(([k]) => FILTER_KEYS.includes(k)));
  } catch { return {}; }
}
// No width cap: the page fills the window at any zoom, so nothing is centred away from the title.
export const PAGE_MAX_WIDTH = "none";
export const FILTER_KEYS = ["type", "sector", "region", "wrapper", "account", "currency", "move", "q"];

/** Apply page filters to enriched-holdings rows. Every filter combines (AND). */
export function applyFilters(rows, filters = {}) {
  return rows.filter(r => FILTER_KEYS.every(k => {
    const v = filters[k];
    if (v == null || v === "") return true;
    if (k === "q") { const s = v.toLowerCase(); return r.symbol.toLowerCase().includes(s) || String(r.name ?? "").toLowerCase().includes(s); }
    if (k === "move") return v === "up" ? (r.dayPct ?? 0) > 0 : v === "down" ? (r.dayPct ?? 0) < 0 : r.dayPct === 0;
    const field = k === "type" ? r.type : k === "region" ? (r.region ?? "Listing unknown") : r[k];
    return String(field ?? "Unclassified") === v;
  }));
}

export function PageProvider({ children, onOpenHolding, onNavigate, initial = {} }) {
  const [selected, setSelected] = useState(null);
  const [filters, setFiltersState] = useState(readHashFilters);
  const setFilters = f => setFiltersState(prev => {
    const next = typeof f === "function" ? f(prev) : f;
    const clean = Object.fromEntries(Object.entries(next).filter(([, v]) => v != null && v !== ""));
    try {
      const base = window.location.hash.split("?")[0];
      const qs = new URLSearchParams(clean).toString();
      window.history.replaceState(null, "", qs ? `${base}?${qs}` : base);
    } catch { /* ignore */ }
    return clean;
  });
  const [period, setPeriod] = useState(initial.period ?? "1Y");
  const [benchmark, setBenchmark] = useState(initial.benchmark ?? "^FTSE");
  useEffect(() => {
    const onKey = e => { if (e.key === "Escape") setSelected(null); };
    window.addEventListener("keydown", onKey);
    return () => window.removeEventListener("keydown", onKey);
  }, []);
  const value = useMemo(() => ({ selected, setSelected, period, setPeriod, benchmark, setBenchmark, filters, setFilters, onOpenHolding: onOpenHolding ?? (() => {}), onNavigate: onNavigate ?? (() => {}) }),
    [selected, period, benchmark, filters, onOpenHolding, onNavigate]);  // eslint-disable-line react-hooks/exhaustive-deps
  return <PageCtx.Provider value={value}>{children}</PageCtx.Provider>;
}

const NULL_CTX = { selected: null, setSelected: () => {}, period: "1Y", setPeriod: () => {}, benchmark: "^FTSE", setBenchmark: () => {}, filters: {}, setFilters: () => {}, onOpenHolding: () => {}, onNavigate: () => {} };
export const usePage = () => useContext(PageCtx) ?? NULL_CTX;

// ─── Component contract ───────────────────────────────────────

/**
 * Run a spec: one useApi per named endpoint (a fixed set per spec, so the
 * rules of hooks hold), then the spec's pure select.
 * spec = { endpoints: (props, page) => ({ main: path, ... }), deps: { main: [...] }, staleAfterMs, select(results, props, page) }
 */
export function useSpec(spec, props = {}, page = NULL_CTX) {
  const paths = spec.endpoints(props, page);
  const names = spec.names ?? Object.keys(paths);
  const results = {};
  for (const n of names) {
    // eslint-disable-next-line react-hooks/rules-of-hooks
    results[n] = useApi(paths[n], { deps: spec.deps?.[n] ?? spec.deps?.main ?? ["prices", "book"], staleAfterMs: spec.staleAfterMs ?? null, enabled: !!paths[n], adapt: spec.adapt?.[n] ?? null });
  }
  return spec.select(results, props, page);
}

/** Merge the non-ready states of several results into the contract shape. */
export function primary(results, key = "main") {
  const r = results[key];
  return { status: r.status, reason: r.reason, asOf: r.asOf, source: r.source, basis: r.basis, coverage: r.coverage, note: r.note, stale: r.stale, refetch: r.refetch };
}

export const sizeFromSpan = span => (span <= 4 ? "s" : span <= 7 ? "m" : "l");

// ─── Renderer ─────────────────────────────────────────────────

function Bound({ def, item, page }) {
  const data = def.useData(item.props ?? {}, page);
  const View = def.View;
  return <View {...data} size={item.size ?? sizeFromSpan(item.span ?? 12)} props={item.props ?? {}} page={page} />;
}

function Slot({ item, reg, page }) {
  const def = reg[item.component];
  if (!def) return <Placeholder title={item.component} reason={item.placeholder ?? `${item.component} is named in the layout but has no implementation yet.`} unblocks={item.unblocks} />;
  if (def.placeholder) return <Placeholder title={def.title} reason={def.placeholder.reason} unblocks={def.placeholder.unblocks} />;
  return (
    <PanelBoundary name={def.title ?? item.component} Fallback={PanelCrash}>
      <Bound def={def} item={item} page={page} />
    </PanelBoundary>
  );
}

export function LayoutPage({ layout, registry, extra = {} }) {
  const t = useT();
  const page = usePage();
  const reg = { ...registry, ...extra };
  return (
    <div style={{ maxWidth: PAGE_MAX_WIDTH, margin: 0, display: "flex", flexDirection: "column", gap: 14, fontFamily: FONT.sans }} data-layout={layout.name}>
      <style>{`.mlayout-row{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:14px;align-items:start}
        @media (max-width: 1100px){.mlayout-row > *{grid-column: span 12 !important}}
        .mlayout-row.stretch{align-items:stretch}
        .mlayout-row.stretch > div{display:flex;flex-direction:column}
        .mlayout-row.stretch > div > section{flex:1}
        .mlayout-stack{display:flex;flex-direction:column;gap:14px;flex:1;min-height:0}
        .mlayout-stack > *:last-child{flex:1;display:flex;flex-direction:column}
        .mlayout-stack > *:last-child > section{flex:1}`}</style>
      {layout.rows.map(row => (
        <div key={row.id} className={row.stretch ? "mlayout-row stretch" : "mlayout-row"} data-row={row.id}>
          {row.items.map((item, k) => (
            <div key={k} style={{ gridColumn: `span ${item.span ?? 12}`, minWidth: 0 }} data-slot={item.stack ? "stack" : item.component}>
              {item.stack ? (
                <div className="mlayout-stack">{item.stack.map((sub, j) => <Slot key={j} item={sub} reg={reg} page={page} />)}</div>
              ) : <Slot item={item} reg={reg} page={page} />}
            </div>
          ))}
        </div>
      ))}
      {layout.note && <div style={{ fontSize: 10, color: t.textFaint, fontFamily: FONT.mono }}>Layout: {layout.name} — {layout.note}</div>}
    </div>
  );
}
</file>

<file path="shared/SubPage.jsx">
// A Portfolio sub-page: tokens + page context + one layout file. App.jsx
// renders this with its current theme; nothing here reads App.jsx.
import React from "react";
import { TokenProvider, FONT } from "./theme.jsx";
import { PageProvider, LayoutPage, PAGE_MAX_WIDTH } from "./layout.jsx";
import { useLocalPref } from "./ui.jsx";

export function SubPage({ theme, layouts, registry, onOpenHolding, onNavigate, extra, devSwitch = true, heading }) {
  const names = Object.keys(layouts);
  const [name, setName] = useLocalPref(`layout_${layouts[names[0]].page}`, names[0]);
  const layout = layouts[name] ?? layouts[names[0]];
  return (
    <TokenProvider tokens={theme}>
      <PageProvider onOpenHolding={onOpenHolding} onNavigate={onNavigate}>
        {heading}
        {devSwitch && names.length > 1 && (
          <div style={{ display: "flex", justifyContent: "flex-end", gap: 6, alignItems: "center", fontSize: 10, fontFamily: FONT.mono, color: theme.textFaint, maxWidth: PAGE_MAX_WIDTH, margin: "0 0 8px" }}>
            <label htmlFor={`layout-${layout.page}`}>LAYOUT (DEV)</label>
            <select id={`layout-${layout.page}`} value={name} onChange={e => setName(e.target.value)}
              style={{ background: theme.surfaceInset, color: theme.textSecondary, border: `1px solid ${theme.border}`, borderRadius: 3, fontSize: 10.5, fontFamily: FONT.mono }}>
              {names.map(n => <option key={n} value={n}>{n}</option>)}
            </select>
          </div>
        )}
        <LayoutPage layout={layout} registry={registry} extra={extra} />
      </PageProvider>
    </TokenProvider>
  );
}
</file>

<file path="shared/table.jsx">
// VF-23 data table.
//
// Columns: [{ key, label, align, width, sortValue(row), render(row), csv(row),
//             group, optional, defaultHidden }]
// - sort by clicking a header (or Enter on it); null values always sort last;
// - column chooser for `optional` columns, remembered per viewer;
// - optional grouping rows by a key, with a group header and subtotal slot;
// - sticky header; Up/Down move the active row, Enter opens it;
// - CSV export of exactly what is visible (filters and hidden columns applied);
// - windowed rendering past 200 rows so a long table stays responsive.

import React, { useMemo, useRef, useState } from "react";
import { useT, FONT } from "./theme.jsx";
import { useLocalPref } from "./ui.jsx";

const byNull = (a, b, dir) => {
  if (a == null && b == null) return 0;
  if (a == null) return 1;
  if (b == null) return -1;
  return (typeof a === "string" ? a.localeCompare(b) : a - b) * dir;
};

export function toCsv(columns, rows) {
  const esc = v => {
    const s = v == null ? "" : String(v);
    return /[",\n]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
  };
  const head = columns.map(c => esc(c.csvLabel ?? c.label)).join(",");
  const body = rows.map(r => columns.map(c => esc(c.csv ? c.csv(r) : (c.sortValue ? c.sortValue(r) : r[c.key]))).join(",")).join("\n");
  return `${head}\n${body}\n`;
}

export function downloadCsv(filename, text) {
  const blob = new Blob(["﻿", text], { type: "text/csv;charset=utf-8" });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url; a.download = filename; document.body.appendChild(a); a.click(); a.remove();
  setTimeout(() => URL.revokeObjectURL(url), 1000);
}

export function DataTable({ id, columns, rows, rowKey = r => r.id ?? r.symbol, groupBy = null, groupLabel = g => g, groupFooter = null,
  onOpen, selectedKey, onSelect, initialSort = null, maxHeight = 560, caption, dense = false, footer = null, rowTone = null, lead = null, trail = null }) {
  const t = useT();
  const [sort, setSort] = useState(initialSort);
  const [hidden, setHidden] = useLocalPref(`table_${id}_hidden`, columns.filter(c => c.defaultHidden).map(c => c.key));
  const [chooser, setChooser] = useState(false);
  const [active, setActive] = useState(-1);
  const [scrollTop, setScrollTop] = useState(0);
  const body = useRef(null);
  const visibleCols = columns.filter(c => !hidden.includes(c.key));

  const sorted = useMemo(() => {
    if (!sort) return rows;
    const col = columns.find(c => c.key === sort.key);
    const get = col?.sortValue ?? (r => r[sort.key]);
    return [...rows].sort((a, b) => byNull(get(a), get(b), sort.dir));
  }, [rows, sort, columns]);

  const flat = useMemo(() => {
    if (!groupBy) return sorted.map(r => ({ kind: "row", row: r }));
    const groups = new Map();
    for (const r of sorted) { const g = groupBy(r) ?? "Unclassified"; if (!groups.has(g)) groups.set(g, []); groups.get(g).push(r); }
    const out = [];
    for (const [g, rs] of groups) { out.push({ kind: "group", key: g, rows: rs }); rs.forEach(r => out.push({ kind: "row", row: r })); }
    return out;
  }, [sorted, groupBy]);

  const rowH = dense ? 30 : 38;
  const windowed = flat.length > 200;
  const viewRows = windowed ? Math.ceil(maxHeight / rowH) + 10 : flat.length;
  const start = windowed ? Math.max(0, Math.floor(scrollTop / rowH) - 5) : 0;
  const slice = flat.slice(start, start + viewRows);
  const rowItems = flat.filter(f => f.kind === "row");

  const header = key => {
    setSort(s => !s || s.key !== key ? { key, dir: -1 } : s.dir === -1 ? { key, dir: 1 } : null);
  };
  const onKey = e => {
    if (!rowItems.length) return;
    if (e.key === "ArrowDown") { e.preventDefault(); const n = Math.min(rowItems.length - 1, active + 1); setActive(n); onSelect?.(rowKey(rowItems[n].row)); }
    if (e.key === "ArrowUp") { e.preventDefault(); const n = Math.max(0, active - 1); setActive(n); onSelect?.(rowKey(rowItems[n].row)); }
    if (e.key === "Enter" && active >= 0) onOpen?.(rowItems[active].row);
    if (e.key === "Escape") { setActive(-1); onSelect?.(null); }
  };
  const grid = visibleCols.map(c => c.width ?? "minmax(70px, 1fr)").join(" ");
  const cellBase = { padding: dense ? "5px 8px" : "8px 8px", fontSize: 11.5, fontFamily: FONT.mono, fontVariantNumeric: "tabular-nums", overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap", minWidth: 0 };

  return (
    <div>
      <div style={{ display: "flex", alignItems: "center", gap: 8, marginBottom: 8, position: "relative", flexWrap: "wrap" }}>
        <div style={{ flex: 1, display: "flex", alignItems: "center", gap: 8, flexWrap: "wrap", minWidth: 0 }}>{lead}</div>
        {columns.some(c => c.optional) && (
          <button onClick={() => setChooser(o => !o)} aria-expanded={chooser} style={{ background: t.surface, border: `1px solid ${t.border}`, color: t.text, borderRadius: 8, padding: "6px 12px", fontSize: 12, fontWeight: 500, cursor: "pointer", fontFamily: FONT.sans, display: "inline-flex", alignItems: "center", gap: 6, whiteSpace: "nowrap" }}>Columns <span aria-hidden>▾</span></button>
        )}
        <button onClick={() => downloadCsv(`meridian-${id}-${new Date().toISOString().slice(0, 10)}.csv`, toCsv(visibleCols, rowItems.map(f => f.row)))}
          title="Download exactly what is shown, as UTF-8 CSV with GBP amounts" style={{ background: t.surface, border: `1px solid ${t.border}`, color: t.text, borderRadius: 8, padding: "6px 12px", fontSize: 12, fontWeight: 500, cursor: "pointer", fontFamily: FONT.sans, display: "inline-flex", alignItems: "center", gap: 6, whiteSpace: "nowrap" }}><span aria-hidden>↓</span> Download CSV</button>
        {trail}
        {chooser && (
          <div role="dialog" aria-label="Choose columns" style={{ position: "absolute", top: "calc(100% + 4px)", right: 0, zIndex: 30, background: t.tooltipBg, border: `1px solid ${t.borderStrong}`, borderRadius: 6, padding: 10, display: "grid", gridTemplateColumns: "1fr 1fr", gap: "4px 14px" }}>
            {columns.filter(c => c.optional).map(c => (
              <label key={c.key} style={{ fontSize: 11, color: t.textSecondary, display: "flex", gap: 6, alignItems: "center", whiteSpace: "nowrap" }}>
                <input type="checkbox" checked={!hidden.includes(c.key)} onChange={e => setHidden(h => e.target.checked ? h.filter(k => k !== c.key) : [...h, c.key])} />
                {c.label}
              </label>
            ))}
          </div>
        )}
      </div>
      <div role="grid" aria-label={caption} aria-rowcount={rowItems.length} tabIndex={0} onKeyDown={onKey}
        ref={body} onScroll={e => setScrollTop(e.currentTarget.scrollTop)}
        style={{ maxHeight, overflow: "auto", border: `1px solid ${t.borderSubtle}`, borderRadius: 6, outline: "none" }}
        onFocus={e => { e.currentTarget.style.boxShadow = `0 0 0 2px ${t.focusRing}`; }} onBlur={e => { e.currentTarget.style.boxShadow = "none"; }}>
        <div role="row" style={{ display: "grid", gridTemplateColumns: grid, position: "sticky", top: 0, zIndex: 2, background: t.surface, borderBottom: `1px solid ${t.borderStrong}` }}>
          {visibleCols.map(c => (
            <div key={c.key} role="columnheader" aria-sort={sort?.key === c.key ? (sort.dir === 1 ? "ascending" : "descending") : "none"}
              tabIndex={c.sortable === false ? -1 : 0} onClick={c.sortable === false ? undefined : () => header(c.key)}
              onKeyDown={e => { if (e.key === "Enter" && c.sortable !== false) header(c.key); }}
              style={{ ...cellBase, fontSize: 9.5, letterSpacing: 1, color: t.textMuted, textTransform: "uppercase", cursor: c.sortable === false ? "default" : "pointer", textAlign: c.align ?? "left", userSelect: "none" }}>
              {c.label}{sort?.key === c.key ? (sort.dir === 1 ? " ▲" : " ▼") : ""}
            </div>
          ))}
        </div>
        {windowed && <div style={{ height: start * rowH }} />}
        {slice.map(f => {
          if (f.kind === "group") {
            return (
              <div key={`g-${f.key}`} role="row" style={{ display: "grid", gridTemplateColumns: grid, background: t.surfaceInset, borderBottom: `1px solid ${t.border}` }}>
                <div role="rowheader" style={{ ...cellBase, gridColumn: `1 / span ${Math.max(1, visibleCols.length - 2)}`, fontFamily: FONT.sans, fontWeight: 700, color: t.text }}>{groupLabel(f.key)} <span style={{ color: t.textFaint, fontWeight: 400 }}>· {f.rows.length}</span></div>
                {groupFooter && <div style={{ ...cellBase, gridColumn: `span 2`, textAlign: "right", color: t.textSecondary }}>{groupFooter(f.rows)}</div>}
              </div>
            );
          }
          const k = rowKey(f.row);
          const idx = rowItems.indexOf(f);
          const on = selectedKey != null && selectedKey === k;
          const focus = idx === active;
          return (
            <div key={k} role="row" aria-selected={on} onClick={() => { setActive(idx); onSelect?.(k); onOpen?.(f.row); }}
              style={{ display: "grid", gridTemplateColumns: grid, borderBottom: `1px solid ${t.borderSubtle}`, minHeight: rowH, alignItems: "center", cursor: onOpen ? "pointer" : "default",
                background: on ? t.accentSoft : focus ? t.surfaceInset : rowTone ? rowTone(f.row) : "transparent", outline: focus ? `1px solid ${t.focusRing}` : "none", outlineOffset: -1 }}>
              {visibleCols.map(c => (
                <div key={c.key} role="gridcell" style={{ ...cellBase, textAlign: c.align ?? "left", color: t.text }}>{c.render ? c.render(f.row) : f.row[c.key]}</div>
              ))}
            </div>
          );
        })}
        {windowed && <div style={{ height: Math.max(0, (flat.length - start - viewRows) * rowH) }} />}
        {footer && <div role="row" style={{ display: "grid", gridTemplateColumns: grid, borderTop: `1px solid ${t.borderStrong}`, background: t.surface, position: "sticky", bottom: 0 }}>{footer(visibleCols, cellBase)}</div>}
      </div>
    </div>
  );
}
</file>

<file path="shared/theme.jsx">
// Theme tokens for the Portfolio pages.
//
// App.jsx owns THEMES and its ThemeContext and is deliberately one file, so the
// new pages do not import from it. App.jsx hands its current token set in as a
// prop and it is provided here; every new component reads colours only from
// this context — no literal colour appears in any new file.

import React, { createContext, useContext } from "react";

const TokenContext = createContext(null);

export function TokenProvider({ tokens, children }) {
  return <TokenContext.Provider value={tokens}>{children}</TokenContext.Provider>;
}

export function useT() {
  const t = useContext(TokenContext);
  if (!t) throw new Error("useT() used outside a TokenProvider — wrap the page in <TokenProvider tokens={theme}>.");
  return t;
}

/** Categorical series colour i (cycles through the eight chart tokens). */
export const cat = (t, i) => t[`cat${(i % 8) + 1}`];

/** A token mixed towards transparent — for soft fills without a new literal. */
export const soft = (colour, pct = 18) => `color-mix(in srgb, ${colour} ${pct}%, transparent)`;

/** Mix two tokens, e.g. a diverging scale between loss and gain. */
export const mix = (a, b, pctA) => `color-mix(in srgb, ${a} ${Math.max(0, Math.min(100, pctA)).toFixed(1)}%, ${b})`;

/** Gain / loss / flat colour for a signed number. Never the only signal: views also print the sign. */
export const signColour = (t, v) => (v == null || v === 0 ? t.textMuted : v > 0 ? t.positive : t.negative);

export const FONT = {
  mono: "'SF Mono', 'Menlo', 'Consolas', 'Courier New', monospace",
  sans: "-apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif",
  serif: "'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif",
};

/** Hatched fill for "no value" cells and unseen shares — absence, drawn as absence. */
export const hatch = t => `repeating-linear-gradient(45deg, ${t.surfaceAlt} 0px, ${t.surfaceAlt} 3px, ${t.surfaceInset} 3px, ${t.surfaceInset} 6px)`;
</file>

<file path="shared/ui.jsx">
// Shared building blocks for the Portfolio pages: panel frame, section label,
// loading / refused / error states, stale badge, basis tag, provenance footer
// with an "explain this figure" popover, explained placeholder, themed NoData,
// coverage bar with named missing holdings, segmented toggle, stat tile.
//
// Views compose these; none of them fetches anything.

import React, { createContext, useContext, useEffect, useId, useRef, useState } from "react";
import { useT, FONT, soft, hatch, signColour } from "./theme.jsx";
import { age, dateTime, MISSING } from "./format.js";

// ─── Preferences and motion ───────────────────────────────────

/** Per-viewer UI preference in localStorage; never used for data. */
export function useLocalPref(key, initial) {
  const [v, setV] = useState(() => {
    try { const raw = localStorage.getItem(`meridian_pref_${key}`); return raw == null ? initial : JSON.parse(raw); }
    catch { return initial; }
  });
  useEffect(() => { try { localStorage.setItem(`meridian_pref_${key}`, JSON.stringify(v)); } catch { /* private mode */ } }, [key, v]);
  return [v, setV];
}

export function useReducedMotion() {
  const [r, setR] = useState(() => { try { return window.matchMedia("(prefers-reduced-motion: reduce)").matches; } catch { return false; } });
  useEffect(() => {
    let mq; try { mq = window.matchMedia("(prefers-reduced-motion: reduce)"); } catch { return undefined; }
    const on = () => setR(mq.matches); mq.addEventListener?.("change", on);
    return () => mq.removeEventListener?.("change", on);
  }, []);
  return r;
}

// ─── Text pieces ──────────────────────────────────────────────

export function SectionLabel({ index, children }) {
  const t = useT();
  return (
    <div style={{ fontFamily: FONT.mono, fontSize: 10, letterSpacing: 1.6, color: t.textMuted, textTransform: "uppercase" }}>
      {index != null ? `${String(index).padStart(2, "0")} — ` : ""}{children}
    </div>
  );
}

export function NoData({ reason = "No data", inline = true }) {
  const t = useT();
  return (
    <span title={reason} aria-label={`Not available: ${reason}`} role="img"
      style={{ color: t.textFaint, fontFamily: FONT.mono, fontSize: inline ? "inherit" : 12, letterSpacing: 1, cursor: "help" }}>
      {MISSING}
    </span>
  );
}

export function Muted({ children, size = 11, style }) {
  const t = useT();
  return <div style={{ fontSize: size, color: t.textFaint, lineHeight: 1.5, ...style }}>{children}</div>;
}

/** A signed figure: colour plus an explicit sign, never colour alone. */
export function Signed({ value, children, strong = false, size }) {
  const t = useT();
  return <span style={{ color: signColour(t, value), fontFamily: FONT.mono, fontWeight: strong ? 700 : 500, fontSize: size, fontVariantNumeric: "tabular-nums" }}>{children}</span>;
}

// ─── Tags and badges ──────────────────────────────────────────

export function BasisTag({ basis }) {
  const t = useT();
  if (!basis) return null;
  const text = String(basis);
  const kind = /^Recorded/i.test(text) ? "RECORDED" : /^Reconstructed|reconstruct/i.test(text) ? "RECONSTRUCTED" : /estimate/i.test(text) ? "ESTIMATE" : "LIVE";
  return (
    <span title={text} tabIndex={0} aria-label={`Basis: ${kind.toLowerCase()}. ${text}`}
      style={{ fontFamily: FONT.mono, fontSize: 9, letterSpacing: 1.2, padding: "2px 6px", borderRadius: 3, border: `1px solid ${t.borderStrong}`, color: t.textSecondary, background: t.surfaceInset, whiteSpace: "nowrap", cursor: "help" }}>
      {kind}
    </span>
  );
}

export function StaleBadge({ stale, asOf }) {
  const t = useT();
  if (!stale) return null;
  return (
    <span role="status" title={asOf ? `Last updated ${dateTime(asOf)}` : "Age unknown"}
      style={{ fontFamily: FONT.mono, fontSize: 9, letterSpacing: 1, padding: "2px 6px", borderRadius: 3, color: t.warning, background: t.warningSoft, border: `1px solid ${soft(t.warning, 45)}` }}>
      STALE · {age(asOf)}
    </span>
  );
}

export function Chip({ children, onClick, active = false, title, weight }) {
  const t = useT();
  const Tag = onClick ? "button" : "span";
  return (
    <Tag onClick={onClick} title={title} aria-pressed={onClick ? active : undefined}
      style={{ display: "inline-flex", gap: 5, alignItems: "baseline", fontFamily: FONT.mono, fontSize: 10.5, padding: "2px 7px", borderRadius: 10,
        border: `1px solid ${active ? t.accent : t.border}`, background: active ? t.accentSoft : "transparent", color: active ? t.accent : t.textSecondary,
        cursor: onClick ? "pointer" : "default" }}>
      {children}{weight != null && <span style={{ color: t.textFaint }}>{weight}</span>}
    </Tag>
  );
}

// ─── Explain popover (EX-07) ──────────────────────────────────

export function Explain({ title = "About this figure", children, label = "Explain" }) {
  const t = useT();
  const [open, setOpen] = useState(false);
  const id = useId();
  const btn = useRef(null);
  const box = useRef(null);
  useEffect(() => {
    if (!open) return undefined;
    const onKey = e => { if (e.key === "Escape") { setOpen(false); btn.current?.focus(); } };
    const onDown = e => { if (!box.current?.contains(e.target) && !btn.current?.contains(e.target)) setOpen(false); };
    window.addEventListener("keydown", onKey); window.addEventListener("mousedown", onDown);
    return () => { window.removeEventListener("keydown", onKey); window.removeEventListener("mousedown", onDown); };
  }, [open]);
  return (
    <span style={{ position: "relative", display: "inline-block" }}>
      <button ref={btn} onClick={() => setOpen(o => !o)} aria-expanded={open} aria-controls={id} title={title}
        style={{ background: "transparent", border: `1px solid ${t.border}`, color: t.textMuted, borderRadius: 10, fontSize: 10, padding: "1px 7px", cursor: "pointer", fontFamily: FONT.mono }}>
        {label === "Explain" ? "?" : label}
      </button>
      {open && (
        <div ref={box} id={id} role="dialog" aria-label={title}
          style={{ position: "absolute", zIndex: 50, right: 0, top: "calc(100% + 6px)", width: 320, maxWidth: "80vw", background: t.tooltipBg, border: `1px solid ${t.borderStrong}`, borderRadius: 6, padding: "10px 12px", fontSize: 11.5, lineHeight: 1.55, color: t.textSecondary, boxShadow: `0 8px 24px ${soft(t.appBg, 60)}` }}>
          <div style={{ fontWeight: 700, color: t.text, marginBottom: 6 }}>{title}</div>
          {children}
        </div>
      )}
    </span>
  );
}

/** The method / source / window / coverage block most explain popovers show. */
export function ExplainBody({ source, basis, coverage, note, asOf, method }) {
  const t = useT();
  const row = (k, v) => v ? <div style={{ marginBottom: 5 }}><span style={{ color: t.textFaint, fontFamily: FONT.mono, fontSize: 9.5, letterSpacing: 1 }}>{k} </span>{v}</div> : null;
  return (
    <>
      {row("METHOD", method)}
      {row("SOURCE", source)}
      {row("BASIS", basis)}
      {row("AS OF", asOf ? dateTime(asOf) : null)}
      {row("COVERAGE", coverage?.note ?? (coverage?.share != null ? `${(coverage.share * 100).toFixed(1)}% of the book` : null))}
      {coverage?.missing?.length ? row("NOT INCLUDED", coverage.missing.map(m => `${m.symbol} (${m.reason})`).join("; ")) : null}
      {row("NOTE", note)}
    </>
  );
}

// ─── Provenance footer (F-29 / SC-2) ──────────────────────────

export function ProvenanceFooter({ source, asOf, basis, coverage, note, method, extra }) {
  const t = useT();
  if (!source && !asOf && !basis) return null;
  return (
    <div style={{ display: "flex", alignItems: "center", gap: 8, flexWrap: "wrap", borderTop: `1px solid ${t.borderSubtle}`, padding: "8px 14px", fontSize: 10, color: t.textFaint, fontFamily: FONT.sans, lineHeight: 1.45 }}>
      <span style={{ flex: 1, minWidth: 180 }}>
        {source ? `Source: ${source}` : null}
        {asOf ? ` · as of ${dateTime(asOf)}` : ""}
        {extra ? ` · ${extra}` : ""}
      </span>
      <BasisTag basis={basis} />
      <Explain title="Where this comes from">
        <ExplainBody source={source} basis={basis} coverage={coverage} note={note} asOf={asOf} method={method} />
      </Explain>
    </div>
  );
}

// ─── Frame ────────────────────────────────────────────────────

const SMALL_WORDS = new Set(["and", "or", "of", "the", "a", "an", "to", "in", "on", "at", "for", "by", "vs", "with", "per"]);
export const titleCase = str => str.split(" ").map((w, i) => (i > 0 && SMALL_WORDS.has(w.toLowerCase()) ? w.toLowerCase() : w.charAt(0).toUpperCase() + w.slice(1))).join(" ");

// Inside a Card, frames drop their own border so several panels share one box.
export const CardCtx = createContext(false);
export function Card({ children, id }) {
  const t = useT();
  return (
    <section data-component={id} style={{ background: t.surface, border: `1px solid ${t.border}`, borderRadius: 8, display: "flex", flexDirection: "column", minWidth: 0, flex: 1 }}>
      <CardCtx.Provider value={true}>{children}</CardCtx.Provider>
    </section>
  );
}

export function Frame({ index, label, title, right, children, footer, id, minHeight, dark = false, pad = true, fill = false, grow = false }) {
  const t = useT();
  const nested = useContext(CardCtx);
  if (footer && footer.type === ProvenanceFooter) footer = null;
  return (
    <section aria-labelledby={id ? `${id}-title` : undefined} data-component={id}
      style={{ background: dark ? t.chromeBg : t.surface, border: nested ? "none" : `1px solid ${t.border}`, borderRadius: 8, display: "flex", flexDirection: "column", minWidth: 0, minHeight, overflow: "visible", ...(grow || (nested && fill) ? { flex: 1 } : null) }}>
      {(label || title || right) && (
        <header style={{ display: "flex", alignItems: "flex-start", justifyContent: "space-between", gap: 10, padding: "12px 14px 8px", flexWrap: "wrap" }}>
          <div style={{ minWidth: 0 }}>
            {label && !title && <SectionLabel>{label}</SectionLabel>}
            {title && (
              <h3 id={id ? `${id}-title` : undefined} style={{ margin: "2px 0 0", display: "flex", alignItems: "center", gap: 9, fontFamily: FONT.sans, fontWeight: 650, fontSize: 15, letterSpacing: 0.15, color: t.text }}>
                <span aria-hidden style={{ width: 3, height: 16, borderRadius: 2, background: t.info, flex: "none" }} />
                <span>{typeof title === "string" ? titleCase(title) : title}</span>
              </h3>
            )}
          </div>
          {right && <div style={{ display: "flex", gap: 6, alignItems: "center", flexWrap: "wrap" }}>{right}</div>}
        </header>
      )}
      <div style={{ padding: pad ? "4px 14px 12px" : 0, flex: 1, minWidth: 0, ...(fill ? { display: "flex", flexDirection: "column" } : null) }}>{children}</div>
      {footer}
    </section>
  );
}

// ─── States (SC-1) ────────────────────────────────────────────

export function Skeleton({ lines = 4, height = 140 }) {
  const t = useT();
  const reduced = useReducedMotion();
  return (
    <div aria-busy="true" aria-label="Loading" style={{ display: "flex", flexDirection: "column", gap: 8, minHeight: height, justifyContent: "center" }}>
      {Array.from({ length: lines }, (_, i) => (
        <div key={i} style={{ height: 10, width: `${90 - i * 12}%`, borderRadius: 4, background: t.surfaceInset, opacity: reduced ? 0.8 : undefined, animation: reduced ? "none" : "meridianPulse 1.4s ease-in-out infinite" }} />
      ))}
      <style>{"@keyframes meridianPulse { 0%,100% { opacity: .45 } 50% { opacity: .9 } }"}</style>
    </div>
  );
}

/**
 * Standard rendering for the non-ready states. Wording is the engine's own
 * reason (British English, written server-side) so a refusal says exactly
 * why, and never reassures.
 */
export function StateView({ status, reason, children, height = 140, onRetry, empty }) {
  const t = useT();
  if (status === "loading") return <Skeleton height={height} />;
  if (status === "error") {
    return (
      <div role="alert" style={{ minHeight: height, display: "flex", flexDirection: "column", justifyContent: "center", gap: 8, color: t.negative, fontSize: 12 }}>
        <div>⚠ {reason ?? "Something went wrong."}</div>
        {onRetry && <button onClick={onRetry} style={{ alignSelf: "flex-start", background: "transparent", border: `1px solid ${t.borderStrong}`, color: t.textSecondary, borderRadius: 3, padding: "4px 10px", cursor: "pointer", fontSize: 11 }}>Try again</button>}
      </div>
    );
  }
  if (status === "refused") {
    return (
      <div role="note" style={{ minHeight: height, display: "flex", flexDirection: "column", justifyContent: "center", gap: 6 }}>
        <div style={{ fontFamily: FONT.mono, fontSize: 9.5, letterSpacing: 1.2, color: t.textFaint }}>NOT AVAILABLE</div>
        <div style={{ fontSize: 12.5, color: t.textSecondary, lineHeight: 1.55, maxWidth: 560 }}>{reason}</div>
        {empty}
      </div>
    );
  }
  return children;
}

/** An explained "not built / not available yet" block. Never sample data. */
export function Placeholder({ title, reason, unblocks, height = 120 }) {
  const t = useT();
  return (
    <div role="note" style={{ minHeight: height, border: `1px dashed ${t.borderStrong}`, borderRadius: 8, padding: "14px 16px", display: "flex", flexDirection: "column", justifyContent: "center", gap: 6, background: hatch(t) }}>
      {title && <div style={{ fontFamily: FONT.mono, fontSize: 10, letterSpacing: 1.4, color: t.textMuted, textTransform: "uppercase" }}>{title}</div>}
      <div style={{ fontSize: 12.5, color: t.textSecondary, lineHeight: 1.55, background: t.surface, padding: "6px 8px", borderRadius: 4, alignSelf: "flex-start" }}>{reason}</div>
      {unblocks && <div style={{ fontSize: 10.5, color: t.textFaint, background: t.surface, padding: "2px 8px", borderRadius: 4, alignSelf: "flex-start" }}>Unblocks when: {unblocks}</div>}
    </div>
  );
}

// ─── Coverage bar + missing chips (VF-27) ─────────────────────

export function CoverageBar({ share, label = "Covered", missing = [], note }) {
  const t = useT();
  const s = share == null ? null : Math.max(0, Math.min(1, share));
  return (
    <div>
      {s != null && (
        <>
          <div style={{ display: "flex", justifyContent: "space-between", fontSize: 10, color: t.textMuted, fontFamily: FONT.mono, marginBottom: 4 }}>
            <span>{label} {(s * 100).toFixed(1)}%</span><span>not seen {((1 - s) * 100).toFixed(1)}%</span>
          </div>
          <div role="img" aria-label={`${label} ${(s * 100).toFixed(1)} percent; ${((1 - s) * 100).toFixed(1)} percent not seen`}
            style={{ display: "flex", height: 8, borderRadius: 3, overflow: "hidden", border: `1px solid ${t.border}` }}>
            <div style={{ width: `${s * 100}%`, background: t.info }} />
            <div style={{ flex: 1, background: hatch(t) }} />
          </div>
        </>
      )}
      {missing.length > 0 && (
        <div style={{ display: "flex", flexWrap: "wrap", gap: 4, marginTop: 6 }}>
          {missing.map(m => <Chip key={m.symbol} title={m.reason}>{m.symbol} ✕</Chip>)}
        </div>
      )}
      {note && <Muted size={10.5} style={{ marginTop: 4 }}>{note}</Muted>}
    </div>
  );
}

// ─── Segmented toggle (VF-28) ─────────────────────────────────

export function Segmented({ options, value, onChange, label, size = "s", disabled = {} }) {
  const t = useT();
  const refs = useRef([]);
  const idx = options.findIndex(o => (o.value ?? o) === value);
  const move = d => {
    let i = idx;
    for (let k = 0; k < options.length; k++) {
      i = (i + d + options.length) % options.length;
      const v = options[i].value ?? options[i];
      if (!disabled[v]) { onChange(v); refs.current[i]?.focus(); return; }
    }
  };
  return (
    <div role="radiogroup" aria-label={label} style={{ display: "inline-flex", flexWrap: "wrap", maxWidth: "100%", border: `1px solid ${t.border}`, borderRadius: 14, padding: 2, gap: 2, background: t.surfaceInset }}
      onKeyDown={e => { if (e.key === "ArrowRight") { e.preventDefault(); move(1); } if (e.key === "ArrowLeft") { e.preventDefault(); move(-1); } }}>
      {options.map((o, i) => {
        const v = o.value ?? o; const text = o.label ?? o; const on = v === value; const dis = disabled[v];
        return (
          <button key={v} ref={el => { refs.current[i] = el; }} role="radio" aria-checked={on} tabIndex={on ? 0 : -1}
            disabled={!!dis} title={typeof dis === "string" ? dis : o.title}
            onClick={() => onChange(v)}
            style={{ border: "none", borderRadius: 12, padding: size === "s" ? "3px 9px" : "5px 12px", fontSize: size === "s" ? 10.5 : 11.5, fontFamily: FONT.mono, cursor: dis ? "not-allowed" : "pointer",
              background: on ? t.text : "transparent", color: on ? t.surface : dis ? t.textFaint : t.textSecondary, textDecoration: dis ? "line-through" : "none" }}>
            {text}
          </button>
        );
      })}
    </div>
  );
}

// ─── Stat tile (VF-24) ────────────────────────────────────────

export function Stat({ label, value, sub, sign, explain, onClick, size = "m", reason }) {
  const t = useT();
  const valueEl = (
    <span style={{ fontFamily: FONT.mono, fontSize: size === "l" ? 24 : size === "s" ? 15 : 19, color: sign == null ? t.text : signColour(t, sign), fontVariantNumeric: "tabular-nums", fontWeight: 600 }}>
      {value == null ? <NoData reason={reason ?? "Not available"} /> : value}
    </span>
  );
  return (
    <div style={{ padding: "8px 10px", minWidth: 0 }}>
      <div style={{ fontFamily: FONT.mono, fontSize: 9.5, letterSpacing: 1.3, color: t.textMuted, textTransform: "uppercase", display: "flex", justifyContent: "space-between", gap: 6, alignItems: "center" }}>
        <span>{label}</span>{explain}
      </div>
      <div style={{ marginTop: 5 }}>
        {onClick ? (
          <button onClick={onClick} title={`Open ${label}`} style={{ background: "transparent", border: "none", padding: 0, cursor: "pointer", textAlign: "left" }}>{valueEl}</button>
        ) : valueEl}
      </div>
      {sub && <div style={{ fontSize: 10.5, color: t.textFaint, marginTop: 3, lineHeight: 1.4 }}>{sub}</div>}
    </div>
  );
}

// ─── Error boundary (F-04) ────────────────────────────────────

export class PanelBoundary extends React.Component {
  constructor(p) { super(p); this.state = { error: null }; }
  static getDerivedStateFromError(error) { return { error }; }
  componentDidCatch(error) { console.warn(`[panel ${this.props.name}]`, error?.message); }
  render() {
    if (this.state.error) {
      return <this.props.Fallback name={this.props.name} message={String(this.state.error?.message ?? this.state.error)} />;
    }
    return this.props.children;
  }
}

export function PanelCrash({ name, message }) {
  const t = useT();
  return (
    <div role="alert" style={{ border: `1px solid ${t.negative}`, borderRadius: 8, padding: 14, fontSize: 12, color: t.negative, background: t.surface }}>
      ⚠ {name} failed to draw: {message}. The rest of the page is unaffected.
    </div>
  );
}

/** Visually hidden text for screen readers (chart text alternatives). */
export function SrOnly({ children }) {
  return <span style={{ position: "absolute", width: 1, height: 1, overflow: "hidden", clip: "rect(0 0 0 0)", whiteSpace: "nowrap" }}>{children}</span>;
}
</file>

<file path="shared/useApi.js">
// useApi — the only way a Portfolio-page hook talks to the server.
//
// Returns the panel contract in a fixed shape:
//   { status: 'loading' | 'ready' | 'refused' | 'error',
//     data, reason, asOf, source, basis, coverage, note, stale, refetch }
//
// - refetches when a data-version part it depends on changes;
// - keeps what is on screen while refetching (no skeleton flash on a poll);
// - keeps the previous object when the new body is identical, so a view whose
//   inputs did not change does not re-render;
// - aborts on unmount (shared requests only when their last caller leaves).

import { useCallback, useEffect, useRef, useState } from "react";
import { getJson } from "./api.js";
import { useVersionKey } from "./dataVersion.js";

const EMPTY = { status: "loading", data: null, reason: null, asOf: null, source: null, basis: null, coverage: null, note: null };

export function envelopeToState(env) {
  if (!env || typeof env !== "object") return { ...EMPTY, status: "error", reason: "The API returned nothing." };
  if (env.available === false) {
    return { status: "refused", data: env.data ?? null, reason: env.reason ?? "Not available.", asOf: env.asOf ?? null, source: env.source ?? null, basis: env.basis ?? null, coverage: env.coverage ?? null, note: env.note ?? null };
  }
  return { status: "ready", data: env.data ?? null, reason: null, asOf: env.asOf ?? null, source: env.source ?? null, basis: env.basis ?? null, coverage: env.coverage ?? null, note: env.note ?? null };
}

export function useApi(path, { deps = ["prices", "book"], enabled = true, staleAfterMs = null, adapt = null } = {}) {
  const versionKey = useVersionKey(deps);
  const [state, setState] = useState(EMPTY);
  const lastBody = useRef(null);
  const [nonce, setNonce] = useState(0);
  const refetch = useCallback(() => setNonce(n => n + 1), []);

  const lastPath = useRef(path);
  useEffect(() => {
    // A different path is different data: never keep showing the old answer
    // under a new question (e.g. the inspector after the selection changes).
    if (lastPath.current !== path) { lastPath.current = path; lastBody.current = null; setState(EMPTY); }
    if (!enabled || !path) return undefined;
    let live = true;
    const { promise, release } = getJson(path);
    promise.then(body => {
      if (!live) return;
      const text = JSON.stringify(body);
      if (text === lastBody.current) return;            // identical: keep the old object
      lastBody.current = text;
      setState(envelopeToState(adapt ? adapt(body) : body));
    }).catch(e => {
      if (!live || e?.name === "AbortError") return;
      lastBody.current = null;
      setState(s => ({ ...s, status: "error", reason: e?.message?.includes("fetch") ? "Could not reach the Meridian API." : (e?.message ?? "Request failed.") }));
    });
    return () => { live = false; release(); };
  }, [path, versionKey, enabled, nonce]);  // eslint-disable-line react-hooks/exhaustive-deps

  const stale = staleAfterMs != null && state.asOf != null && Date.now() - state.asOf > staleAfterMs;
  return { ...state, stale, refetch };
}

/** Combine several results: loading/error/refused from the first that is, else ready. */
export function combine(primary, ...others) {
  for (const r of [primary, ...others]) if (r.status === "error") return r;
  if ([primary, ...others].some(r => r.status === "loading")) return { ...primary, status: "loading" };
  return primary;
}
