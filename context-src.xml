// OV-08 headlines touching the book. Forms: relevant list with exposure %,
// helps/hurts tag, editorial dispatch, pinned-today strip, per-holding chips,
// compact night-feed. Headline and link only — no article text reproduced.
import React, { useState } from "react";
import { useT, FONT, soft, signColour } from "../../shared/theme.jsx";
import { Frame, StateView, ProvenanceFooter, Segmented, Muted, StaleBadge, Chip, SrOnly } from "../../shared/ui.jsx";
import { age } from "../../shared/format.js";

function Tag({ dir }) {
  const t = useT();
  const map = { helps: [t.positive, "helps"], hurts: [t.negative, "hurts"], neutral: [t.textMuted, "neutral"], unscored: [t.textFaint, "unscored"] };
  const [c, l] = map[dir] ?? map.neutral;
  return <span style={{ fontFamily: FONT.mono, fontSize: 9, letterSpacing: 1, padding: "1px 5px", borderRadius: 3, border: `1px solid ${soft(c, 60)}`, color: c }}>{l.toUpperCase()}</span>;
}

function Story({ s, read, markRead, page, lead = false, compact = false }) {
  const t = useT();
  const isRead = read.includes(s.guid);
  return (
    <div role="listitem" style={{ display: "grid", gridTemplateColumns: compact ? "1fr" : "1fr 80px", gap: 10, padding: "8px 0", borderBottom: `1px solid ${t.borderSubtle}`, opacity: isRead ? 0.6 : 1 }}>
      <div style={{ minWidth: 0 }}>
        <div style={{ fontFamily: FONT.mono, fontSize: 9.5, color: t.textFaint, display: "flex", gap: 6, alignItems: "center" }}>
          <span aria-hidden style={{ color: s.direction === "helps" ? t.positive : s.direction === "hurts" ? t.negative : t.textFaint }}>●</span>
          {s.source} · {age(s.published)} <Tag dir={s.direction} />{s.alsoReported ? ` · +${s.alsoReported} similar` : ""}
        </div>
        <a href={s.url} target="_blank" rel="noopener noreferrer" onClick={() => markRead(s.guid)}
          style={{ display: "block", fontFamily: FONT.serif, fontSize: lead ? 19 : compact ? 12.5 : 14, color: t.text, textDecoration: "none", margin: "3px 0", lineHeight: 1.3 }}>{s.title}</a>
        {!compact && s.why && <div style={{ fontSize: 10.5, color: t.textMuted }}>{s.why}</div>}
        <div style={{ display: "flex", gap: 4, flexWrap: "wrap", marginTop: 3 }}>
          {s.holdings.map(h => <Chip key={h.symbol} onClick={() => page?.onOpenHolding?.(h.symbol)} weight={`${h.weight?.toFixed(1)}%`}>{h.symbol}</Chip>)}
          {!isRead && <button onClick={() => markRead(s.guid)} style={{ background: "transparent", border: "none", color: t.textFaint, fontSize: 10, cursor: "pointer" }}>mark read</button>}
        </div>
      </div>
      {!compact && (
        <div aria-label={`${s.touchedPct}% of the book touched`}>
          <div style={{ fontFamily: FONT.serif, fontSize: 18, color: t.text }}>{s.touchedPct.toFixed(1)}%</div>
          <div style={{ fontFamily: FONT.mono, fontSize: 8.5, color: t.textFaint, letterSpacing: 1 }}>OF BOOK TOUCHED</div>
          <div style={{ height: 3, background: t.surfaceInset, marginTop: 3 }}><div style={{ height: 3, width: `${Math.min(100, s.touchedPct * 3)}%`, background: t.text }} /></div>
        </div>
      )}
    </div>
  );
}

export function NewsView({ status, data: d, reason, asOf, source, basis, coverage, stale, stories = [], pinned = [], byHolding = {}, read = [], markRead, textAlt, size = "m", props = {}, page, refetch }) {
  const t = useT();
  const [form, setForm] = useState(props.compact ? "night" : "list");
  const cols = size === "l" && form === "list" ? 2 : 1;
  return (
    <Frame id="news" index={7} label="Headlines touching your book" title="Relevant developments"
      right={<><StaleBadge stale={stale} asOf={asOf} /><Segmented label="News form" value={form} onChange={setForm} options={[{ value: "list", label: "List" }, { value: "dispatch", label: "Dispatch" }, { value: "pinned", label: "Today" }, { value: "chips", label: "By holding" }, { value: "night", label: "Compact" }]} />
        <button onClick={() => page?.onNavigate?.("news")} style={{ background: "transparent", border: "none", color: t.info, cursor: "pointer", fontSize: 11 }}>All news →</button></>}
      footer={<ProvenanceFooter source={source} asOf={asOf} basis={basis} coverage={coverage} extra={d ? `last ${d.hours}h · ${d.aiScoring ? "AI-scored" : "lexicon sentiment (filter aid)"}` : null} />}>
      <StateView status={status} reason={reason} onRetry={refetch} height={140}>
        {d && (
          <>
            {!d.aiScoring && <div role="note" style={{ fontSize: 10.5, color: t.warning, marginBottom: 6 }}>No AI key set: helps/hurts comes from a word-list sentiment — a filter aid, not a judgement.</div>}
            {stories.length === 0 && <Muted>{d.note ?? "No stored story names a holding in this window."}</Muted>}
            {stories.length > 0 && (
              <div style={{ display: "flex", gap: 12, fontSize: 10.5, fontFamily: FONT.mono, color: t.textMuted, marginBottom: 6, flexWrap: "wrap" }}>
                <span>{d.touchedPct.toFixed(1)}% of the book touched</span>
                <span style={{ color: t.positive }}>+ {d.exposure.positive.toFixed(1)}%</span>
                <span style={{ color: t.negative }}>− {d.exposure.negative.toFixed(1)}%</span>
                <span>neutral {d.exposure.neutral.toFixed(1)}%</span>
                <span style={{ color: t.textFaint }}>no coverage {d.exposure.noCoverage.toFixed(1)}%</span>
              </div>
            )}
            {form === "list" && <div role="list" style={{ display: "grid", gridTemplateColumns: `repeat(${cols}, minmax(0,1fr))`, columnGap: 20 }}>{stories.map(s => <Story key={s.guid} s={s} read={read} markRead={markRead} page={page} />)}</div>}
            {form === "dispatch" && stories.length > 0 && (
              <div style={{ display: "grid", gridTemplateColumns: size === "s" ? "1fr" : "1.4fr 1fr", gap: 16 }}>
                <div role="list"><Story s={stories[0]} read={read} markRead={markRead} page={page} lead /></div>
                <div role="list">{stories.slice(1, 6).map(s => <Story key={s.guid} s={s} read={read} markRead={markRead} page={page} compact />)}</div>
              </div>
            )}
            {form === "pinned" && (pinned.length ? (
              <div role="list" style={{ display: "flex", gap: 8, overflowX: "auto" }}>
                {pinned.map(s => (
                  <a key={s.guid} role="listitem" href={s.url} target="_blank" rel="noopener noreferrer" onClick={() => markRead(s.guid)}
                    style={{ minWidth: 220, background: t.surfaceInset, borderRadius: 6, padding: 8, textDecoration: "none", borderLeft: `3px solid ${s.direction === "helps" ? t.positive : s.direction === "hurts" ? t.negative : t.border}` }}>
                    <div style={{ fontFamily: FONT.mono, fontSize: 9.5, color: t.textFaint }}>📌 {age(s.published)} · {s.touchedPct.toFixed(1)}%</div>
                    <div style={{ fontSize: 12, color: t.text }}>{s.title}</div>
                  </a>
                ))}
              </div>
            ) : <Muted>Nothing touching the book in the last 24 hours.</Muted>)}
            {form === "chips" && (
              <div role="list">
                {Object.entries(byHolding).map(([sym, ss]) => (
                  <div role="listitem" key={sym} style={{ padding: "5px 0", borderBottom: `1px solid ${t.borderSubtle}` }}>
                    <Chip onClick={() => page?.onOpenHolding?.(sym)}>{sym}</Chip>
                    {ss.map(s => <a key={s.guid} href={s.url} target="_blank" rel="noopener noreferrer" style={{ display: "block", fontSize: 11.5, color: t.text, textDecoration: "none", margin: "3px 0 0 4px" }}><Tag dir={s.direction} /> {s.title}</a>)}
                  </div>
                ))}
              </div>
            )}
            {form === "night" && (
              <div role="list">
                {stories.map(s => (
                  <a key={s.guid} role="listitem" href={s.url} target="_blank" rel="noopener noreferrer" onClick={() => markRead(s.guid)}
                    style={{ display: "grid", gridTemplateColumns: "44px 1fr 50px", gap: 6, fontSize: 11, padding: "3px 0", textDecoration: "none", color: read.includes(s.guid) ? t.textFaint : t.textSecondary }}>
                    <span style={{ fontFamily: FONT.mono, color: t.textFaint }}>{age(s.published)}</span>
                    <span style={{ overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>{s.title}</span>
                    <span style={{ fontFamily: FONT.mono, textAlign: "right", color: signColour(t, s.direction === "helps" ? 1 : s.direction === "hurts" ? -1 : 0) }}>{s.touchedPct.toFixed(1)}%</span>
                  </a>
                ))}
              </div>
            )}
            <SrOnly>{textAlt}</SrOnly>
          </>
        )}
      </StateView>
    </Frame>
  );
}
</file>

<file path="overview/views/PerformanceChartView.jsx">
// OV-12 performance chart and OV-24 period strip.
import React, { useState } from "react";
import { useT, FONT, soft, signColour } from "../../shared/theme.jsx";
import { Frame, StateView, ProvenanceFooter, Segmented, Chip, BasisTag, StaleBadge, Muted, SrOnly } from "../../shared/ui.jsx";
import { LineChart } from "../../shared/charts/line.jsx";
import { pct, pp, gbp, gbpCompact, date } from "../../shared/format.js";

const RANGES = ["1M", "3M", "6M", "YTD", "1Y", "3Y", "5Y", "MAX"];
const PERIOD_OF_RANGE = { "1M": "1M", "3M": "3M", "6M": "6M", YTD: "YTD", "1Y": "1Y", "3Y": "3Y", "5Y": "5Y", MAX: "ITD" };

/** Altitude ruler: where the latest value sits between the window's low and high. */
function AltitudeRuler({ points }) {
  const t = useT();
  if (!points?.length) return null;
  const vals = points.map(p => p.portfolio);
  const lo = Math.min(...vals), hi = Math.max(...vals), now = vals[vals.length - 1];
  const b = points.map(p => p.benchmark).filter(v => v != null);
  const f = hi > lo ? (now - lo) / (hi - lo) : 0.5;
  const bf = b.length && Math.max(...b) > Math.min(...b) ? (b[b.length - 1] - Math.min(...b)) / (Math.max(...b) - Math.min(...b)) : null;
  return (
    <div role="img" aria-label={`Latest value is ${(f * 100).toFixed(0)}% of the way from this window's low to its high`} style={{ margin: "8px 0 2px" }}>
      <div style={{ display: "flex", justifyContent: "space-between", fontSize: 9.5, color: t.textFaint, fontFamily: FONT.mono }}><span>window low</span><span>altitude {(f * 100).toFixed(0)}%</span><span>window high</span></div>
      <div style={{ position: "relative", height: 10, borderRadius: 5, background: `linear-gradient(90deg, ${soft(t.negative, 30)}, ${t.surfaceInset}, ${soft(t.positive, 30)})` }}>
        <div title="Portfolio" style={{ position: "absolute", left: `${f * 100}%`, top: -3, width: 4, height: 16, marginLeft: -2, background: t.text, borderRadius: 2 }} />
        {bf != null && <div title="Benchmark" style={{ position: "absolute", left: `${bf * 100}%`, top: 1, width: 8, height: 8, marginLeft: -4, border: `2px solid ${t.benchmark}`, borderRadius: 4, background: t.surface }} />}
      </div>
    </div>
  );
}

export function PeriodStrip({ periods, state, onPick, active, compact = false }) {
  const t = useT();
  if (!periods) return <Muted>{state?.reason ?? "Period returns loading…"}</Muted>;
  const rows = periods.rows.filter(r => ["1M", "3M", "6M", "YTD", "1Y", compact ? null : "3Y", "ITD"].includes(r.period));
  return (
    <div role="list" aria-label="Returns by period against the benchmark" style={{ display: "grid", gridTemplateColumns: `repeat(${rows.length}, minmax(0, 1fr))`, borderTop: `1px solid ${t.border}` }}>
      {rows.map(r => {
        const range = r.period === "ITD" ? "MAX" : r.period;
        const on = active === r.period || (active === "MAX" && r.period === "ITD");
        return (
          <button key={r.period} role="listitem" disabled={!r.available} onClick={() => onPick?.(r.period === "ITD" ? "MAX" : r.period)}
            title={r.available ? `${r.from} to ${r.to} · ${r.bars} bars` : r.reason} aria-pressed={on}
            style={{ textAlign: "left", background: on ? t.surfaceInset : "transparent", border: "none", borderRight: `1px solid ${t.borderSubtle}`, borderTop: on ? `2px solid ${t.text}` : "2px solid transparent",
              padding: "8px 8px", cursor: r.available ? "pointer" : "not-allowed", color: "inherit", minWidth: 0 }}>
            <div style={{ fontFamily: FONT.mono, fontSize: 9.5, color: t.textMuted }}>{r.period === "ITD" ? "MAX" : range}</div>
            {r.available ? (
              <>
                <div style={{ fontFamily: FONT.mono, fontSize: 14, color: signColour(t, r.portfolio), marginTop: 3 }}>{pct(r.portfolio, { dp: 1 })}</div>
                <div style={{ fontSize: 9.5, color: t.textFaint, fontFamily: FONT.mono, marginTop: 2, whiteSpace: "nowrap" }}>
                  {periods.benchmark.label} {pct(r.benchmark, { dp: 1 })}{" "}
                  {r.excessPp != null && <span style={{ padding: "0 3px", borderRadius: 2, background: soft(r.excessPp >= 0 ? t.positive : t.negative, 18), color: signColour(t, r.excessPp) }}>{pp(r.excessPp)}</span>}
                </div>
                {r.portfolioAnnualised != null && <div style={{ fontSize: 9, color: t.textFaint, fontFamily: FONT.mono }}>{pct(r.portfolioAnnualised, { dp: 1 })} a year</div>}
              </>
            ) : (
              <div style={{ fontSize: 10, color: t.textFaint, marginTop: 4, lineHeight: 1.35 }}>not enough history</div>
            )}
          </button>
        );
      })}
    </div>
  );
}

/** OV-24 form 2: the range of returns across periods, as one bar each with the benchmark tick. */
export function RangeOfReturns({ periods }) {
  const t = useT();
  if (!periods) return null;
  const rows = periods.rows.filter(r => r.available);
  const max = Math.max(1, ...rows.flatMap(r => [Math.abs(r.portfolio ?? 0), Math.abs(r.benchmark ?? 0)]));
  return (
    <div role="list" aria-label="Range of returns by period">
      {rows.map(r => (
        <div key={r.period} role="listitem" aria-label={`${r.period}: portfolio ${pct(r.portfolio)}, benchmark ${pct(r.benchmark)}`} style={{ display: "grid", gridTemplateColumns: "36px 1fr 64px", gap: 8, alignItems: "center", padding: "3px 0" }}>
          <span style={{ fontFamily: FONT.mono, fontSize: 10.5, color: t.textSecondary }}>{r.period}</span>
          <span style={{ position: "relative", height: 10 }}>
            <span style={{ position: "absolute", left: "50%", top: -2, bottom: -2, width: 1, background: t.borderStrong }} />
            <span style={{ position: "absolute", top: 2, height: 6, borderRadius: 2, background: r.portfolio >= 0 ? t.positive : t.negative, left: r.portfolio >= 0 ? "50%" : `${50 - Math.abs(r.portfolio) / max * 50}%`, width: `${Math.abs(r.portfolio) / max * 50}%` }} />
            {r.benchmark != null && <span title={`Benchmark ${pct(r.benchmark)}`} style={{ position: "absolute", left: `${50 + (r.benchmark / max) * 50}%`, top: -3, width: 2, height: 16, background: t.benchmark }} />}
          </span>
          <span style={{ fontFamily: FONT.mono, fontSize: 10.5, textAlign: "right", color: signColour(t, r.portfolio) }}>{pct(r.portfolio, { dp: 1 })}</span>
        </div>
      ))}
    </div>
  );
}

export function PerformanceChartView(r) {
  const { status, data: d, reason, asOf, source, basis, coverage, stale, fillable, periods, periodsState, benchmarks, markers, unusual, goal, goalReason, basisMode, setBasisMode, size = "m", props = {}, page, refetch } = r;
  const t = useT();
  const [view, setView] = useState("return");
  const [showMarkers, setShowMarkers] = useState(true);
  const range = r.rangeFor?.[page.period] ?? "1Y";
  const pts = d?.points ?? [];
  const dates = pts.map(p => p.date);
  const benchLabel = d?.benchmark?.label ?? "Benchmark";
  const series = view === "value"
    ? [{ key: "value", label: "Portfolio £", values: pts.map(p => p.value), colour: t.text, area: true }]
    : view === "relative"
      ? [{ key: "relative", label: `Portfolio ÷ ${benchLabel}`, values: pts.map(p => p.relative), colour: t.text }]
      : [{ key: "portfolio", label: "Portfolio", values: pts.map(p => p.portfolio), colour: t.text, width: 1.8 },
         { key: "benchmark", label: benchLabel, values: pts.map(p => p.benchmark), colour: t.benchmark, dashed: true }];
  const shown = showMarkers ? [
    ...markers.filter(m => m.kind === "peak").map(m => ({ ...m, colour: t.textMuted })),
    ...markers.filter(m => m.kind === "flow").map(m => ({ ...m, colour: t.info })),
    ...(size !== "s" ? unusual.slice(-6).map(u => ({ i: u.i, label: `${u.pct >= 0 ? "+" : "−"}${Math.abs(u.pct).toFixed(1)}% (${Math.abs(u.z).toFixed(1)}σ)`, colour: u.pct >= 0 ? t.positive : t.negative })) : []),
  ] : [];
  const last = pts[pts.length - 1];
  const summary = last ? `Portfolio ${pct(last.portfolio - 100)} and ${benchLabel} ${last.benchmark != null ? pct(last.benchmark - 100) : "no value"} over ${range}, rebased to 100 on ${date(pts[0].date)}. ${d.peak.atPeak ? "At its record high." : `${pct(d.peak.distancePct, { dp: 1 })} from the peak of ${gbpCompact(d.peak.value)} on ${date(d.peak.date)}.`}` : "";
  const rangeDisabled = Object.fromEntries(RANGES.map(x => [x, fillable && fillable[x] !== true ? (fillable[x] || "Not enough history") : false]));
  const recordedDisabled = basisMode === "reconstructed" ? {} : {};
  return (
    <Frame id="performance-chart" index={1} label="Performance" title={<>Growth of the book <em style={{ fontWeight: 400 }}>against</em> {benchLabel}</>}
      right={<>
        <StaleBadge stale={stale} asOf={asOf} />
        <BasisTag basis={basis ?? (basisMode === "recorded" ? "Recorded" : "Reconstructed")} />
      </>}
      footer={<ProvenanceFooter source={source} asOf={asOf} basis={basis} coverage={coverage} method="Portfolio: today's holdings replayed over stored daily closes (or recorded snapshots). Both lines rebased to 100 at the window start and joined on date; a benchmark missing a day is a gap, never shifted." />}>
      <div style={{ display: "flex", gap: 6, flexWrap: "wrap", alignItems: "center", marginBottom: 8 }}>
        <div role="group" aria-label="Benchmark" style={{ display: "flex", gap: 4, flexWrap: "wrap" }}>
          {benchmarks.map(b => <Chip key={b.symbol} active={page.benchmark === b.symbol} onClick={() => page.setBenchmark(b.symbol)} title={b.note}>{b.label}</Chip>)}
        </div>
        <span style={{ flex: 1 }} />
        <Segmented label="Chart view" value={view} onChange={setView} options={[{ value: "return", label: "% return" }, { value: "value", label: "Value" }, { value: "relative", label: "Relative" }]} />
        <Segmented label="Basis" value={basisMode} onChange={setBasisMode} options={[{ value: "reconstructed", label: "Reconstructed" }, { value: "recorded", label: "Recorded" }]} disabled={recordedDisabled} />
      </div>
      <div style={{ display: "flex", gap: 6, alignItems: "center", marginBottom: 6, flexWrap: "wrap" }}>
        <Segmented label="Range" value={range} onChange={v => page.setPeriod(PERIOD_OF_RANGE[v] === "ITD" ? "MAX" : v)} options={RANGES} disabled={rangeDisabled} />
        <label style={{ fontSize: 10.5, color: t.textMuted, display: "flex", gap: 4, alignItems: "center" }}>
          <input type="checkbox" checked={showMarkers} onChange={e => setShowMarkers(e.target.checked)} /> markers
        </label>
        {view === "return" && <span style={{ fontSize: 10, color: t.textFaint, fontFamily: FONT.mono }}><span style={{ color: t.positive }}>▨ ahead</span> · <span style={{ color: t.negative }}>▨ behind</span></span>}
      </div>
      <StateView status={status} reason={reason} onRetry={refetch} height={size === "s" ? 160 : 240}>
        {pts.length > 1 && (
          <>
            <LineChart dates={dates} series={series} band={view === "return" ? { a: "portfolio", b: "benchmark" } : null} markers={shown}
              height={size === "s" ? 180 : size === "l" ? 300 : 250} baseline={view === "value" ? null : 100}
              format={view === "value" ? v => gbpCompact(v) : v => view === "relative" ? v.toFixed(1) : `${(v - 100) >= 0 ? "+" : ""}${(v - 100).toFixed(0)}%`}
              summary={summary} />
            {view === "value" && goal?.goal && (
              <Muted size={10.5}>Goal: {gbp(goal.goal.target)} by {date(goal.goal.targetDate)} — {goal.probabilityPct}% of resampled paths reach it (described sample, not a forecast). Now {goal.progressPct}% of the way.</Muted>
            )}
            {view === "value" && !goal && goalReason && <Muted size={10.5}>No goal overlay: {goalReason}</Muted>}
            {d.benchmark?.missingDays > 0 && view !== "value" && <Muted size={10}>{d.benchmark.symbol} has no close on {d.benchmark.missingDays} of these dates; those days are gaps in its line.</Muted>}
            {size !== "s" && <AltitudeRuler points={pts} />}
          </>
        )}
      </StateView>
      {props.periodStrip !== false && (
        <div style={{ marginTop: 10 }}>
          <PeriodStrip periods={periods} state={periodsState} active={range} onPick={v => page.setPeriod(v)} compact={size === "s"} />
        </div>
      )}
      <SrOnly>{summary}</SrOnly>
    </Frame>
  );
}

export function PeriodReturnsView({ status, data, reason, asOf, source, basis, coverage, stale, size = "m", page, refetch }) {
  const [form, setForm] = useState("strip");
  const range = page.period;
  return (
    <Frame id="period-returns" label="Returns by period" title="Portfolio, benchmark and the gap"
      right={<><StaleBadge stale={stale} asOf={asOf} /><Segmented label="Form" value={form} onChange={setForm} options={[{ value: "strip", label: "Strip" }, { value: "range", label: "Range" }]} /></>}
      footer={<ProvenanceFooter source={source} asOf={asOf} basis={basis} coverage={coverage} method="Each period runs from the last close on or before its start date to the latest close. YTD starts at the last close of the previous year. A period the stored history cannot fill is disabled, not shortened." />}>
      <StateView status={status} reason={reason} onRetry={refetch}>
        {data && (form === "strip"
          ? <PeriodStrip periods={data} active={range} onPick={v => page.setPeriod(v)} compact={size === "s"} />
          : <RangeOfReturns periods={data} />)}
      </StateView>
    </Frame>
  );
}
</file>

<file path="overview/views/TopHoldingsView.jsx">
// OV-04 largest positions. Forms: ranked table, largest-position tiles with a
// target tick, Pareto bars with cumulative weight, risk share beside weight.
import React, { useState } from "react";
import { useT, FONT, signColour, cat } from "../../shared/theme.jsx";
import { Frame, StateView, ProvenanceFooter, Segmented, Muted, StaleBadge, SrOnly } from "../../shared/ui.jsx";
import { Pareto } from "../../shared/charts/bars.jsx";
import { gbp, gbpCompact, pct, price } from "../../shared/format.js";

export function TopHoldingsView({ status, data: d, reason, asOf, source, basis, coverage, stale, textAlt, size = "m", props = {}, page, refetch }) {
  const t = useT();
  const [form, setForm] = useState("table");
  const [n, setN] = useState(props.n ?? 8);
  const rows = (d?.rows ?? []).slice(0, n);
  const maxW = Math.max(1, ...rows.map(r => Math.max(r.weight, r.targetPct ?? 0, r.riskSharePct ?? 0)));
  return (
    <Frame id="top-holdings" index={5} label="Largest positions" title="Top of the book"
      right={<><StaleBadge stale={stale} asOf={asOf} />
        <Segmented label="How many" value={n} onChange={setN} options={[5, 8, 12].map(v => ({ value: v, label: String(v) }))} />
        <Segmented label="Form" value={form} onChange={setForm} options={[{ value: "table", label: "Table" }, { value: "tiles", label: "Tiles" }, { value: "pareto", label: "Pareto" }]} />
        <button onClick={() => page?.onNavigate?.("holdings")} style={{ background: "transparent", border: "none", color: t.info, cursor: "pointer", fontSize: 11 }}>All {d?.total ?? ""} holdings →</button></>}
      footer={<ProvenanceFooter source={source} asOf={asOf} basis={basis} coverage={coverage} method="Ranked by live value, cash excluded. Risk share is each holding's Euler contribution to portfolio variance over stored daily returns; it sums to 100% across holdings." />}>
      <StateView status={status} reason={reason} onRetry={refetch} height={220}>
        {d && form === "table" && (
          <div role="table" aria-label={textAlt}>
            <div role="row" style={{ display: "grid", gridTemplateColumns: size === "s" ? "1.6fr 1fr 1fr" : "1.8fr 1.1fr 0.9fr 0.8fr 0.9fr 1fr", gap: 6, fontFamily: FONT.mono, fontSize: 9.5, letterSpacing: 1, color: t.textMuted, borderBottom: `1px solid ${t.borderStrong}`, padding: "4px 0" }}>
              <span role="columnheader">POSITION</span><span role="columnheader">WEIGHT</span>
              {size !== "s" && <><span role="columnheader" style={{ textAlign: "right" }}>VALUE</span><span role="columnheader" style={{ textAlign: "right" }}>TODAY</span><span role="columnheader" style={{ textAlign: "right" }}>TOTAL GAIN</span></>}
              <span role="columnheader" style={{ textAlign: "right" }}>RISK SHARE</span>
            </div>
            {rows.map((r, i) => (
              <button key={r.symbol} role="row" onClick={() => page?.onOpenHolding?.(r.symbol)} onMouseEnter={() => page?.setSelected?.(r.symbol)} onMouseLeave={() => page?.setSelected?.(null)}
                style={{ display: "grid", gridTemplateColumns: size === "s" ? "1.6fr 1fr 1fr" : "1.8fr 1.1fr 0.9fr 0.8fr 0.9fr 1fr", gap: 6, alignItems: "center", width: "100%", border: "none", borderBottom: `1px solid ${t.borderSubtle}`, padding: "6px 0", background: page?.selected === r.symbol ? t.surfaceInset : "transparent", cursor: "pointer", textAlign: "left", color: "inherit" }}>
                <span role="cell" style={{ minWidth: 0 }}>
                  <span style={{ fontFamily: FONT.mono, fontSize: 9.5, color: t.textFaint, marginRight: 6 }}>{String(i + 1).padStart(2, "0")}</span>
                  <span style={{ fontFamily: FONT.mono, fontSize: 11.5, fontWeight: 700, color: t.text }}>{r.symbol}</span>
                  <div style={{ fontSize: 10, color: t.textFaint, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap", paddingLeft: 22 }}>{r.name}</div>
                </span>
                <span role="cell" style={{ display: "flex", alignItems: "center", gap: 6 }}>
                  <span style={{ position: "relative", flex: 1, height: 4, background: t.surfaceInset, borderRadius: 2 }}>
                    <span style={{ position: "absolute", inset: 0, width: `${r.weight / maxW * 100}%`, background: t.text, borderRadius: 2 }} />
                    {r.targetPct != null && <span title={`Target ${r.targetPct}%`} style={{ position: "absolute", left: `${r.targetPct / maxW * 100}%`, top: -3, width: 2, height: 10, background: t.warning }} />}
                  </span>
                  <span style={{ fontFamily: FONT.mono, fontSize: 11 }}>{r.weight.toFixed(1)}%</span>
                </span>
                {size !== "s" && <>
                  <span role="cell" style={{ fontFamily: FONT.mono, fontSize: 11, textAlign: "right" }}>{gbp(r.value)}<div style={{ fontSize: 9.5, color: t.textFaint }}>{price(r.price, r.currency)}</div></span>
                  <span role="cell" style={{ fontFamily: FONT.mono, fontSize: 11, textAlign: "right", color: signColour(t, r.dayPct) }}>{pct(r.dayPct)}</span>
                  <span role="cell" style={{ fontFamily: FONT.mono, fontSize: 11, textAlign: "right", color: signColour(t, r.pnl) }}>{pct(r.pnlPct, { dp: 0 })}<div style={{ fontSize: 9.5 }}>{gbpCompact(r.pnl, { sign: true })}</div></span>
                </>}
                <span role="cell" style={{ display: "flex", alignItems: "center", gap: 5, justifyContent: "flex-end" }}>
                  {r.riskSharePct != null ? <>
                    <span style={{ width: Math.max(2, r.riskSharePct / maxW * 50), height: 3, background: r.riskSharePct > r.weight * 1.2 ? t.warning : cat(t, 0), borderRadius: 2 }} />
                    <span style={{ fontFamily: FONT.mono, fontSize: 11 }}>{r.riskSharePct.toFixed(1)}%</span></> : <span title={d.riskReason} style={{ color: t.textFaint, fontFamily: FONT.mono }}>——</span>}
                </span>
              </button>
            ))}
            <div role="row" style={{ display: "grid", gridTemplateColumns: size === "s" ? "1.6fr 1fr 1fr" : "1.8fr 1.1fr 0.9fr 0.8fr 0.9fr 1fr", gap: 6, padding: "6px 0", borderTop: `1px solid ${t.borderStrong}`, fontFamily: FONT.mono, fontSize: 11, fontWeight: 700 }}>
              <span>Top {rows.length} of {d.total}</span><span>{rows.reduce((a, r) => a + r.weight, 0).toFixed(1)}%</span>
              {size !== "s" && <><span style={{ textAlign: "right" }}>{gbp(rows.reduce((a, r) => a + r.value, 0))}</span><span style={{ textAlign: "right", color: signColour(t, rows.reduce((a, r) => a + (r.dayGBP ?? 0), 0)) }}>{gbpCompact(rows.reduce((a, r) => a + (r.dayGBP ?? 0), 0), { sign: true })}</span><span style={{ textAlign: "right" }}>{gbpCompact(rows.reduce((a, r) => a + (r.pnl ?? 0), 0), { sign: true })}</span></>}
              <span style={{ textAlign: "right" }}>{rows.every(r => r.riskSharePct != null) ? `${rows.reduce((a, r) => a + r.riskSharePct, 0).toFixed(1)}%` : "——"}</span>
            </div>
          </div>
        )}
        {d && form === "tiles" && (
          <div style={{ display: "grid", gridTemplateColumns: `repeat(${size === "s" ? 2 : 4}, minmax(0,1fr))`, gap: 8 }}>
            {rows.map(r => (
              <button key={r.symbol} onClick={() => page?.onOpenHolding?.(r.symbol)} style={{ textAlign: "left", background: t.surfaceInset, border: `1px solid ${t.border}`, borderRadius: 6, padding: 8, cursor: "pointer", color: "inherit" }}>
                <div style={{ fontFamily: FONT.mono, fontSize: 11.5, fontWeight: 700, color: t.text }}>{r.symbol}</div>
                <div style={{ fontFamily: FONT.mono, fontSize: 17, color: t.text }}>{r.weight.toFixed(1)}%</div>
                <div style={{ position: "relative", height: 5, background: t.surface, borderRadius: 3, margin: "4px 0" }}>
                  <div style={{ position: "absolute", inset: 0, width: `${Math.min(100, r.weight / maxW * 100)}%`, background: t.text, borderRadius: 3 }} />
                  {r.targetPct != null && <div title={`Target ${r.targetPct}%`} style={{ position: "absolute", left: `${Math.min(100, r.targetPct / maxW * 100)}%`, top: -3, width: 2, height: 11, background: t.warning }} />}
                </div>
                <div style={{ fontSize: 10, color: t.textFaint }}>{r.targetPct != null ? `target ${r.targetPct}%` : "no target set"}</div>
              </button>
            ))}
          </div>
        )}
        {d && form === "pareto" && (
          <Pareto summary={textAlt} rows={rows.map(r => ({ label: r.symbol, weightPct: r.weight, cumulativePct: r.cumulative }))} height={size === "s" ? 150 : 190} />
        )}
        {d?.riskReason && <Muted size={10} style={{ marginTop: 4 }}>Risk share unavailable: {d.riskReason}</Muted>}
        <SrOnly>{textAlt}</SrOnly>
      </StateView>
    </Frame>
  );
}
