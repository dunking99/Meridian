  const up = (data?.changePct ?? 0) >= 0;
  return (
    <div style={{
      background: "linear-gradient(180deg,#0f141d,#0b0f16)", border: "1px solid #1a2535",
      borderRadius: 8, padding: "12px 18px", display: "flex", alignItems: "center",
