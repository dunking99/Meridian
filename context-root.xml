const grid = (min = 210, max = 420) => ({
  display: "grid",
  gridTemplateColumns: `repeat(auto-fit, minmax(${min}px, 1fr))`,
  maxWidth: `calc(${max}px * 6)`,
  gap: 10,
  alignItems: "start",
});

