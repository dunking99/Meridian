// Views for concentration, cash, watchlist, accounts and the goal.
import React, { useState } from "react";
import { useT, FONT, soft, signColour, cat, hatch } from "../../shared/theme.jsx";
import { Frame, StateView, ProvenanceFooter, Segmented, Muted, StaleBadge, Chip, SrOnly, Stat, Placeholder, NoData } from "../../shared/ui.jsx";
import { Pareto, Lorenz, Ribbon } from "../../shared/charts/bars.jsx";
import { FanChart } from "../../shared/charts/shapes.jsx";
import { Sparkline } from "../../shared/charts/line.jsx";
import { gbp, gbpCompact, pct, num, price, date, age } from "../../shared/format.js";

// ─── OV-14 / AN-02 concentration ──────────────────────────────

export function ConcentrationView({ status, data: d, reason, asOf, source, basis, coverage, stale, textAlt, size = "m", props = {}, page, refetch }) {
  const t = useT();
  const full = props.full === true;
  const [form, setForm] = useState(full ? "bands" : "tiles");
  const breaches = d?.breaches ?? [];
  const forms = full ? [{ value: "bands", label: "Bands" }, { value: "lorenz", label: "Lorenz" }, { value: "pareto", label: "Pareto" }, { value: "tiles", label: "Tiles" }] : [{ value: "tiles", label: "Tiles" }, { value: "pareto", label: "Pareto" }];
  return (
    <Frame id={full ? "concentration-full" : "concentration"} label="Concentration" title={full ? "How top-heavy is it?" : "Concentration snapshot"}
      right={<><StaleBadge stale={stale} asOf={asOf} /><Segmented label="Concentration form" value={form} onChange={setForm} options={forms} /></>}
      footer={<ProvenanceFooter source={source} asOf={asOf} basis={basis} coverage={coverage} method="Largest / top-N are shares of the whole book; HHI is the sum of squared weights; effective holdings is 1 / HHI over invested value. Caps come from the saved mandate; a banner appears only when one is exceeded." />}>
      <StateView status={status} reason={reason} onRetry={refetch} height={140}>
        {d && (
          <>
            {breaches.length > 0 && (
              <div role="alert" style={{ background: t.warningSoft, border: `1px solid ${soft(t.warning, 50)}`, borderRadius: 5, padding: "6px 9px", marginBottom: 8, fontSize: 11.5, color: t.warning }}>
                ⚠ {breaches.map(b => b.kind === "position" ? `${b.symbol} is ${b.actualPct}% (cap ${b.capPct}%)` : b.kind === "sector" ? `${b.label} sector ${b.actualPct}% (cap ${b.capPct}%)` : `${b.actual} holdings (cap ${b.cap})`).join(" · ")}
                <div style={{ fontSize: 10, color: t.textMuted }}>Caps from {d.caps?.source}. Not advice — a comparison against limits you set.</div>
              </div>
            )}
            {form === "tiles" && (
              <div style={{ display: "grid", gridTemplateColumns: `repeat(${size === "s" ? 2 : 4}, minmax(0,1fr))` }}>
                <Stat size="s" label="Largest" value={`${d.largest.pct}%`} sub={d.largest.symbol} />
                <Stat size="s" label="Top 3" value={`${d.top3}%`} sub={`top 5 ${d.top5}%`} />
                <Stat size="s" label="HHI" value={num(d.hhi, { dp: 3 })} sub="sum of squared weights" />
                <Stat size="s" label="Effective" value={num(d.effectiveHoldings, { dp: 1 })} sub={`of ${d.positionCount} holdings`} />
              </div>
            )}
            {form === "bands" && (
              <div role="list" aria-label={textAlt}>
                {[["Top 1", d.top1, d.caps?.maxPositionPct], ["Top 3", d.top3, null], ["Top 5", d.top5, null], ["Top 10", d.top10, null]].map(([l, v, cap]) => (
                  <div role="listitem" key={l} style={{ display: "grid", gridTemplateColumns: "60px 1fr 56px", gap: 8, alignItems: "center", padding: "4px 0" }}>
                    <span style={{ fontSize: 11.5, color: t.textSecondary }}>{l}</span>
                    <span style={{ position: "relative", height: 10, background: t.surfaceInset }}>
                      <span style={{ position: "absolute", inset: 0, width: `${Math.min(100, v)}%`, background: t.text }} />
                      {cap != null && <span title={`Mandate cap ${cap}%`} style={{ position: "absolute", left: `${cap}%`, top: -3, width: 2, height: 16, background: t.warning }} />}
                    </span>
                    <span style={{ fontFamily: FONT.mono, fontSize: 11.5, textAlign: "right" }}>{v}%</span>
                  </div>
                ))}
                <Muted size={10}>Tick = your mandate's single-position cap ({d.caps?.maxPositionPct ?? "—"}%). Effective holdings {num(d.effectiveHoldings, { dp: 1 })} of {d.positionCount}; largest sector {d.largestSector?.label} {d.largestSector?.pct}%.</Muted>
              </div>
            )}
            {form === "lorenz" && (
              <div style={{ display: "flex", gap: 14, alignItems: "center", flexWrap: "wrap" }}>
                <Lorenz points={d.lorenz} gini={d.gini} size={size === "s" ? 150 : 180} summary={`Lorenz curve of holding weights, Gini ${d.gini}`} />
                <div style={{ fontSize: 11, color: t.textSecondary, lineHeight: 1.6, maxWidth: 240 }}>The further the curve bows below the diagonal, the more of the book sits in a few holdings. Gini {num(d.gini, { dp: 2 })}; HHI {num(d.hhi, { dp: 3 })}.</div>
              </div>
            )}
            {form === "pareto" && <Pareto rows={d.pareto} summary={textAlt} height={size === "s" ? 140 : 180} caps={d.caps ? [{ label: `cap ${d.caps.maxPositionPct}%`, value: d.caps.maxPositionPct }] : []} />}
            {!breaches.length && d.caps && <Muted size={10} style={{ marginTop: 4 }}>No mandate cap is exceeded.</Muted>}
            {!props.full && <button onClick={() => page?.onNavigate?.("analysis")} style={{ background: "transparent", border: "none", color: t.info, cursor: "pointer", fontSize: 11, padding: 0, marginTop: 6 }}>Concentration in Analysis →</button>}
            <SrOnly>{textAlt}</SrOnly>
          </>
        )}
      </StateView>
    </Frame>
  );
}

// ─── OV-09 / HD-02 / AN-19 cash ───────────────────────────────

export function CashView({ status, data: d, reason, asOf, source, basis, coverage, stale, composition, textAlt, save, saving, size = "m", props = {}, page, refetch }) {
  const t = useT();
  const [form, setForm] = useState(props.form ?? "tile");
  const [edit, setEdit] = useState(null);
  const [amt, setAmt] = useState("");
  const forms = [{ value: "tile", label: "Accounts" }, { value: "combined", label: "+Book" }, { value: "meter", label: "Meter" }, { value: "currency", label: "Currency" }];
  return (
    <Frame id="cash" label="Cash & liquidity" title="Cash"
      right={<><StaleBadge stale={stale} asOf={asOf} /><Segmented label="Cash form" value={form} onChange={setForm} options={forms} /></>}
      footer={<ProvenanceFooter source={source} asOf={asOf} basis={basis} coverage={coverage} note={d?.oldestEditDays > 30 ? `A balance was last edited ${d.oldestEditDays} days ago.` : null} />}>
      <StateView status={status} reason={reason} onRetry={refetch} height={120}>
        {d && (
          <>
            <div style={{ display: "flex", alignItems: "baseline", gap: 10, flexWrap: "wrap" }}>
              <span style={{ fontFamily: FONT.serif, fontSize: 26, color: t.text }}>{gbp(d.total)}</span>
              <span style={{ fontFamily: FONT.mono, fontSize: 11, color: t.textMuted }}>{pct(d.shareOfBookPct, { dp: 1, sign: false })} of the book</span>
              <button onClick={() => page?.onNavigate?.("allocate")} style={{ marginLeft: "auto", background: "transparent", border: `1px solid ${t.accent}`, color: t.accent, borderRadius: 3, fontSize: 10.5, padding: "3px 9px", cursor: "pointer", fontFamily: FONT.mono }}>Deploy → Allocate</button>
            </div>
            {form === "tile" && (
              <div role="list" style={{ marginTop: 8 }}>
                {d.rows.map(r => (
                  <div role="listitem" key={r.id} style={{ display: "grid", gridTemplateColumns: "1fr auto auto", gap: 8, alignItems: "center", padding: "4px 0", borderBottom: `1px solid ${t.borderSubtle}` }}>
                    <span style={{ fontSize: 11.5, color: t.textSecondary }}>{r.account} · {r.wrapper} <span style={{ color: t.textFaint, fontSize: 10 }}>edited {age(r.updatedAt)}</span></span>
                    {edit === r.id ? (
                      <span style={{ display: "flex", gap: 4 }}>
                        <input aria-label={`New ${r.currency} balance`} autoFocus value={amt} onChange={e => setAmt(e.target.value)} onKeyDown={e => { if (e.key === "Enter") { save(r.id, amt); setEdit(null); } if (e.key === "Escape") setEdit(null); }}
                          style={{ width: 90, background: t.surfaceInset, color: t.text, border: `1px solid ${t.border}`, borderRadius: 3, fontFamily: FONT.mono, fontSize: 11, padding: "2px 5px" }} />
                        <button onClick={() => { save(r.id, amt); setEdit(null); }} disabled={saving} style={{ background: "transparent", border: `1px solid ${t.accent}`, color: t.accent, borderRadius: 3, fontSize: 10, cursor: "pointer" }}>Save</button>
                      </span>
                    ) : (
                      <span style={{ fontFamily: FONT.mono, fontSize: 11.5, color: t.text }}>{r.currency === "GBP" ? gbp(r.amount, { dp: 2 }) : `${num(r.amount, { dp: 2 })} ${r.currency}`}
                        {r.currency !== "GBP" && <span style={{ fontSize: 10, color: r.fxStale || r.fxMissing ? t.warning : t.textFaint }}> = {r.gbp != null ? gbp(r.gbp) : "no FX rate"}{r.fxStale ? " (FX stale)" : ""}</span>}
                      </span>
                    )}
                    {edit !== r.id && <button onClick={() => { setEdit(r.id); setAmt(String(r.amount)); }} aria-label={`Edit ${r.account} balance`} style={{ background: "transparent", border: "none", color: t.textMuted, cursor: "pointer" }}>✎</button>}
                  </div>
                ))}
              </div>
            )}
            {form === "combined" && composition && (
              <div style={{ marginTop: 8 }}>
                <Ribbon summary={`Cash against the rest of the book`} segments={composition.groups.map((g, i) => ({ key: g.label, label: g.label, value: g.weight, colour: g.label === "Cash" ? t.text : cat(t, i + 1) }))} />
              </div>
            )}
            {form === "meter" && (
              <div role="img" aria-label={`Cash ${d.shareOfBookPct}% of the book${d.buffer ? ` against a ${d.buffer.pct}% mandate buffer` : ""}`} style={{ marginTop: 10 }}>
                <div style={{ position: "relative", height: 14, background: t.surfaceInset, borderRadius: 7 }}>
                  <div style={{ position: "absolute", inset: 0, width: `${Math.min(100, d.shareOfBookPct * 4)}%`, background: t.info, borderRadius: 7 }} />
                  {d.buffer && <div title={`Buffer ${d.buffer.pct}%`} style={{ position: "absolute", left: `${Math.min(100, d.buffer.pct * 4)}%`, top: -4, width: 2, height: 22, background: t.warning }} />}
                </div>
                <div style={{ display: "flex", justifyContent: "space-between", fontSize: 9.5, color: t.textFaint, fontFamily: FONT.mono, marginTop: 2 }}><span>0%</span><span>scale to 25% of the book</span><span>25%</span></div>
                {d.buffer ? <Muted size={10.5}>Mandate buffer {d.buffer.pct}% = {gbp(d.buffer.gbp)}; deployable above it {gbp(d.buffer.deployable)}{d.buffer.shortfall > 0 ? `; short of the buffer by ${gbp(d.buffer.shortfall)}` : ""}.</Muted> : <Muted>No mandate buffer set.</Muted>}
              </div>
            )}
            {form === "currency" && (
              <div role="list" style={{ marginTop: 8 }}>
                {d.byCurrency.map(c => <div role="listitem" key={c.label} style={{ display: "flex", justifyContent: "space-between", fontSize: 11.5, padding: "2px 0" }}><span>{c.label}</span><span style={{ fontFamily: FONT.mono }}>{gbp(c.gbp)} · {pct(c.pct, { dp: 1, sign: false })}</span></div>)}
                {d.fxMissing?.length > 0 && <Muted size={10}>No FX rate for {d.fxMissing.join(", ")} — counted as nothing until a quote arrives.</Muted>}
              </div>
            )}
            <SrOnly>{textAlt}</SrOnly>
          </>
        )}
      </StateView>
    </Frame>
  );
}

// ─── OV-21 watchlist strip ────────────────────────────────────

export function WatchlistView({ status, data: d, reason, asOf, source, basis, coverage, stale, textAlt, add, alert, msg, size = "m", page, refetch }) {
  const t = useT();
  const [sym, setSym] = useState("");
  const [alertFor, setAlertFor] = useState(null);
  const [th, setTh] = useState("");
  const [dir, setDir] = useState("below");
  const tiers = { 1: "Tier 1", 2: "Tier 2", 3: "Tier 3" };
  const rows = d?.rows ?? [];
  return (
    <Frame id="watchlist" label="Watchlist" title="Not owned, watched"
      right={<StaleBadge stale={stale} asOf={asOf} />}
      footer={<ProvenanceFooter source={source} asOf={asOf} basis={basis} coverage={coverage} note="Alerts are delivered in-app only." />}>
      <form onSubmit={e => { e.preventDefault(); add(sym); setSym(""); }} style={{ display: "flex", gap: 4, marginBottom: 6 }}>
        <input aria-label="Add a symbol to the watchlist" value={sym} onChange={e => setSym(e.target.value)} placeholder="Add symbol…"
          style={{ flex: 1, background: t.surfaceInset, color: t.text, border: `1px solid ${t.border}`, borderRadius: 3, fontFamily: FONT.mono, fontSize: 11, padding: "3px 6px" }} />
        <button type="submit" style={{ background: "transparent", border: `1px solid ${t.borderStrong}`, color: t.textSecondary, borderRadius: 3, fontSize: 10.5, cursor: "pointer" }}>+ Add</button>
      </form>
      {msg && <div role="status" style={{ fontSize: 10.5, color: t.textMuted, marginBottom: 4 }}>{msg}</div>}
      <StateView status={status} reason={reason} onRetry={refetch} height={100}>
        {rows.length > 0 && (
          <div role="list">
            {[1, 2, 3].map(tier => rows.some(r => r.tier === tier) && (
              <div key={tier}>
                <div style={{ fontFamily: FONT.mono, fontSize: 9, letterSpacing: 1.2, color: t.textFaint, marginTop: 4 }}>{tiers[tier].toUpperCase()}</div>
                {rows.filter(r => r.tier === tier).map(r => (
                  <div role="listitem" key={r.id} style={{ borderBottom: `1px solid ${t.borderSubtle}` }}>
                    <div style={{ display: "grid", gridTemplateColumns: "72px 1fr 64px 60px 22px", gap: 6, alignItems: "center", padding: "4px 0" }}>
                      <button onClick={() => page?.onNavigate?.("research", { symbol: r.symbol })} title="Open in Research" style={{ background: "transparent", border: "none", padding: 0, textAlign: "left", fontFamily: FONT.mono, fontSize: 11.5, fontWeight: 700, color: t.text, cursor: "pointer" }}>{r.symbol}</button>
                      <Sparkline values={r.spark} width={70} height={16} />
                      <span style={{ fontFamily: FONT.mono, fontSize: 11, textAlign: "right" }}>{r.price == null ? <NoData reason={r.priceReason} /> : price(r.price, r.currency)}</span>
                      <span style={{ fontFamily: FONT.mono, fontSize: 11, textAlign: "right", color: signColour(t, r.dayPct) }}>{r.dayPct == null ? "——" : pct(r.dayPct)}</span>
                      <button onClick={() => setAlertFor(a => a === r.symbol ? null : r.symbol)} aria-label={`Set a price alert on ${r.symbol}`} title={r.activeAlerts ? `${r.activeAlerts} alert(s) armed` : "Quick alert"} style={{ background: "transparent", border: "none", cursor: "pointer", color: r.activeAlerts ? t.warning : t.textFaint }}>🔔</button>
                    </div>
                    {r.target != null && <div style={{ fontSize: 9.5, color: t.textFaint, marginBottom: 3 }}>your target {price(r.target, r.currency)}{r.toTargetPct != null ? ` · ${pct(r.toTargetPct, { dp: 1 })} away` : ""}</div>}
                    {alertFor === r.symbol && (
                      <form onSubmit={e => { e.preventDefault(); alert(r.symbol, dir, th); setAlertFor(null); setTh(""); }} style={{ display: "flex", gap: 4, margin: "0 0 5px" }}>
                        <select aria-label="Direction" value={dir} onChange={e => setDir(e.target.value)} style={{ background: t.surfaceInset, color: t.text, border: `1px solid ${t.border}`, fontSize: 10.5 }}><option value="below">falls below</option><option value="above">rises above</option></select>
                        <input aria-label="Alert price" value={th} onChange={e => setTh(e.target.value)} placeholder="price" style={{ width: 70, background: t.surfaceInset, color: t.text, border: `1px solid ${t.border}`, fontFamily: FONT.mono, fontSize: 10.5 }} />
                        <button type="submit" style={{ background: "transparent", border: `1px solid ${t.accent}`, color: t.accent, fontSize: 10, cursor: "pointer" }}>Arm</button>
                      </form>
                    )}
                  </div>
                ))}
              </div>
            ))}
          </div>
        )}
        <SrOnly>{textAlt}</SrOnly>
      </StateView>
    </Frame>
  );
}

// ─── OV-22 accounts ───────────────────────────────────────────

export function AccountsView({ status, data: d, reason, asOf, source, basis, coverage, stale, note, textAlt, size = "m", page, refetch }) {
  const t = useT();
  const [form, setForm] = useState("cards");
  return (
    <Frame id="accounts" label="Accounts" title="Where it is held"
      right={<><StaleBadge stale={stale} asOf={asOf} /><Segmented label="Accounts form" value={form} onChange={setForm} options={[{ value: "cards", label: "Cards" }, { value: "split", label: "Wrappers" }, { value: "allowance", label: "ISA" }]} /></>}
      footer={<ProvenanceFooter source={source} asOf={asOf} basis={basis} coverage={coverage} note={note} />}>
      <StateView status={status} reason={reason} onRetry={refetch} height={120}>
        {d && (
          <>
            {form === "cards" && (
              <div style={{ display: "grid", gridTemplateColumns: `repeat(${size === "s" ? 1 : 2}, minmax(0,1fr))`, gap: 6 }}>
                {d.rows.map(r => (
                  <button key={`${r.account}|${r.wrapper}`} onClick={() => page?.onNavigate?.("holdings", { query: { account: r.account } })} title="Show this account's holdings"
                    style={{ textAlign: "left", background: t.surfaceInset, border: `1px solid ${t.border}`, borderRadius: 6, padding: 8, cursor: "pointer", color: "inherit" }}>
                    <div style={{ fontFamily: FONT.mono, fontSize: 9.5, color: t.textFaint }}>{r.wrapperLabel}</div>
                    <div style={{ fontSize: 12, color: t.text }}>{r.account}</div>
                    <div style={{ fontFamily: FONT.mono, fontSize: 15, color: t.text }}>{gbpCompact(r.total)}</div>
                    <div style={{ fontSize: 10, color: t.textFaint }}>{r.holdings} holding{r.holdings === 1 ? "" : "s"} · cash {gbpCompact(r.cash)} · {pct(r.pct, { dp: 1, sign: false })}</div>
                  </button>
                ))}
              </div>
            )}
            {form === "split" && <Ribbon summary={textAlt} segments={d.byWrapper.map((w, i) => ({ key: w.wrapper, label: w.label, value: (w.pct ?? 0) / 100, colour: cat(t, i) }))} />}
            {form === "allowance" && (
              <Placeholder title={`ISA allowance · ${d.allowance.taxYear}`} reason={`${d.allowance.reason} The limit for ${d.allowance.taxYear} is £${d.allowance.isaLimit.toLocaleString("en-GB")}.`} unblocks="contributions are recorded per wrapper" height={90} />
            )}
            <SrOnly>{textAlt}</SrOnly>
          </>
        )}
      </StateView>
    </Frame>
  );
}

// ─── OV-23 goal ───────────────────────────────────────────────

export function GoalView({ status, data: d, reason, asOf, source, basis, coverage, stale, note, textAlt, saveGoal, clear, errors, size = "m", refetch }) {
  const t = useT();
  const [editing, setEditing] = useState(false);
  const [form, setForm] = useState({ target: "", targetDate: "", monthly: "" });
  const [view, setView] = useState("progress");
  const noGoal = status === "refused" && /No goal/.test(reason ?? "");
  const editor = (
    <form onSubmit={e => { e.preventDefault(); saveGoal(form); setEditing(false); }} style={{ display: "flex", gap: 6, flexWrap: "wrap", alignItems: "flex-end", marginTop: 8 }}>
      {[["target", "Target £", "number"], ["targetDate", "By", "date"], ["monthly", "Monthly £", "number"]].map(([k, l, type]) => (
        <label key={k} style={{ display: "flex", flexDirection: "column", fontSize: 9.5, color: t.textFaint, fontFamily: FONT.mono, gap: 2 }}>{l}
          <input required type={type} value={form[k]} onChange={e => setForm(f => ({ ...f, [k]: e.target.value }))} style={{ background: t.surfaceInset, color: t.text, border: `1px solid ${t.border}`, borderRadius: 3, fontFamily: FONT.mono, fontSize: 11.5, padding: "3px 6px", width: k === "targetDate" ? 140 : 100 }} />
        </label>
      ))}
      <button type="submit" style={{ background: "transparent", border: `1px solid ${t.accent}`, color: t.accent, borderRadius: 3, fontSize: 11, padding: "4px 10px", cursor: "pointer" }}>Save goal</button>
      <Muted size={10}>All three are required; nothing is assumed. Enter 0 if you add nothing monthly.</Muted>
    </form>
  );
  return (
    <Frame id="goal" label="Goal" title="Target progress"
      right={<>{d && <Segmented label="Goal view" value={view} onChange={setView} options={[{ value: "progress", label: "Progress" }, { value: "fan", label: "Glide path" }]} />}
        {d && <button onClick={() => { setEditing(e => !e); setForm({ target: d.goal.target, targetDate: d.goal.targetDate, monthly: d.goal.monthly }); }} style={{ background: "transparent", border: "none", color: t.info, cursor: "pointer", fontSize: 11 }}>Edit</button>}</>}
      footer={<ProvenanceFooter source={source} asOf={asOf} basis={basis} coverage={coverage} note={note} method={d?.method} />}>
      {errors && <div role="alert" style={{ fontSize: 11, color: t.negative }}>{errors.join(" ")}</div>}
      {noGoal ? (
        <div>
          <div style={{ fontSize: 12.5, color: t.textSecondary }}>No goal set. Set a target and date to see progress.</div>
          {editor}
        </div>
      ) : (
        <StateView status={status} reason={reason} onRetry={refetch} height={120}>
          {d && (
            <>
              {editing && editor}
              <div style={{ display: "flex", gap: 14, alignItems: "baseline", flexWrap: "wrap" }}>
                <span style={{ fontFamily: FONT.serif, fontSize: 22, color: t.text }}>{gbpCompact(d.initial)} of {gbpCompact(d.goal.target)}</span>
                <span style={{ fontFamily: FONT.mono, fontSize: 11, color: t.textMuted }}>by {date(d.goal.targetDate)} · {num(d.years, { dp: 1 })} years · £{d.goal.monthly}/month</span>
              </div>
              {view === "progress" && (
                <>
                  <div role="img" aria-label={`${d.progressPct}% of the target reached`} style={{ position: "relative", height: 12, background: t.surfaceInset, borderRadius: 6, margin: "8px 0" }}>
                    <div style={{ position: "absolute", inset: 0, width: `${Math.min(100, d.progressPct)}%`, background: t.info, borderRadius: 6 }} />
                  </div>
                  <div style={{ display: "grid", gridTemplateColumns: "repeat(3, minmax(0,1fr))" }}>
                    <Stat size="s" label="Reach it in" value={`${d.probabilityPct}%`} sub={`of ${d.pathsSimulated.toLocaleString("en-GB")} resampled paths`} />
                    <Stat size="s" label="Median outcome" value={gbpCompact(d.median)} sub={d.medianShortfall ? `short by ${gbpCompact(d.medianShortfall)}` : `ahead by ${gbpCompact(d.medianSurplus)}`} />
                    <Stat size="s" label="Monthly for 50%" value={gbp(d.requiredMonthlyForFiftyPct)} sub="solved on the same history" />
                  </div>
                </>
              )}
              {view === "fan" && <FanChart bands={d.bands} goal={d.goal.target} height={size === "s" ? 170 : 210} summary={textAlt} />}
              <Muted size={10}>A described sample of this book's own past (annualised {pct(d.historyAnnualisedPct, { dp: 1 })}, volatility {pct(d.historyVolPct, { dp: 1, sign: false })}), not a forecast. <button onClick={clear} style={{ background: "transparent", border: "none", color: t.textFaint, cursor: "pointer", fontSize: 10, textDecoration: "underline" }}>Remove goal</button></Muted>
              <SrOnly>{textAlt}</SrOnly>
            </>
          )}
        </StateView>
      )}
    </Frame>
  );
}
</file>

<file path="src/overview/views/BriefingDigestView.jsx">
// OV-13 signals / briefing digest. Forms: ranked insight cards with a
// materiality dot, the session verdict pulse, new-since-read badges, and an
// exposure-ranked list. "Nothing notable" is a first-class state; no
// confidence rating appears anywhere.
import React, { useState } from "react";
import { useT, FONT, soft } from "../../shared/theme.jsx";
import { Frame, StateView, ProvenanceFooter, Segmented, Muted, StaleBadge, SrOnly } from "../../shared/ui.jsx";
import { age } from "../../shared/format.js";

const TONE = t => ({ quiet: [t.textMuted, "Quiet"], mild: [t.info, "Minor"], isolated: [t.warning, "Notable"], broad: [t.warning, "Busy"], action: [t.negative, "Action"] });

export function BriefingDigestView({ status, data: d, reason, asOf, source, basis, coverage, stale, textAlt, markRead, snooze, size = "m", page, refetch }) {
  const t = useT();
  const [form, setForm] = useState("cards");
  const [c, label] = TONE(t)[d?.verdict?.tone] ?? [t.textMuted, "—"];
  const items = d?.items ?? [];
  return (
    <Frame id="briefing-digest" label="Briefing" title="What needs your attention"
      right={<><StaleBadge stale={stale} asOf={asOf} /><Segmented label="Briefing form" value={form} onChange={setForm} options={[{ value: "cards", label: "Cards" }, { value: "pulse", label: "Pulse" }, { value: "ranked", label: "By exposure" }]} />
        <button onClick={() => page?.onNavigate?.("briefing")} style={{ background: "transparent", border: "none", color: t.info, cursor: "pointer", fontSize: 11 }}>Full briefing →</button></>}
      footer={<ProvenanceFooter source={source} asOf={asOf} basis={basis} coverage={coverage} method="Findings from eight engines scored as 100 × strength × stake × kind weight; 'new' means not in the last briefing you marked as read." />}>
      <StateView status={status} reason={reason} onRetry={refetch} height={100}>
        {d && (
          <>
            <div style={{ display: "flex", alignItems: "center", gap: 10, flexWrap: "wrap" }}>
              <span role="status" style={{ display: "inline-flex", alignItems: "center", gap: 6, fontFamily: FONT.mono, fontSize: 10, letterSpacing: 1.2, color: c }}>
                <span aria-hidden style={{ width: 9, height: 9, borderRadius: "50%", background: c, boxShadow: d.verdict?.tone === "quiet" ? "none" : `0 0 0 3px ${soft(c, 25)}` }} />{label.toUpperCase()}
              </span>
              <span style={{ fontFamily: FONT.serif, fontSize: size === "s" ? 14 : 17, color: t.text, flex: 1, minWidth: 200 }}>{d.verdict?.text}</span>
              {d.counts?.new > 0 && <span style={{ fontFamily: FONT.mono, fontSize: 10, padding: "2px 7px", borderRadius: 10, background: t.infoSoft, color: t.info }}>{d.counts.new} new</span>}
              <button onClick={markRead} disabled={!d.counts?.new} title="Mark every finding shown here as read"
                style={{ background: "transparent", border: `1px solid ${t.border}`, color: d.counts?.new ? t.textSecondary : t.textFaint, borderRadius: 3, fontSize: 10.5, padding: "3px 8px", cursor: d.counts?.new ? "pointer" : "default" }}>Mark read</button>
            </div>
            {items.length === 0 && <Muted style={{ marginTop: 6 }}>Nothing notable — a normal answer on most days.</Muted>}
            {form === "cards" && items.length > 0 && (
              <div role="list" style={{ display: "grid", gridTemplateColumns: `repeat(${size === "l" ? Math.min(3, items.length) : size === "m" ? 2 : 1}, minmax(0,1fr))`, gap: 8, marginTop: 8 }}>
                {items.map(i => (
                  <div role="listitem" key={i.fp} style={{ background: t.surfaceInset, borderRadius: 6, padding: 8, borderLeft: `3px solid ${i.direction === "down" ? t.negative : i.direction === "up" ? t.positive : t.border}` }}>
                    <div style={{ display: "flex", gap: 6, alignItems: "center", fontFamily: FONT.mono, fontSize: 9.5, color: t.textFaint }}>
                      <span title={`Materiality ${i.materiality}`} aria-label={`materiality ${i.materiality}`} style={{ width: 7 + i.materiality / 12, height: 7 + i.materiality / 12, borderRadius: "50%", background: soft(t.warning, 30 + i.materiality * 0.7) }} />
                      {i.kind.replace("_", " ")}{i.isNew && <span style={{ color: t.info }}> · NEW</span>}{i.weight != null ? ` · ${Number(i.weight).toFixed(1)}% of book` : ""}
                    </div>
                    <button onClick={() => i.symbol && page?.onOpenHolding?.(i.symbol)} style={{ display: "block", textAlign: "left", background: "transparent", border: "none", padding: 0, marginTop: 3, fontSize: 12, color: t.text, cursor: i.symbol ? "pointer" : "default" }}>{i.title}</button>
                    <div style={{ fontSize: 10.5, color: t.textMuted, marginTop: 2 }}>{i.detail}</div>
                    <div style={{ display: "flex", gap: 8, marginTop: 4 }}>
                      {i.url && <a href={i.url} target="_blank" rel="noopener noreferrer" style={{ fontSize: 10, color: t.info }}>source ↗</a>}
                      {i.alertId && <button onClick={() => snooze(i.alertId)} style={{ background: "transparent", border: "none", color: t.textFaint, fontSize: 10, cursor: "pointer", padding: 0 }}>snooze 7d</button>}
                    </div>
                  </div>
                ))}
              </div>
            )}
            {form === "pulse" && (
              <div style={{ marginTop: 8, display: "flex", gap: 6, flexWrap: "wrap" }}>
                {(d.sections ?? []).map(s => (
                  <span key={s.key} title={s.reason ?? s.coverage ?? ""} style={{ fontFamily: FONT.mono, fontSize: 10, padding: "3px 8px", borderRadius: 10, border: `1px solid ${t.border}`, color: s.count ? t.text : t.textFaint, background: s.newCount ? t.infoSoft : "transparent" }}>
                    {s.title}: {s.available ? s.count : "n/a"}{s.newCount ? ` (${s.newCount} new)` : ""}
                  </span>
                ))}
              </div>
            )}
            {form === "ranked" && items.length > 0 && (
              <div role="list" style={{ marginTop: 6 }}>
                {[...items].sort((a, b) => (b.weight ?? 0) - (a.weight ?? 0)).map(i => (
                  <div role="listitem" key={i.fp} style={{ display: "grid", gridTemplateColumns: "60px 1fr 60px", gap: 8, fontSize: 11.5, padding: "3px 0", borderBottom: `1px solid ${t.borderSubtle}` }}>
                    <span style={{ fontFamily: FONT.mono, color: t.textMuted }}>{i.weight != null ? `${Number(i.weight).toFixed(1)}%` : "—"}</span>
                    <span style={{ color: t.text }}>{i.title}{i.isNew ? <span style={{ color: t.info, fontSize: 9.5 }}> NEW</span> : ""}</span>
                    <span style={{ fontFamily: FONT.mono, textAlign: "right", color: t.textFaint }}>{i.materiality.toFixed(0)}</span>
                  </div>
                ))}
                <Muted size={10}>Sorted by share of the book each finding touches; the right column is materiality (not a confidence).</Muted>
              </div>
            )}
            {d.lastRead && <Muted size={10} style={{ marginTop: 6 }}>Last marked read {age(d.lastRead.readAt)}.</Muted>}
            <SrOnly>{textAlt}</SrOnly>
          </>
        )}
      </StateView>
    </Frame>
  );
}
</file>

<file path="src/overview/views/CalendarView.jsx">
// OV-03 "next 30 days". Forms: date wall, session timeline strip, list with
// importance dots, ruler +0d..+Nd, next-five-weeks dot timeline sized by money,
// "three events with a direct line to your holdings", a personal-notes lane,
// and earnings / dividends / macro filter chips. Macro is never invented: the
// chip exists so its absence is stated where people look for it.
import React, { useRef, useState } from "react";
import { useT, FONT, soft, cat } from "../../shared/theme.jsx";
import { Frame, StateView, ProvenanceFooter, Segmented, Muted, StaleBadge, Chip, SrOnly, Placeholder } from "../../shared/ui.jsx";
import { gbpCompact, date } from "../../shared/format.js";

const dotFor = (t, e) => e.category === "earnings" ? { c: t.text, g: "●" } : e.category === "dividends" ? { c: t.positive, g: "◆" } : { c: t.warning, g: "■" };

function EventLine({ e, page, compact }) {
  const t = useT();
  const d = dotFor(t, e);
  return (
    <button onClick={() => e.symbol ? page?.onOpenHolding?.(e.symbol) : null} title={`${e.title} · ${e.source}`}
      style={{ display: "grid", gridTemplateColumns: compact ? "14px 1fr auto" : "14px 1fr auto", gap: 6, alignItems: "baseline", width: "100%", background: "transparent", border: "none", padding: "3px 0", textAlign: "left", cursor: e.symbol ? "pointer" : "default", color: "inherit" }}>
      <span aria-hidden style={{ color: d.c, fontSize: 9 }}>{d.g}</span>
      <span style={{ fontSize: 11.5, color: t.text, minWidth: 0, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>
        {e.title}{e.symbol && e.stakePct != null && <span style={{ marginLeft: 6, fontFamily: FONT.mono, fontSize: 10, color: t.info }}>{e.symbol} {e.stakePct.toFixed(1)}%</span>}
        {e.relevance === "watched" && <span style={{ marginLeft: 6, fontSize: 9.5, color: t.textFaint }}>watched</span>}
      </span>
      <span style={{ fontFamily: FONT.mono, fontSize: 10, color: t.textFaint }}>{e.amount == null && e.amountReason ? "amount n/a" : ""}</span>
    </button>
  );
}

export function CalendarView({ status, data: d, reason, asOf, source, basis, coverage, stale, events = [], byDay = {}, byWeek = {}, direct = [], textAlt, days, setDays, filter, setFilter, size = "m", props = {}, page, refetch }) {
  const t = useT();
  const [form, setForm] = useState(props.notesLane ? "notes" : "list");
  const [focusDay, setFocusDay] = useState(0);
  const wallRef = useRef(null);
  const today = new Date();
  const iso = k => new Date(Date.UTC(today.getUTCFullYear(), today.getUTCMonth(), today.getUTCDate() + k)).toISOString().slice(0, 10);
  const maxStake = Math.max(1, ...events.map(e => e.stakeGBP ?? 0));
  const chips = [["all", "All"], ["earnings", "Earnings"], ["dividends", "Dividends"], ["macro", "Macro"]];
  const onWallKey = e => {
    const step = { ArrowRight: 1, ArrowLeft: -1, ArrowDown: 7, ArrowUp: -7 }[e.key];
    if (step == null) return;
    e.preventDefault();
    const next = Math.max(0, Math.min(days - 1, focusDay + step));
    setFocusDay(next);
    wallRef.current?.querySelector(`[data-day="${next}"]`)?.focus();
  };
  return (
    <Frame id="calendar" index={6} label={`Next ${days} days`} title="Dates worth keeping in view"
      right={<><StaleBadge stale={stale} asOf={asOf} /><Segmented label="Window" value={days} onChange={setDays} options={[7, 30, 60].map(v => ({ value: v, label: `${v}d` }))} /></>}
      footer={<ProvenanceFooter source={source} asOf={asOf} basis={basis} coverage={coverage} extra={d?.lastRefresh ? `dates refreshed ${date(d.lastRefresh.at)}` : "never refreshed"} />}>
      <div style={{ display: "flex", gap: 4, flexWrap: "wrap", marginBottom: 6, alignItems: "center" }} role="group" aria-label="Filter events">
        {chips.map(([k, l]) => <Chip key={k} active={filter === k} onClick={() => setFilter(k)}>{l}{d?.counts?.[k] != null ? ` ${d.counts[k]}` : ""}</Chip>)}
        <span style={{ flex: 1 }} />
        <Segmented label="Calendar form" value={form} onChange={setForm} options={[{ value: "list", label: "List" }, { value: "wall", label: "Wall" }, { value: "strip", label: "Strip" }, { value: "ruler", label: "Ruler" }, { value: "weeks", label: "Weeks" }, { value: "direct", label: "Top 3" }, { value: "notes", label: "Notes" }]} />
      </div>
      <div role="note" style={{ fontSize: 10.5, color: t.warning, marginBottom: 6 }}>{d?.macroNotice ?? "Macro releases aren't included. There is no free structured source."}</div>
      <StateView status={status} reason={reason} onRetry={refetch} height={200}>
        {d && filter === "macro" && <Muted>No macro events are shown because none are sourced — nothing here is invented.</Muted>}
        {d && filter !== "macro" && events.length === 0 && <Muted>No dated events for held or watched instruments in the next {days} days.</Muted>}
        {d && filter !== "macro" && events.length > 0 && (
          <>
            {form === "list" && (
              <div role="list">
                {Object.entries(byDay).map(([day, es]) => (
                  <div role="listitem" key={day} style={{ display: "grid", gridTemplateColumns: "44px 1fr", gap: 8, borderBottom: `1px solid ${t.borderSubtle}`, padding: "5px 0" }}>
                    <div><div style={{ fontFamily: FONT.serif, fontSize: 18, color: t.text, lineHeight: 1 }}>{Number(day.slice(8))}</div><div style={{ fontFamily: FONT.mono, fontSize: 9, color: t.textFaint }}>{date(day, { withYear: false, weekday: true }).split(" ").slice(0, 1)} · {es[0].daysAway}d</div></div>
                    <div>{es.map(e => <EventLine key={e.id} e={e} page={page} />)}</div>
                  </div>
                ))}
              </div>
            )}
            {form === "wall" && (
              <div ref={wallRef} role="grid" aria-label="Date wall" onKeyDown={onWallKey} style={{ display: "grid", gridTemplateColumns: "repeat(7, minmax(0,1fr))", gap: 3 }}>
                {Array.from({ length: days }, (_, k) => {
                  const day = iso(k), es = byDay[day] ?? [];
                  return (
                    <div key={k} role="gridcell" data-day={k} tabIndex={k === focusDay ? 0 : -1} onFocus={() => setFocusDay(k)} aria-label={`${date(day)}: ${es.length ? es.map(e => e.title).join(", ") : "nothing"}`}
                      style={{ minHeight: 44, borderRadius: 4, padding: 3, background: es.length ? soft(t.info, 14) : t.surfaceInset, border: `1px solid ${k === focusDay ? t.focusRing : "transparent"}`, fontSize: 9.5, overflow: "hidden" }}>
                      <div style={{ fontFamily: FONT.mono, color: t.textFaint }}>{day.slice(8)}</div>
                      {es.slice(0, 2).map(e => <div key={e.id} style={{ color: dotFor(t, e).c, whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis" }}>{dotFor(t, e).g} {e.symbol ?? "ISA"}</div>)}
                    </div>
                  );
                })}
              </div>
            )}
            {form === "strip" && (
              <div role="list" style={{ display: "flex", overflowX: "auto", gap: 4, paddingBottom: 4 }}>
                {events.map(e => (
                  <div role="listitem" key={e.id} style={{ minWidth: 110, background: t.surfaceInset, borderRadius: 5, padding: 6, borderTop: `3px solid ${dotFor(t, e).c}` }}>
                    <div style={{ fontFamily: FONT.mono, fontSize: 9.5, color: t.textFaint }}>{date(e.date, { withYear: false })} · +{e.daysAway}d</div>
                    <div style={{ fontSize: 11, color: t.text }}>{e.symbol ?? "Account"}</div>
                    <div style={{ fontSize: 10, color: t.textSecondary }}>{e.title.split(" — ")[1] ?? e.title}</div>
                  </div>
                ))}
              </div>
            )}
            {form === "ruler" && (
              <div role="img" aria-label={textAlt} style={{ position: "relative", height: 70, margin: "6px 4px" }}>
                <div style={{ position: "absolute", left: 0, right: 0, top: 34, height: 2, background: t.borderStrong }} />
                {[0, Math.round(days / 4), Math.round(days / 2), Math.round(days * 3 / 4), days].map(k => (
                  <div key={k} style={{ position: "absolute", left: `${k / days * 100}%`, top: 40, fontFamily: FONT.mono, fontSize: 9, color: t.textFaint, transform: "translateX(-50%)" }}>+{k}d</div>
                ))}
                {events.map((e, i) => (
                  <button key={e.id} onClick={() => e.symbol && page?.onOpenHolding?.(e.symbol)} title={`${e.title} · ${e.date}`}
                    style={{ position: "absolute", left: `${e.daysAway / days * 100}%`, top: i % 2 ? 8 : 20, transform: "translateX(-50%)", background: "transparent", border: "none", padding: 0, cursor: "pointer", fontSize: 9.5, fontFamily: FONT.mono, color: dotFor(t, e).c, whiteSpace: "nowrap" }}>
                    {dotFor(t, e).g} {e.symbol ?? "ISA"}
                  </button>
                ))}
              </div>
            )}
            {form === "weeks" && (
              <div role="list" aria-label="Next five weeks, dots sized by the money involved">
                {Array.from({ length: Math.min(5, Math.ceil(days / 7)) }, (_, w) => (
                  <div role="listitem" key={w} style={{ display: "grid", gridTemplateColumns: "70px 1fr", alignItems: "center", gap: 8, padding: "4px 0", borderBottom: `1px solid ${t.borderSubtle}` }}>
                    <span style={{ fontFamily: FONT.mono, fontSize: 10, color: t.textMuted }}>wk of {date(iso(w * 7), { withYear: false })}</span>
                    <span style={{ display: "flex", gap: 8, alignItems: "center", flexWrap: "wrap" }}>
                      {(byWeek[w] ?? []).map(e => {
                        const r = 5 + Math.sqrt((e.stakeGBP ?? 0) / maxStake) * 14;
                        return <span key={e.id} title={`${e.title} · ${e.stakeGBP != null ? gbpCompact(e.stakeGBP) : "no stake"}`} style={{ display: "inline-flex", alignItems: "center", gap: 3, fontSize: 9.5, fontFamily: FONT.mono, color: t.textSecondary }}>
                          <span style={{ width: r, height: r, borderRadius: "50%", background: soft(dotFor(t, e).c, 60), border: `1px solid ${dotFor(t, e).c}` }} />{e.symbol ?? "ISA"}
                        </span>;
                      })}
                      {!(byWeek[w] ?? []).length && <span style={{ fontSize: 10, color: t.textFaint }}>—</span>}
                    </span>
                  </div>
                ))}
              </div>
            )}
            {form === "direct" && (
              <div style={{ display: "grid", gridTemplateColumns: size === "s" ? "1fr" : "repeat(3, minmax(0,1fr))", gap: 8 }}>
                {direct.length ? direct.map(e => (
                  <button key={e.id} onClick={() => page?.onOpenHolding?.(e.symbol)} style={{ textAlign: "left", background: t.surfaceInset, border: `1px solid ${t.border}`, borderRadius: 6, padding: 8, cursor: "pointer", color: "inherit" }}>
                    <div style={{ fontFamily: FONT.mono, fontSize: 9.5, color: t.textFaint }}>{date(e.date)} · in {e.daysAway}d</div>
                    <div style={{ fontSize: 12, color: t.text, margin: "3px 0" }}>{e.title}</div>
                    <div style={{ fontFamily: FONT.mono, fontSize: 10.5, color: t.info }}>{e.stakePct.toFixed(1)}% of the book · {gbpCompact(e.stakeGBP)}</div>
                  </button>
                )) : <Muted>No event in the window touches a held position.</Muted>}
              </div>
            )}
            {form === "notes" && (
              <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 10 }}>
                <div>{events.slice(0, 8).map(e => <EventLine key={e.id} e={e} page={page} compact />)}</div>
                <Placeholder title="Your notes" reason="Notes are stored per instrument, not per date, so there is no dated notes lane yet. Open a holding to add a dated note to it." unblocks="a dated note store" height={100} />
              </div>
            )}
            {d.beyond?.length > 0 && <Muted size={10.5} style={{ marginTop: 6, fontStyle: "italic" }}>Just beyond the window: {d.beyond.map(e => `${e.title} on ${date(e.date, { withYear: false })}`).join(" · ")}.</Muted>}
          </>
        )}
        {d?.noDate?.length > 0 && (
          <div style={{ marginTop: 6, display: "flex", flexWrap: "wrap", gap: 4, alignItems: "center" }}>
            <Muted size={10}>No date published:</Muted>
            {d.noDate.map(n => <Chip key={n.symbol} title={n.reason} weight={n.stakePct != null ? `${n.stakePct.toFixed(1)}%` : null}>{n.symbol}</Chip>)}
          </div>
        )}
        <SrOnly>{textAlt}</SrOnly>
      </StateView>
    </Frame>
  );
}
</file>

<file path="src/overview/views/CompositionView.jsx">
// OV-02 composition. Forms: donut with lens switch, sunburst <-> treemap,
// stacked ribbon, weighted map (treemap), bars with target ticks, asset-class
// ribbon split by listing venue, and a target-status chip row. Unclassified
// is always a visible slice with its weight.
import React, { useState } from "react";
import { useT, FONT, cat } from "../../shared/theme.jsx";
import { Frame, StateView, ProvenanceFooter, Segmented, Muted, StaleBadge, Chip, SrOnly } from "../../shared/ui.jsx";
import { Donut, Sunburst, Treemap } from "../../shared/charts/shapes.jsx";
import { Ribbon, BarList } from "../../shared/charts/bars.jsx";
import { gbpCompact } from "../../shared/format.js";

const LENSES = [{ value: "class", label: "Class" }, { value: "sector", label: "Sector" }, { value: "region", label: "Region" }, { value: "wrapper", label: "Wrapper" }, { value: "account", label: "Account" }, { value: "currency", label: "Ccy" }];

export function CompositionView({ status, data: d, reason, asOf, source, basis, coverage, stale, targets, targetsReason, domicile, textAlt, lens, setLens, includeCash, setIncludeCash, size = "m", props = {}, page, refetch }) {
  const t = useT();
  const views = props.views ?? ["sunburst", "treemap"];
  const [form, setForm] = useState(views[0] ?? "sunburst");
  const groups = d?.groups ?? [];
  const colourFor = (g, i) => g.label === "Cash" ? t.textFaint : g.label === "Unclassified" || g.label === "Not disclosed" ? null : cat(t, i);
  const legend = (
    <div style={{ display: "grid", gridTemplateColumns: size === "s" ? "1fr" : "1fr 1fr", gap: "3px 12px", marginTop: 8 }}>
      {groups.map((g, i) => (
        <button key={g.label} onClick={() => page?.setSelected?.(page.selected === `grp:${g.label}` ? null : `grp:${g.label}`)} aria-pressed={page?.selected === `grp:${g.label}`}
          style={{ display: "flex", gap: 6, alignItems: "center", fontSize: 11, background: page?.selected === `grp:${g.label}` ? t.surfaceInset : "transparent", border: "none", padding: "1px 2px", cursor: "pointer", color: t.textSecondary, textAlign: "left" }}>
          <span style={{ width: 9, height: 9, borderRadius: 2, background: colourFor(g, i) ?? t.surfaceInset, border: colourFor(g, i) ? "none" : `1px dashed ${t.borderStrong}` }} />
          <span style={{ flex: 1, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>{g.label}</span>
          <span style={{ fontFamily: FONT.mono, color: t.text }}>{(g.weight * 100).toFixed(1)}%</span>
          <span style={{ fontFamily: FONT.mono, color: t.textFaint, fontSize: 9.5 }}>/ {g.count}</span>
        </button>
      ))}
    </div>
  );
  const byClassTarget = (targets?.byClass ?? []).filter(c => c.targetPct != null);
  const formOptions = [...new Set([...views, "donut", "ribbon", "bars", "domicile", "status"])];
  return (
    <Frame id="composition" index={4} label="Composition" title="Allocation at a glance"
      right={<><StaleBadge stale={stale} asOf={asOf} /><Segmented label="Composition form" value={form} onChange={setForm} options={formOptions.map(v => ({ value: v, label: { sunburst: "Sunburst", treemap: "Treemap", donut: "Donut", ribbon: "Ribbon", bars: "Targets", domicile: "Domicile", status: "Status" }[v] }))} /></>}
      footer={<ProvenanceFooter source={source} asOf={asOf} basis={basis} coverage={coverage} method="Weights sum to one at every level (tested). A holding with no label sits in an explicit Unclassified node; for the region lens, the part of a fund that is not disclosed is its own node and never assigned a region." />}>
      <div style={{ display: "flex", gap: 6, flexWrap: "wrap", marginBottom: 8, alignItems: "center" }}>
        <Segmented label="Lens" value={lens} onChange={setLens} options={LENSES} />
        <label style={{ fontSize: 10.5, color: t.textMuted, display: "flex", gap: 4, alignItems: "center" }}><input type="checkbox" checked={includeCash} onChange={e => setIncludeCash(e.target.checked)} /> include cash</label>
      </div>
      <StateView status={status} reason={reason} onRetry={refetch} height={220}>
        {d && (
          <>
            {form === "sunburst" && (
              <div style={{ display: "flex", justifyContent: "center" }}>
                <Sunburst tree={d.tree} size={size === "s" ? 200 : 240} centreLabel="Whole book" centreValue={gbpCompact(d.total)} summary={textAlt}
                  onSelect={n => n.symbol ? page?.onOpenHolding?.(n.symbol) : null} />
              </div>
            )}
            {form === "treemap" && (
              <Treemap height={size === "s" ? 200 : 240} summary={textAlt} colourMode="categorical" legendLabel="Group"
                items={d.tree.flatMap((c, ci) => (c.children ?? []).flatMap(g => g.leaf ? [{ key: g.id, label: g.label, sub: g.name, value: g.value, share: g.weight * 100, colourValue: ci, group: c.label }]
                  : (g.children ?? []).map(h => ({ key: h.id, label: h.label, sub: `${g.label} · ${h.name ?? ""}`, value: h.value, share: h.weight * 100, colourValue: ci, group: c.label }))))}
                grouped onSelect={r => r.label && r.label !== "Cash" && page?.onOpenHolding?.(r.label)} />
            )}
            {form === "donut" && (
              <div style={{ display: "flex", justifyContent: "center" }}>
                <Donut slices={groups.map((g, i) => ({ key: g.label, label: g.label, value: g.value, colour: colourFor(g, i) ?? t.surfaceInset }))} size={size === "s" ? 170 : 200}
                  centre={gbpCompact(d.total)} sub={d.lensLabel} summary={textAlt} selected={page?.selected?.startsWith("grp:") ? page.selected.slice(4) : null}
                  onSelect={k => page?.setSelected?.(k ? `grp:${k}` : null)} minShare={0.01} />
              </div>
            )}
            {form === "ribbon" && (
              <Ribbon summary={textAlt} segments={groups.map((g, i) => ({ key: g.label, label: g.label, value: g.weight, colour: colourFor(g, i) ?? undefined, hatched: !colourFor(g, i) }))}
                selected={page?.selected?.startsWith("grp:") ? page.selected.slice(4) : null} onSelect={k => page?.setSelected?.(k ? `grp:${k}` : null)} />
            )}
            {form === "bars" && (targets ? (
              <BarList summary="Weight by instrument type against the targets you set" format={v => `${v.toFixed(1)}%`}
                rows={targets.byClass.map((c, i) => ({ key: c.label, label: c.label, value: c.weight, target: c.targetPct, colour: cat(t, i) }))} />
            ) : <Muted>{targetsReason ?? "No targets set."} Bars show weight only until targets exist.</Muted>)}
            {form === "domicile" && (
              <div role="list" aria-label="Each instrument type split by where the holding itself is listed">
                {Object.entries(domicile).map(([cls, parts]) => {
                  const total = Object.values(parts).reduce((a, v) => a + v, 0);
                  return (
                    <div key={cls} role="listitem" style={{ marginBottom: 6 }}>
                      <div style={{ fontSize: 10.5, color: t.textSecondary, marginBottom: 2 }}>{cls} <span style={{ color: t.textFaint, fontFamily: FONT.mono }}>{gbpCompact(total)}</span></div>
                      <Ribbon labels={false} height={12} segments={Object.entries(parts).map(([v, x], i) => ({ key: v, label: v, value: x / total, colour: v === "Listing unknown" ? undefined : cat(t, i + 2), hatched: v === "Listing unknown" }))} />
                      <div style={{ fontSize: 9.5, color: t.textFaint, fontFamily: FONT.mono }}>{Object.entries(parts).map(([v, x]) => `${v} ${(x / total * 100).toFixed(0)}%`).join(" · ")}</div>
                    </div>
                  );
                })}
                <Muted size={10}>Where each holding itself is listed (its suffix) — a London-listed world tracker counts as UK here. For what the funds hold, use the Region lens.</Muted>
              </div>
            )}
            {form === "status" && (targets ? (
              <div style={{ display: "flex", flexWrap: "wrap", gap: 6 }}>
                {targets.rows.map(r => <Chip key={r.symbol} title={r.targetPct == null ? "No target set" : `${r.weight.toFixed(1)}% vs target ${r.targetPct}%`} onClick={() => page?.onOpenHolding?.(r.symbol)}>
                  {r.symbol} {r.status === "within 2pp" ? "✓" : r.status === "over" ? "▲" : r.status === "under" ? "▼" : "—"}
                </Chip>)}
                <Muted size={10}>✓ within 2pp of target · ▲ over · ▼ under · — no target set</Muted>
                {byClassTarget.length === 0 && null}
              </div>
            ) : <Muted>{targetsReason ?? "No targets set."}</Muted>)}
            {["sunburst", "donut", "treemap"].includes(form) && legend}
            {d.unclassifiedWeight > 0 && <Muted size={10.5} style={{ marginTop: 4 }}>{(d.unclassifiedWeight * 100).toFixed(1)}% has no {d.lensLabel.toLowerCase()} label and is shown as Unclassified.</Muted>}
            <SrOnly>{textAlt}</SrOnly>
          </>
        )}
      </StateView>
    </Frame>
  );
}
</file>

<file path="src/overview/views/DayContributionView.jsx">
// OV-11: what moved today. Forms: waterfall, session contribution bars, movers
// with linked reasons, day-range slider per holding, and the up/flat/down
// proportional ribbon. Market-closed and missing-price states are explicit.
import React, { useState } from "react";
import { useT, FONT, signColour } from "../../shared/theme.jsx";
import { Frame, StateView, ProvenanceFooter, Segmented, Muted, StaleBadge, Chip, SrOnly } from "../../shared/ui.jsx";
import { DivergingBars, Waterfall, RangeTrack } from "../../shared/charts/bars.jsx";
import { gbp, pct } from "../../shared/format.js";

export function UpDownRibbon({ counts, weights, byWeight = false, onPick }) {
  const t = useT();
  const total = byWeight ? (weights.up + weights.down + weights.flat) : (counts.up + counts.down + counts.flat);
  if (!total) return null;
  const segs = [["up", t.positive, "▲"], ["flat", t.textFaint, "▪"], ["down", t.negative, "▼"]];
  return (
    <div role="img" aria-label={`${counts.up} up, ${counts.flat} flat, ${counts.down} down${byWeight ? ` by weight ${weights.up.toFixed(1)}% up, ${weights.down.toFixed(1)}% down` : ""}`}>
      <div style={{ display: "flex", height: 10, borderRadius: 3, overflow: "hidden" }}>
        {segs.map(([k, c]) => {
          const v = byWeight ? weights[k] : counts[k];
          return v > 0 ? <button key={k} onClick={onPick ? () => onPick(k) : undefined} title={`${k}: ${byWeight ? `${v.toFixed(1)}% of the book` : v}`} style={{ width: `${v / total * 100}%`, background: c, border: "none", padding: 0, cursor: onPick ? "pointer" : "default" }} /> : null;
        })}
      </div>
      <div style={{ display: "flex", gap: 10, fontSize: 10.5, fontFamily: FONT.mono, marginTop: 3, color: t.textMuted }}>
        {segs.map(([k, c, g]) => <span key={k} style={{ color: c }}>{g} {byWeight ? `${weights[k].toFixed(1)}%` : counts[k]} {k}</span>)}
      </div>
    </div>
  );
}

export function DayContributionView({ status, data: d, reason, asOf, source, basis, coverage, stale, rows = [], counts, weights, textAlt, size = "m", page, refetch }) {
  const t = useT();
  const [form, setForm] = useState("bars");
  const top = rows.filter(r => r.gbp > 0).slice(0, 5);
  const bottom = rows.filter(r => r.gbp < 0).slice(-4);
  const middle = rows.filter(r => !top.includes(r) && !bottom.includes(r));
  const others = middle.reduce((a, r) => a + r.gbp, 0);
  const closed = d?.marketState && d.marketState !== "REGULAR";
  return (
    <Frame id="day-contribution" index={3} label="What moved today" title="Today's contribution"
      right={<><StaleBadge stale={stale} asOf={asOf} />{d && <span style={{ fontFamily: FONT.mono, fontSize: 11, color: signColour(t, d.net) }}>{gbp(d.net, { sign: true })} net</span>}</>}
      footer={<ProvenanceFooter source={source} asOf={asOf} basis={basis} coverage={coverage} method="Each holding: today's value × pct / (100 + pct) against its previous close. The bars sum to the headline day change; unpriced holdings are excluded and named." />}>
      <div style={{ display: "flex", gap: 6, marginBottom: 6, flexWrap: "wrap" }}>
        <Segmented label="Form" value={form} onChange={setForm} options={[{ value: "bars", label: "Bars" }, { value: "waterfall", label: "Waterfall" }, { value: "reasons", label: "Reasons" }, { value: "range", label: "Day range" }]} />
      </div>
      <StateView status={status} reason={reason} onRetry={refetch} height={200}>
        {d && (
          <>
            {closed && <div role="note" style={{ fontSize: 11, color: t.warning, marginBottom: 6 }}>Market state {d.marketState.toLowerCase()} — these are the last session's moves.</div>}
            {d.zeroDay && <Muted>No holding has moved today yet.</Muted>}
            {counts && <div style={{ marginBottom: 8 }}><UpDownRibbon counts={counts} weights={weights} /></div>}
            {form === "bars" && (
              <DivergingBars summary={textAlt} format={v => gbp(v, { sign: true })}
                rows={[...top.map(r => ({ key: r.symbol, label: r.symbol, sub: pct(r.pct), value: r.gbp })),
                  ...(middle.length ? [{ key: "__others", label: "Others", sub: `${middle.length} position${middle.length === 1 ? "" : "s"}`, value: +others.toFixed(2) }] : []),
                  ...bottom.map(r => ({ key: r.symbol, label: r.symbol, sub: pct(r.pct), value: r.gbp }))]}
                onRow={r => r.key !== "__others" && page?.onOpenHolding?.(r.key)} />
            )}
            {form === "waterfall" && (
              <Waterfall summary={textAlt} format={v => gbp(v)} height={size === "s" ? 170 : 210}
                steps={[{ label: "Yesterday", value: 0, kind: "total" }, ...rows.slice(0, 8).map(r => ({ label: r.symbol, value: r.gbp, kind: "step" })),
                  ...(rows.length > 8 ? [{ label: `Others (${rows.length - 8})`, value: +rows.slice(8).reduce((a, r) => a + r.gbp, 0).toFixed(2), kind: "step" }] : []),
                  { label: "Net", value: d.net, kind: "total" }]} onStep={s => page?.onOpenHolding?.(s.label)} />
            )}
            {form === "reasons" && (
              <div role="list">
                {rows.filter(r => r.gbp !== 0).slice(0, 8).map(r => (
                  <div key={r.symbol} role="listitem" style={{ padding: "4px 0", borderBottom: `1px solid ${t.borderSubtle}` }}>
                    <div style={{ display: "flex", justifyContent: "space-between", fontFamily: FONT.mono, fontSize: 11.5 }}>
                      <button onClick={() => page?.onOpenHolding?.(r.symbol)} style={{ background: "transparent", border: "none", padding: 0, cursor: "pointer", color: t.text, fontFamily: FONT.mono, fontWeight: 700 }}>{r.symbol}</button>
                      <span style={{ color: signColour(t, r.gbp) }}>{gbp(r.gbp, { sign: true })} · {pct(r.pct)}{r.z != null ? <span style={{ color: Math.abs(r.z) >= 1.5 ? t.warning : t.textFaint }}> · {Math.abs(r.z).toFixed(1)}σ</span> : ""}</span>
                    </div>
                    {r.story ? <a href={r.story.url} target="_blank" rel="noopener noreferrer" style={{ fontSize: 10.5, color: t.textMuted, textDecoration: "none" }}>↳ {r.story.title}</a> : null}
                  </div>
                ))}
                <Muted size={10}>A reason is shown only when a stored story names the holding; otherwise nothing is guessed.</Muted>
              </div>
            )}
            {form === "range" && (
              <div role="list">
                {rows.slice(0, 10).map(r => (
                  <div key={r.symbol} role="listitem" style={{ display: "grid", gridTemplateColumns: "70px 1fr 70px", gap: 8, alignItems: "center", padding: "3px 0" }}>
                    <span style={{ fontFamily: FONT.mono, fontSize: 11 }}>{r.symbol}</span>
                    {r.dayLow != null && r.dayHigh != null ? <RangeTrack low={r.dayLow} high={r.dayHigh} value={r.price} compact /> : <Muted size={10}>no intraday range in the quote</Muted>}
                    <span style={{ fontFamily: FONT.mono, fontSize: 11, textAlign: "right", color: signColour(t, r.pct) }}>{pct(r.pct)}</span>
                  </div>
                ))}
              </div>
            )}
            <div style={{ display: "flex", justifyContent: "space-between", borderTop: `1px solid ${t.borderStrong}`, marginTop: 6, paddingTop: 5, fontFamily: FONT.mono, fontSize: 11.5 }}>
              <span style={{ color: t.text }}>Net</span>
              <span style={{ color: signColour(t, d.net) }}>{gbp(d.net, { sign: true })}{d.reconciles ? "" : " (does not match the headline — report this)"}</span>
            </div>
            {d.excluded?.length > 0 && <div style={{ marginTop: 5, display: "flex", gap: 4, flexWrap: "wrap", alignItems: "center" }}><Muted size={10}>Not included:</Muted>{d.excluded.map(e => <Chip key={e.symbol} title={e.reason}>{e.symbol}</Chip>)}</div>}
            <SrOnly>{textAlt}</SrOnly>
          </>
        )}
      </StateView>
    </Frame>
  );
}
</file>

<file path="src/overview/views/HeadlineViews.jsx">
// OV-01 views: HeroTotal (hero figure, day move, 40-session spark bars,
// up/down count, benchmark day, peak, composed sentence, unpriced notice)
// and StatTiles (six tiles; a strip variant for value/invested/cash/P&L/day/
// return). Draw only what the hook hands over.

import React from "react";
import { useT, FONT, signColour } from "../../shared/theme.jsx";
import { Frame, StateView, ProvenanceFooter, Stat, Explain, ExplainBody, StaleBadge, Muted, NoData, BasisTag, SrOnly } from "../../shared/ui.jsx";
import { SparkBars, Sparkline } from "../../shared/charts/line.jsx";
import { gbp, gbpCompact, pct, pp, date, arrow, num } from "../../shared/format.js";

export function HeroTotalView({ status, data: d, reason, asOf, source, basis, coverage, stale, derived, size = "m", page, refetch }) {
  const t = useT();
  const big = size === "l" ? 58 : size === "s" ? 34 : 48;
  return (
    <Frame id="hero-total" label={d ? `Total value · ${d.positions} position${d.positions === 1 ? "" : "s"} · GBP` : "Total value"} right={<StaleBadge stale={stale} asOf={asOf} />}
      footer={<ProvenanceFooter source={source} asOf={asOf} basis={basis} coverage={coverage} method="Sum of each holding's quantity x live price, converted to GBP at live FX, plus recorded cash. Day change = value x pct / (100 + pct) against the previous close." />}>
      <StateView status={status} reason={reason} onRetry={refetch} height={170}>
        {d && (
          <div>
            <div style={{ display: "flex", alignItems: "baseline", gap: 10, flexWrap: "wrap" }}>
              <span style={{ fontFamily: FONT.serif, fontSize: big, color: t.text, letterSpacing: -1, lineHeight: 1.05 }} aria-label={`Total value ${gbp(d.total)}`}>
                {gbp(d.total)}
              </span>
            </div>
            <div style={{ display: "flex", alignItems: "center", gap: 12, flexWrap: "wrap", marginTop: 6 }}>
              <button onClick={() => page?.onNavigate?.("changed")} title="What moved today — opens What Changed"
                style={{ background: "transparent", border: "none", padding: 0, cursor: "pointer", fontFamily: FONT.mono, fontSize: 14, color: signColour(t, d.dayChange) }}>
                {arrow(d.dayChange)} {gbp(d.dayChange, { sign: true, dp: 0 })} · {pct(d.dayChangePct)} today
              </button>
              {size !== "s" && derived?.sparkValues?.length > 2 && (
                <span style={{ display: "inline-flex", alignItems: "center", gap: 6 }}>
                  <SparkBars values={derived.sparkValues} width={size === "l" ? 200 : 150} height={24} />
                  <span style={{ fontSize: 9.5, color: t.textFaint, fontFamily: FONT.mono }}>{derived.sparkValues.length - 1} sessions</span>
                </span>
              )}
              {size === "s" && derived?.sparkValues?.length > 2 && <Sparkline values={derived.sparkValues} width={90} height={20} />}
            </div>
            <div style={{ display: "flex", gap: 10, flexWrap: "wrap", marginTop: 8, fontSize: 11, color: t.textMuted, fontFamily: FONT.mono }}>
              <span aria-label={`${d.up} up, ${d.down} down, ${d.flat} flat`}>
                <span style={{ color: t.positive }}>▲{d.up}</span> up · <span style={{ color: t.negative }}>▼{d.down}</span> down · {d.flat} flat{d.unknown ? ` · ${d.unknown} no quote` : ""}
              </span>
              <span>· {d.benchmarkDay?.pct != null ? <>FTSE 100 <span style={{ color: signColour(t, d.benchmarkDay.pct) }}>{pct(d.benchmarkDay.pct)}</span> today</> : <span title={d.benchmarkDay?.reason}>benchmark day move <NoData reason={d.benchmarkDay?.reason ?? "No quote"} /></span>}</span>
              {d.peak && <span title={`Peak of the reconstructed series (${d.peak.basis})`}>peak {gbpCompact(d.peak.value)} on {date(d.peak.date)} · {d.peak.distancePct === 0 ? "at peak" : `${pct(d.peak.distancePct, { dp: 1 })} from it`}</span>}
            </div>
            {size !== "s" && d.sentence && <div style={{ marginTop: 10, fontFamily: FONT.serif, fontSize: 15, color: t.textSecondary }}>{d.sentence}</div>}
            {d.partial && (
              <div role="note" style={{ marginTop: 10, fontSize: 11.5, color: t.warning, lineHeight: 1.5 }}>
                ⚠ Excludes {d.excluded.map(e => e.symbol).join(", ")} — {d.excluded[0]?.reason} The total above is for priced holdings and cash only.
              </div>
            )}
            <SrOnly>{derived?.textAlt}</SrOnly>
          </div>
        )}
      </StateView>
    </Frame>
  );
}

const TILE_LABELS = { totalReturn: "Total return", netGain: "Net gain", ytd: "Year to date", income: "Income · 12m", cash: "Cash", risk: "Risk",
  value: "Market value", invested: "Invested", unrealised: "Unrealised P&L", day: "Day move", return: "Return", deposits: "Net deposits" };

function tile(key, d, hero, t, page) {
  const nav = tab => () => page?.onNavigate?.(tab);
  switch (key) {
    case "totalReturn": {
      const x = d.totalReturn;
      return { value: x.available ? pct(x.pct, { dp: 1 }) : null, sign: x.available ? x.pct : null, reason: x.reason,
        sub: x.available ? <>since {date(x.from)} · {pct(x.annualisedPct, { dp: 1 })} a year <BasisTag basis="Reconstructed" /></> : x.reason,
        onClick: nav("performance"),
        explain: "Fixed-weight reconstruction: today's holdings replayed over stored closes since the first date every holding has. Not a money-weighted return — that needs the cash-flow ledger (Performance tab)." };
    }
    case "netGain": {
      const x = d.netGain;
      const onDep = x.deposited != null;
      return { value: onDep ? gbpCompact(x.gainOnDeposited, { sign: true }) : gbpCompact(x.pnl, { sign: true }), sign: onDep ? x.gainOnDeposited : x.pnl,
        sub: onDep ? `on ${gbpCompact(x.deposited)} paid in (ledger)` : `on ${gbpCompact(x.cost)} cost · ${pct(x.pnlPct, { dp: 1 })}`,
        explain: onDep ? "Current total minus net deposits recorded in the cash-flow ledger." : `Unrealised gain against average cost. ${x.depositedReason}` };
    }
    case "ytd": {
      const x = d.ytd;
      return { value: x.available ? pct(x.pct, { dp: 1 }) : null, sign: x.available ? x.pct : null, reason: x.reason,
        sub: x.available ? <>FTSE 100 {pct(x.benchmarkPct, { dp: 1 })} · <span style={{ color: signColour(t, x.excessPp) }}>{pp(x.excessPp)}</span></> : x.reason,
        onClick: nav("performance"), explain: "From the last close of last year to the latest close, reconstructed; benchmark over the same dates." };
    }
    case "income":
      return { value: null, reason: d.income.reason, sub: d.income.reason, explain: "No income ledger exists yet, so no figure is shown rather than an estimate." };
    case "cash": {
      const x = d.cash;
      return { value: gbpCompact(x.gbp), sub: <>{pct(x.pct, { dp: 1, sign: false })} of book{x.bufferPct != null ? ` · buffer ${x.bufferPct}% (${x.bufferSource})` : ""}</>, onClick: nav("allocate"),
        explain: "Recorded cash balances converted to GBP. Click to deploy it on the Allocate tab." };
    }
    case "risk": {
      const x = d.risk;
      return { value: x.available ? (x.beta != null ? `β ${num(x.beta, { dp: 2 })}` : `vol ${pct(x.volPct, { dp: 1, sign: false })}`) : null, reason: x.reason,
        sub: x.available ? `vol ${pct(x.volPct, { dp: 1, sign: false })}${x.benchmarkVolPct != null ? ` · ${x.benchmark?.label} ${pct(x.benchmarkVolPct, { dp: 1, sign: false })}` : ""} · 1y` : x.reason,
        onClick: nav("analysis"), explain: `Beta and volatility of the reconstructed book over one year, joined on date with ${x.benchmark?.label ?? "the benchmark"}. ${x.betaReason ?? ""}` };
    }
    case "value": return { value: hero ? gbpCompact(hero.total) : null, sub: "holdings + cash", explain: "Live valuation." };
    case "invested": return { value: hero ? gbpCompact(hero.invested) : null, sub: hero ? `cost ${gbpCompact(hero.cost)}` : null, explain: "Priced holdings at live prices." };
    case "unrealised": return { value: hero ? gbpCompact(hero.pnl, { sign: true }) : null, sign: hero?.pnl, sub: hero ? pct(hero.pnlPct, { dp: 1 }) : null, explain: "Value minus average cost for priced holdings." };
    case "day": return { value: hero ? gbpCompact(hero.dayChange, { sign: true }) : null, sign: hero?.dayChange, sub: hero ? pct(hero.dayChangePct) : null, onClick: () => page?.onNavigate?.("changed"), explain: "Against the previous close." };
    case "return": return tile("totalReturn", d, hero, t, page);
    default: return { value: null, reason: "Unknown tile" };
  }
}

export function StatTilesView({ status, data: d, hero, reason, asOf, source, basis, coverage, stale, size = "m", props = {}, page, refetch }) {
  const t = useT();
  const keys = props.tiles ?? ["totalReturn", "netGain", "ytd", "income", "cash", "risk"];
  const cols = props.variant === "strip" || size === "l" ? keys.length : size === "s" ? 2 : 3;
  return (
    <Frame id="stat-tiles" right={<StaleBadge stale={stale} asOf={asOf} />}
      footer={<ProvenanceFooter source={source} asOf={asOf} basis={basis} coverage={coverage} />}>
      <StateView status={status} reason={reason} onRetry={refetch} height={150}>
        {d && (
          <div role="list" style={{ display: "grid", gridTemplateColumns: `repeat(${cols}, minmax(0, 1fr))`, gap: 2 }}>
            {keys.map(k => {
              const x = tile(k, d, hero, t, page);
              return (
                <div role="listitem" key={k} style={{ borderLeft: `1px solid ${t.borderSubtle}`, minWidth: 0 }}>
                  <Stat label={TILE_LABELS[k]} value={x.value} sub={x.sub} sign={x.sign} reason={x.reason} onClick={x.onClick} size={size === "l" ? "m" : "s"}
                    explain={<Explain title={TILE_LABELS[k]}><div style={{ marginBottom: 6 }}>{x.explain}</div><ExplainBody source={source} asOf={asOf} /></Explain>} />
                </div>
              );
            })}
          </div>
        )}
      </StateView>
    </Frame>
  );
}
</file>

<file path="src/overview/views/HealthAxesView.jsx">
// OV-06: five axes, never a grade. Forms: rings, report card, lifts/holds-back
// attribution, and a dual risk + health cluster.
import React, { useState } from "react";
import { useT, FONT, cat } from "../../shared/theme.jsx";
import { Frame, StateView, ProvenanceFooter, Segmented, Explain, Muted, StaleBadge, SrOnly } from "../../shared/ui.jsx";
import { Ring } from "../../shared/charts/bars.jsx";
import { pct, num } from "../../shared/format.js";

function AxisDetail({ axis, page }) {
  const t = useT();
  if (!axis) return null;
  return (
    <div style={{ marginTop: 10 }}>
      <div style={{ fontSize: 11.5, color: t.textSecondary, lineHeight: 1.5 }}>{axis.description}</div>
      <Muted size={10.5} style={{ marginTop: 4 }}>Covers {axis.coverage}% of invested value{axis.note ? ` · ${axis.note}` : ""}</Muted>
      {axis.score != null && (
        <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 12, marginTop: 8 }}>
          {[["Lifting it", axis.lifting, t.positive], ["Holding it back", axis.holdingBack, t.negative]].map(([h, list, c]) => (
            <div key={h}>
              <div style={{ fontFamily: FONT.mono, fontSize: 9.5, letterSpacing: 1, color: c, marginBottom: 4 }}>{h.toUpperCase()}</div>
              {list.length ? list.slice(0, 4).map(x => (
                <button key={x.symbol} onClick={() => page?.onOpenHolding?.(x.symbol)}
                  style={{ display: "flex", justifyContent: "space-between", width: "100%", background: "transparent", border: "none", padding: "2px 0", cursor: "pointer", fontFamily: FONT.mono, fontSize: 11, color: t.text }}>
                  <span>{x.symbol}</span><span style={{ color: c }}>{x.pull >= 0 ? "+" : "−"}{Math.abs(x.pull).toFixed(1)} pts</span>
                </button>
              )) : <Muted size={10.5}>{h === "Lifting it" ? "Nothing above the book's average." : "Nothing below the book's average."}</Muted>}
            </div>
          ))}
        </div>
      )}
      {axis.missing?.length > 0 && <Muted size={10} style={{ marginTop: 6 }}>No reading: {axis.missing.map(m => `${m.symbol} (${m.reason})`).join("; ")}. Not scored as neutral.</Muted>}
    </div>
  );
}

export function HealthAxesView({ status, reason, asOf, source, basis, coverage, stale, axes = [], mandate, risk, riskReason, textAlt, size = "m", props = {}, page, refetch }) {
  const t = useT();
  const [form, setForm] = useState("rings");
  const [sel, setSel] = useState(null);
  const selected = axes.find(a => a.key === sel) ?? null;
  return (
    <Frame id="health-axes" label="Portfolio health" title="Five axes, no grade"
      right={<><StaleBadge stale={stale} asOf={asOf} /><Segmented label="Health form" value={form} onChange={setForm} options={[{ value: "rings", label: "Rings" }, { value: "card", label: "Card" }, { value: "lifts", label: "Lifts" }, { value: "cluster", label: "+Risk" }]} /></>}
      footer={<ProvenanceFooter source={source} asOf={asOf} basis={basis} coverage={coverage} method="Each axis is the value-weighted average of that component across holdings that produced a reading (0-100). Deliberately no overall grade: combining the axes would need weights nothing here can justify." />}>
      <StateView status={status} reason={reason} onRetry={refetch} height={200}>
        {axes.length > 0 && (
          <>
            {form === "rings" && (
              <div role="list" style={{ display: "flex", flexWrap: "wrap", gap: 10, justifyContent: "space-between" }}>
                {axes.map((a, i) => (
                  <button key={a.key} role="listitem" onClick={() => setSel(s => s === a.key ? null : a.key)} aria-pressed={sel === a.key} title={a.description}
                    style={{ background: sel === a.key ? t.surfaceInset : "transparent", border: "none", borderRadius: 6, padding: 4, cursor: "pointer" }}>
                    <Ring value={a.score} label={a.label} sub={`${a.coverage}% covered`} colour={cat(t, i)} size={size === "s" ? 52 : 62} />
                  </button>
                ))}
              </div>
            )}
            {form === "card" && (
              <div role="table" aria-label="Report card">
                {axes.map(a => (
                  <div role="row" key={a.key} onClick={() => setSel(s => s === a.key ? null : a.key)}
                    style={{ display: "grid", gridTemplateColumns: "90px 1fr 38px 70px", gap: 8, alignItems: "center", padding: "5px 0", borderBottom: `1px solid ${t.borderSubtle}`, cursor: "pointer" }}>
                    <span role="cell" style={{ fontSize: 11.5, color: t.text }}>{a.label}</span>
                    <span role="cell" style={{ position: "relative", height: 6, background: t.surfaceInset, borderRadius: 3 }}>
                      {a.score != null && <span style={{ position: "absolute", inset: 0, width: `${a.score}%`, background: t.info, borderRadius: 3 }} />}
                    </span>
                    <span role="cell" style={{ fontFamily: FONT.mono, fontSize: 11.5, textAlign: "right", color: a.score == null ? t.textFaint : t.text }}>{a.score ?? "——"}</span>
                    <span role="cell" style={{ fontFamily: FONT.mono, fontSize: 10, color: t.textFaint, textAlign: "right" }}>{a.coverage}% cov.</span>
                  </div>
                ))}
              </div>
            )}
            {form === "lifts" && (
              <div>
                {axes.map(a => (
                  <div key={a.key} style={{ padding: "5px 0", borderBottom: `1px solid ${t.borderSubtle}` }}>
                    <div style={{ display: "flex", justifyContent: "space-between", fontSize: 11.5 }}>
                      <span style={{ color: t.text }}>{a.label} <span style={{ color: t.textFaint, fontFamily: FONT.mono }}>{a.score ?? "——"}</span></span>
                      <span style={{ fontFamily: FONT.mono, fontSize: 10.5 }}>
                        {a.lifting[0] && <span style={{ color: t.positive }}>↑ {a.lifting[0].symbol} </span>}
                        {a.holdingBack[0] && <span style={{ color: t.negative }}>↓ {a.holdingBack[0].symbol}</span>}
                        {!a.lifting[0] && !a.holdingBack[0] && <span style={{ color: t.textFaint }}>not measured</span>}
                      </span>
                    </div>
                  </div>
                ))}
                <Muted size={10.5} style={{ marginTop: 6 }}>"Lifting" and "holding back" are each holding's pull on the weighted average (size × distance from the mean); the pulls on an axis sum to zero.</Muted>
              </div>
            )}
            {form === "cluster" && (
              <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 10 }}>
                <div>
                  <div style={{ fontFamily: FONT.mono, fontSize: 9.5, letterSpacing: 1, color: t.textMuted, marginBottom: 4 }}>RISK · 1Y</div>
                  {risk ? [["Volatility", pct(risk.volPct, { dp: 1, sign: false })], ["Beta", num(risk.beta, { dp: 2 })], ["Max drawdown", pct(risk.maxDrawdownPct, { dp: 1 })], ["Sharpe", num(risk.sharpe, { dp: 2 })]].map(([k, v]) => (
                    <div key={k} style={{ display: "flex", justifyContent: "space-between", fontSize: 11, padding: "2px 0" }}><span style={{ color: t.textSecondary }}>{k}</span><span style={{ fontFamily: FONT.mono, color: t.text }}>{v}</span></div>
                  )) : <Muted>{riskReason ?? "Risk figures unavailable."}</Muted>}
                </div>
                <div>
                  <div style={{ fontFamily: FONT.mono, fontSize: 9.5, letterSpacing: 1, color: t.textMuted, marginBottom: 4 }}>HEALTH AXES</div>
                  {axes.map(a => <div key={a.key} style={{ display: "flex", justifyContent: "space-between", fontSize: 11, padding: "2px 0" }}><span style={{ color: t.textSecondary }}>{a.label}</span><span style={{ fontFamily: FONT.mono, color: a.score == null ? t.textFaint : t.text }}>{a.score ?? "——"}</span></div>)}
                </div>
              </div>
            )}
            {props.expanded ? (
              <div style={{ display: "grid", gridTemplateColumns: size === "l" ? "1fr 1fr" : "1fr", columnGap: 18 }}>
                {axes.map(a => <div key={a.key} style={{ borderTop: `1px solid ${t.borderSubtle}`, marginTop: 8 }}><div style={{ fontSize: 12, color: t.text, marginTop: 6 }}>{a.label} <span style={{ fontFamily: FONT.mono, color: t.textFaint }}>{a.score ?? "——"}</span></div><AxisDetail axis={a} page={page} /></div>)}
              </div>
            ) : <AxisDetail axis={selected} page={page} />}
            {!selected && !props.expanded && <Muted size={10.5} style={{ marginTop: 8 }}>Select an axis to see which holdings lift it and hold it back.</Muted>}
            <div style={{ display: "flex", gap: 10, marginTop: 10, flexWrap: "wrap", alignItems: "center" }}>
              <button onClick={() => page?.onNavigate?.("analysis")} style={{ background: "transparent", border: "none", color: t.info, cursor: "pointer", fontSize: 11, padding: 0 }}>Open the scorecard and rebalance plan →</button>
              <button onClick={() => page?.onNavigate?.("allocate")} style={{ background: "transparent", border: "none", color: t.info, cursor: "pointer", fontSize: 11, padding: 0 }}>Allocate new cash →</button>
              {mandate && <Muted size={10}>Weighted for {mandate.riskLabel} · {mandate.horizonLabel}</Muted>}
              <Explain title="Why there is no overall grade"><div>The five axes measure different things — delivery, trend, short-term technicals, precedent and cost. A single score would need weights between them that nothing here can defend, so none is shown (decision D-03).</div></Explain>
            </div>
            <SrOnly>{textAlt}</SrOnly>
          </>
        )}
      </StateView>
    </Frame>
  );
}
</file>

