                <div style={{ minWidth: 0 }}>
                  <div style={{ fontSize: 11.5, color: t.textSecondary }}>{p.name ?? p.symbol}</div>
                  <div style={{ fontSize: 10, color: t.textFaint, marginTop: 2 }}>{p.note}</div>
