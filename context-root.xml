              padding: "6px 14px", borderRadius: 3, fontSize: 11, fontFamily: "monospace",
              cursor: scoring ? "default" : "pointer",
            }}>{scoring ? "SCORING…" : `SCORE ${Math.min(aiStatus.pending, 60)} NOW`}</button>
