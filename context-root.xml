                    <span style={{ color: "#3a4558", fontSize: 10 }}>{open ? "▾" : "▸"}</span>
                    <span style={{ fontFamily: "monospace", fontSize: 12, color: "#c8d6e8", fontWeight: 700 }}>
                      {r.symbol}
                    </span>
                    <span style={{ fontFamily: "monospace", fontSize: 12, color: "#7a8ba0", textAlign: "right" }}>
