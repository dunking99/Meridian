              <span style={{ fontSize: 10, color: "#4a6080" }}>est {e.epsEstimate != null ? e.epsEstimate.toFixed(2) : "—"}</span>
              <span style={{ fontSize: 10.5, color: "#c8d6e8" }}>{e.epsActual != null ? e.epsActual.toFixed(2) : "—"}</span>
