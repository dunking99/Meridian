  const fx = s.includes('=X');
  store(s, makeBars(s, 1000 + idx * 7919, { start, beta: fx ? 0.05 : 0.6 + (idx % 5) * 0.15, idio: fx ? 0.003 : 0.006, drift: fx ? 0 : 0.00022 }));
});

