check('52-week low is below the high', detail.range52.low < detail.range52.high);
check('most-correlated partner is TWIN.L',
  detail.correlatedWith[0]?.symbol === 'TWIN.L',
  `got ${detail.correlatedWith[0]?.symbol}`);

